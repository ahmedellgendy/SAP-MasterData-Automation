@model List<MasterDataAutomation.Infrastructure.Data.Entities.System.ActivityLogEntity>

@{
    ViewData["Title"] = "Activity Logs";

    var totalLogs = Model?.Count ?? 0;
    var deleteCount = Model?.Count(x => x.Action == "Delete") ?? 0;
    var approveCount = Model?.Count(x => x.Action == "Approve") ?? 0;
    var rejectCount = Model?.Count(x => x.Action == "Reject") ?? 0;

    var modules = ViewBag.Modules as List<string> ?? new List<string>();
    var actions = ViewBag.Actions as List<string> ?? new List<string>();
}

<style>
    .log-stat-card {
        border: none;
        border-radius: 0.9rem;
        transition: .2s;
    }

        .log-stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,.08) !important;
        }

    .log-icon {
        width: 48px;
        height: 48px;
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
    }

    .log-table th {
        font-size: 0.78rem;
        text-transform: uppercase;
        color: #6c757d;
        background: #f8f9fb;
        white-space: nowrap;
    }

    .log-table td {
        vertical-align: middle;
    }

    .action-badge {
        font-size: 0.75rem;
        padding: 0.35rem 0.65rem;
        border-radius: 999px;
    }
</style>

<div class="container-fluid mt-4 mb-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="fw-bold mb-1" style="color:#2c3e50;">
                <i class="bi bi-activity"></i>
                Activity Logs
            </h1>

            <p class="text-muted mb-0">
                Track important user actions across the system.
            </p>
        </div>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card log-stat-card shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="log-icon bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-list-ul"></i>
                    </div>

                    <div>
                        <small class="text-muted d-block">Shown Logs</small>
                        <h3 class="fw-bold mb-0">@totalLogs</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card log-stat-card shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="log-icon bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-trash"></i>
                    </div>

                    <div>
                        <small class="text-muted d-block">Delete Actions</small>
                        <h3 class="fw-bold mb-0">@deleteCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card log-stat-card shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="log-icon bg-success bg-opacity-10 text-success">
                        <i class="bi bi-check-circle"></i>
                    </div>

                    <div>
                        <small class="text-muted d-block">Approve Actions</small>
                        <h3 class="fw-bold mb-0">@approveCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card log-stat-card shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="log-icon bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-x-circle"></i>
                    </div>

                    <div>
                        <small class="text-muted d-block">Reject Actions</small>
                        <h3 class="fw-bold mb-0">@rejectCount</h3>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm border-0 mb-4" style="border-radius:0.9rem;">
        <div class="card-body">
            <form asp-controller="ActivityLogs"
                  asp-action="Index"
                  method="get"
                  class="row g-2 align-items-end">

                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-search"></i>
                        Search
                    </label>

                    <input type="text"
                           name="searchTerm"
                           value="@ViewBag.SearchTerm"
                           class="form-control"
                           placeholder="Search user, action, module, description..." />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Module</label>

                    <select name="module" class="form-select">
                        <option value="">All Modules</option>

                        @foreach (var item in modules)
                        {
                            <option value="@item" selected="@(ViewBag.SelectedModule == item)">
                                @item
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Action</label>

                    <select name="action" class="form-select">
                        <option value="">All Actions</option>

                        @foreach (var item in actions)
                        {
                            <option value="@item" selected="@(ViewBag.SelectedAction == item)">
                                @item
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="bi bi-funnel"></i>
                        Filter
                    </button>

                    <a asp-controller="ActivityLogs"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i>
                    </a>
                </div>

            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0" style="border-radius:0.9rem; overflow:hidden;">

        <div class="card-header bg-light fw-bold py-3 d-flex justify-content-between align-items-center">
            <span>
                <i class="bi bi-table"></i>
                Logs
            </span>

            <span class="text-muted small">
                Last 300 records
            </span>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 log-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>User</th>
                            <th>Role</th>
                            <th>Action</th>
                            <th>Module</th>
                            <th>Entity</th>
                            <th>Record Id</th>
                            <th>Description</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="text-muted small">
                                    @log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")
                                </td>

                                <td class="fw-semibold">
                                    @(log.UserName ?? "-")
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @(log.UserRole ?? "-")
                                    </span>
                                </td>

                                <td>
                                    @if (log.Action == "Delete")
                                    {
                                        <span class="action-badge bg-danger bg-opacity-10 text-danger">
                                            <i class="bi bi-trash"></i>
                                            @log.Action
                                        </span>
                                    }
                                    else if (log.Action == "Approve")
                                    {
                                        <span class="action-badge bg-success bg-opacity-10 text-success">
                                            <i class="bi bi-check-circle"></i>
                                            @log.Action
                                        </span>
                                    }
                                    else if (log.Action == "Reject")
                                    {
                                        <span class="action-badge bg-warning bg-opacity-10 text-warning">
                                            <i class="bi bi-x-circle"></i>
                                            @log.Action
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="action-badge bg-primary bg-opacity-10 text-primary">
                                            <i class="bi bi-activity"></i>
                                            @log.Action
                                        </span>
                                    }
                                </td>

                                <td>@log.Module</td>

                                <td>@log.EntityName</td>

                                <td>
                                    @(log.EntityId?.ToString() ?? "-")
                                </td>

                                <td class="text-muted">
                                    @(log.Description ?? "-")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                <h5>No activity logs found</h5>
                <p class="mb-0">User actions will appear here after logging starts.</p>
            </div>
        }

    </div>

</div>