@model List<MasterDataAutomation.Application.Modules.CustomerModification.Dtos.CustomerModificationRequestDto>
@using MasterDataAutomation.Application.Modules.CustomerModification.Enums

@{
    ViewData["Title"] = "مراجعة طلبات تعديل العملاء";

    var requests = Model ?? new List<MasterDataAutomation.Application.Modules.CustomerModification.Dtos.CustomerModificationRequestDto>();
}

@functions {
    string CustomerTypeText(CustomerModificationCustomerType type)
    {
        return type switch
        {
            CustomerModificationCustomerType.Private => "خاص",
            CustomerModificationCustomerType.Fridge => "ثلاجة",
            _ => "-"
        };
    }

    string ModificationTypeText(CustomerModificationType type)
    {
        return type switch
        {
            CustomerModificationType.RemoveFridge => "رفع الثلاجة",
            CustomerModificationType.ChangeName => "تعديل اسم",
            CustomerModificationType.ChangeToPrivate => "تحويل إلى خاص",
            CustomerModificationType.ChangeToFridge => "تحويل إلى ثلاجة",
            _ => "-"
        };
    }
}

<style>
    .manager-review-page {
        direction: rtl;
        text-align: right;
        font-family: "Segoe UI", Tahoma, Arial, sans-serif;
        color: #16232c;
    }

    .review-header {
        background: linear-gradient(135deg, #16232c, #2f7d6b);
        color: #fff;
        border-radius: 20px;
        padding: 28px;
        margin-bottom: 24px;
    }

    .review-title {
        font-size: 30px;
        font-weight: 900;
        margin: 0;
    }

    .review-subtitle {
        margin: 8px 0 0;
        opacity: .9;
        font-size: 14px;
    }

    .review-alert {
        border-radius: 12px;
        padding: 12px 14px;
        margin-bottom: 16px;
        font-weight: 800;
    }

    .review-alert-success {
        background: #e7f3f0;
        color: #1d5347;
        border: 1px solid #cfe6de;
    }

    .review-alert-error {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    .review-panel {
        background: #fff;
        border: 1px solid #e5e9ef;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .06);
    }

    .review-panel-head {
        padding: 18px 20px;
        background: #f8fafc;
        border-bottom: 1px solid #e5e9ef;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        font-weight: 900;
    }

    .review-count {
        background: #e7f3f0;
        color: #1d5347;
        border-radius: 999px;
        padding: 6px 14px;
        font-size: 13px;
        font-weight: 900;
    }

    .review-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

        .review-table th {
            background: #f4f7f8;
            color: #64748b;
            padding: 12px 14px;
            font-size: 12px;
            border-bottom: 1px solid #e5e9ef;
            white-space: nowrap;
            text-align: right;
        }

        .review-table td {
            padding: 14px;
            border-bottom: 1px solid #e5e9ef;
            vertical-align: middle;
            font-size: 14px;
        }

    .customer-code {
        font-family: Consolas, monospace;
        font-weight: 900;
        background: #ecfdf5;
        color: #0f766e;
        padding: 5px 8px;
        border-radius: 8px;
        display: inline-block;
    }

    .customer-name {
        font-weight: 900;
    }

    .chip {
        border-radius: 999px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 900;
        background: #f1f5f9;
        color: #475569;
        display: inline-block;
        white-space: nowrap;
    }

    .new-name {
        color: #2563eb;
        font-weight: 900;
    }

    .action-buttons {
        display: flex;
        gap: 8px;
        justify-content: flex-start;
        flex-wrap: wrap;
    }

    .approve-btn {
        border: 1px solid #2f7d6b;
        background: #2f7d6b;
        color: #fff;
        border-radius: 8px;
        padding: 7px 12px;
        font-size: 13px;
        font-weight: 900;
    }

        .approve-btn:hover {
            background: #245f52;
            border-color: #245f52;
            color: #fff;
        }

    .reject-btn {
        border: 1px solid #dc2626;
        background: #dc2626;
        color: #fff;
        border-radius: 8px;
        padding: 7px 12px;
        font-size: 13px;
        font-weight: 900;
    }

        .reject-btn:hover {
            background: #b91c1c;
            border-color: #b91c1c;
            color: #fff;
        }

    .empty-box {
        text-align: center;
        padding: 55px 20px;
    }

        .empty-box h5 {
            font-weight: 900;
            margin-bottom: 8px;
        }

        .empty-box p {
            color: #64748b;
            margin: 0;
        }

    .modal-content {
        direction: rtl;
        text-align: right;
        border-radius: 16px;
    }

    .modal-header .btn-close {
        margin: 0;
    }

    .modal-title {
        font-weight: 900;
    }

    .reject-textarea {
        border-radius: 10px;
        min-height: 110px;
        resize: vertical;
    }
</style>

<div class="manager-review-page">

    @if (TempData["Success"] != null)
    {
        <div class="review-alert review-alert-success">
            <i class="bi bi-check-circle"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="review-alert review-alert-error">
            <i class="bi bi-exclamation-triangle"></i>
            @TempData["Error"]
        </div>
    }

    <div class="review-header">
        <h1 class="review-title">مراجعة طلبات تعديل العملاء</h1>
        <p class="review-subtitle">
            الطلبات التي أرسلها فريق المبيعات وتحتاج إلى موافقة أو رفض.
        </p>
    </div>

    <div class="mb-3" dir="rtl">
        <a asp-controller="CustomerModificationManager"
           asp-action="Approved"
           class="btn btn-success fw-bold">
            <i class="bi bi-check-circle"></i>
            الطلبات المعتمدة
        </a>
    </div>

    <div class="review-panel">

        <div class="review-panel-head">
            <span>
                <i class="bi bi-clipboard-check"></i>
                الطلبات المرسلة للمراجعة
            </span>

            <span class="review-count">
                @requests.Count طلب
            </span>
        </div>

        @if (requests.Any())
        {
            <div class="table-responsive">
                <table class="review-table">
                    <thead>
                        <tr>
                            <th>الفرع</th>
                            <th>Requested By</th>
                            <th>كود العميل</th>
                            <th>اسم العميل الحالي</th>
                            <th>نوع العميل الحالي</th>
                            <th>نوع التعديل</th>
                            <th>الاسم الجديد</th>
                            <th>ملاحظات</th>
                            <th>تاريخ الإرسال</th>
                            <th style="text-align:left;">الإجراء</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in requests)
                        {
                            <tr>
                                <td>@item.BranchName</td>

                                <td>
                                    <span class="chip">
                                        @(string.IsNullOrWhiteSpace(item.CreatedBy) ? "-" : item.CreatedBy)
                                    </span>
                                </td>

                                <td>
                                    <span class="customer-code">@item.MarketCode</span>
                                </td>

                                <td class="customer-name">@item.MarketName</td>

                                <td>
                                    <span class="chip">@CustomerTypeText(item.CurrentCustomerType)</span>
                                </td>

                                <td>
                                    <span class="chip">@ModificationTypeText(item.ModificationType)</span>
                                </td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(item.NewMarketName))
                                    {
                                        <span>-</span>
                                    }
                                    else
                                    {
                                        <span class="new-name">@item.NewMarketName</span>
                                    }
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Notes) ? "-" : item.Notes)
                                </td>

                                <td>
                                    @(item.SubmittedAt.HasValue? item.SubmittedAt.Value.ToString("yyyy-MM-dd") : "-")
                                </td>

                                <td style="text-align:left;">
                                    <div class="action-buttons">

                                        <form asp-controller="CustomerModificationManager"
                                              asp-action="Approve"
                                              method="post"
                                              class="m-0"
                                              onsubmit="return confirm('هل تريد الموافقة على طلب التعديل؟');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="id" value="@item.Id" />

                                            <button type="submit" class="approve-btn">
                                                <i class="bi bi-check-lg"></i>
                                                موافقة
                                            </button>
                                        </form>

                                        <button type="button"
                                                class="reject-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#rejectModal_@item.Id">
                                            <i class="bi bi-x-lg"></i>
                                            رفض
                                        </button>

                                    </div>

                                    <div class="modal fade"
                                         id="rejectModal_@item.Id"
                                         tabindex="-1"
                                         aria-hidden="true">

                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">

                                                <form asp-controller="CustomerModificationManager"
                                                      asp-action="Reject"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="id" value="@item.Id" />

                                                    <div class="modal-header">
                                                        <h5 class="modal-title">
                                                            رفض طلب تعديل العميل
                                                        </h5>

                                                        <button type="button"
                                                                class="btn-close"
                                                                data-bs-dismiss="modal"
                                                                aria-label="Close"></button>
                                                    </div>

                                                    <div class="modal-body">
                                                        <p class="mb-2">
                                                            العميل:
                                                            <strong>@item.MarketName</strong>
                                                        </p>

                                                        <label class="form-label fw-bold">
                                                            سبب الرفض
                                                        </label>

                                                        <textarea name="rejectionReason"
                                                          class="form-control reject-textarea"
                                                          placeholder="اكتب سبب الرفض..."
                                                          required></textarea>
                                                    </div>

                                                    <div class="modal-footer">
                                                        <button type="button"
                                                                class="btn btn-outline-secondary"
                                                                data-bs-dismiss="modal">
                                                            إلغاء
                                                        </button>

                                                        <button type="submit"
                                                                class="btn btn-danger fw-bold">
                                                            تأكيد الرفض
                                                        </button>
                                                    </div>

                                                </form>

                                            </div>
                                        </div>
                                    </div>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-box">
                <h5>لا توجد طلبات للمراجعة</h5>
                <p>أي طلب تعديل عميل يتم إرساله من Sales سيظهر هنا.</p>
            </div>
        }

    </div>

</div>