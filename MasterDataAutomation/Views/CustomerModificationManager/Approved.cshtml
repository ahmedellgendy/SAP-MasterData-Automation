@model List<MasterDataAutomation.Application.Modules.CustomerModification.Dtos.CustomerModificationRequestDto>
@using MasterDataAutomation.Application.Modules.CustomerModification.Enums

@{
    ViewData["Title"] = "طلبات تعديل العملاء المعتمدة";

    var requests = Model ?? new List<MasterDataAutomation.Application.Modules.CustomerModification.Dtos.CustomerModificationRequestDto>();
}

@functions {
    string CustomerTypeText(CustomerModificationCustomerType type)
    {
        return type switch
        {
            CustomerModificationCustomerType.Private => "خاص",
            CustomerModificationCustomerType.Fridge => "ثلاجة",
            _ => "-"
        };
    }

    string ModificationTypeText(CustomerModificationType type)
    {
        return type switch
        {
            CustomerModificationType.RemoveFridge => "رفع الثلاجة",
            CustomerModificationType.ChangeName => "تعديل اسم",
            CustomerModificationType.ChangeToPrivate => "تحويل إلى خاص",
            CustomerModificationType.ChangeToFridge => "تحويل إلى ثلاجة",
            _ => "-"
        };
    }
}

<style>
    .approved-page {
        direction: rtl;
        text-align: right;
        font-family: "Segoe UI", Tahoma, Arial, sans-serif;
        color: #16232c;
    }

    .approved-header {
        background: linear-gradient(135deg, #14532d, #2f7d6b);
        color: #fff;
        border-radius: 20px;
        padding: 28px;
        margin-bottom: 24px;
    }

    .approved-title {
        font-size: 30px;
        font-weight: 900;
        margin: 0;
    }

    .approved-subtitle {
        margin: 8px 0 0;
        opacity: .9;
        font-size: 14px;
    }

    .top-actions {
        margin-bottom: 18px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-back {
        border: 1px solid #16232c;
        color: #16232c;
        background: transparent;
        font-weight: 900;
        border-radius: 10px;
        padding: 10px 16px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-back:hover {
            background: #16232c;
            color: #fff;
        }

    .approved-panel {
        background: #fff;
        border: 1px solid #e5e9ef;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .06);
    }

    .approved-panel-head {
        padding: 18px 20px;
        background: #f8fafc;
        border-bottom: 1px solid #e5e9ef;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        font-weight: 900;
    }

    .approved-count {
        background: #dcfce7;
        color: #166534;
        border-radius: 999px;
        padding: 6px 14px;
        font-size: 13px;
        font-weight: 900;
    }

    .approved-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

        .approved-table th {
            background: #f4f7f8;
            color: #64748b;
            padding: 12px 14px;
            font-size: 12px;
            border-bottom: 1px solid #e5e9ef;
            white-space: nowrap;
            text-align: right;
        }

        .approved-table td {
            padding: 14px;
            border-bottom: 1px solid #e5e9ef;
            vertical-align: middle;
            font-size: 14px;
        }

    .customer-code {
        font-family: Consolas, monospace;
        font-weight: 900;
        background: #ecfdf5;
        color: #0f766e;
        padding: 5px 8px;
        border-radius: 8px;
        display: inline-block;
    }

    .customer-name {
        font-weight: 900;
    }

    .chip {
        border-radius: 999px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 900;
        background: #f1f5f9;
        color: #475569;
        display: inline-block;
        white-space: nowrap;
    }

    .approved-badge {
        background: #dcfce7;
        color: #166534;
        border-radius: 999px;
        padding: 6px 12px;
        font-weight: 900;
        font-size: 12px;
        display: inline-block;
    }

    .empty-box {
        text-align: center;
        padding: 55px 20px;
    }

        .empty-box h5 {
            font-weight: 900;
            margin-bottom: 8px;
        }

        .empty-box p {
            color: #64748b;
            margin: 0;
        }
</style>

<div class="approved-page">

    <div class="approved-header">
        <h1 class="approved-title">طلبات تعديل العملاء المعتمدة</h1>
        <p class="approved-subtitle">
            هنا تظهر طلبات تعديل العملاء التي تمت الموافقة عليها.
        </p>
    </div>

    <div class="top-actions">
        <a asp-controller="CustomerModificationManager"
           asp-action="Index"
           class="btn-back">
            <i class="bi bi-clipboard-check"></i>
            طلبات المراجعة
        </a>
    </div>

    <div class="approved-panel">

        <div class="approved-panel-head">
            <span>
                <i class="bi bi-check-circle"></i>
                الطلبات المعتمدة
            </span>

            <span class="approved-count">
                @requests.Count طلب
            </span>
        </div>

        @if (requests.Any())
        {
            <div class="table-responsive">
                <table class="approved-table">
                    <thead>
                        <tr>
                            <th>الفرع</th>
                            <th>كود العميل</th>
                            <th>اسم العميل الحالي</th>
                            <th>نوع العميل الحالي</th>
                            <th>نوع التعديل</th>
                            <th>الاسم الجديد</th>
                            <th>تاريخ الإرسال</th>
                            <th>تاريخ الموافقة</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in requests)
                        {
                            <tr>
                                <td>@item.BranchName</td>

                                <td>
                                    <span class="customer-code">@item.MarketCode</span>
                                </td>

                                <td class="customer-name">@item.MarketName</td>

                                <td>
                                    <span class="chip">@CustomerTypeText(item.CurrentCustomerType)</span>
                                </td>

                                <td>
                                    <span class="chip">@ModificationTypeText(item.ModificationType)</span>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.NewMarketName) ? "-" : item.NewMarketName)
                                </td>

                                <td>
                                    @(item.SubmittedAt.HasValue? item.SubmittedAt.Value.ToString("yyyy-MM-dd") : "-")
                                </td>

                                <td>
                                    @(item.ReviewedAt.HasValue? item.ReviewedAt.Value.ToString("yyyy-MM-dd") : "-")
                                </td>

                                <td>
                                    <span class="approved-badge">تمت الموافقة</span>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="empty-box">
                <h5>لا توجد طلبات معتمدة</h5>
                <p>أي طلب تتم الموافقة عليه سيظهر هنا.</p>
            </div>
        }

    </div>

</div>