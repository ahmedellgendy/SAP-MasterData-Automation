    .form-select.is-valid {
        border-color: #198754;
        background-image: none;
    }

    .alert {
        border-radius: 0.5rem;
        border: none;
    }

    
</style>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Client-side validation styling
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('form');
            const inputs = form.querySelectorAll('.form-control, .form-select');

            inputs.forEach(input => {
                input.addEventListener('blur', function () {
                    if (this.classList.contains('input-validation-error')) {
                        this.classList.add('is-invalid');
                    } else if (this.value.trim()) {
                        this.classList.remove('is-invalid');
                    }
                });
            });

            form.addEventListener('submit', function (e) {
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                form.classList.add('was-validated');
            });
        });
    </script>
} *@

@model MasterDataAutomation.Web.ViewModels.CreateCustomerViewModel

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header Card -->
            <div class="card mb-4 border-success border-top border-5">
                <div class="card-body pb-3">
                    <h1 class="card-title mb-2" style="color: #2c3e50; font-weight: 600;">
                        <i class="bi bi-person-plus"></i> Create Customer
                    </h1>
                    <p class="text-muted mb-0 small">Add a new customer to your sales distribution network</p>
                </div>
            </div>

            <!-- Form Card -->
            <div class="card shadow">
                <form asp-action="Create" method="post" novalidate class="needs-validation">
                    <input asp-for="Index" type="hidden" />

                    <div class="card-body p-4">
                        <!-- Section 1: Line & Market -->
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="form-group">
                                    <label asp-for="Line" class="form-label fw-bold mb-2">
                                        <i class="bi bi-list-ul"></i> Line <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Line"
                                           class="form-control form-control-lg border-2"
                                           placeholder="e.g., Distribution Line A"
                                           style="border-color: #e0e0e0;" />
                                    <span asp-validation-for="Line" class="d-block mt-2 small text-danger fw-bold"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <div class="form-group">
                                    <label asp-for="Market" class="form-label fw-bold mb-2">
                                        <i class="bi bi-geo-alt"></i> Market <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Market"
                                           class="form-control form-control-lg border-2"
                                           placeholder="e.g., Elgendy Market "
                                           style="border-color: #e0e0e0;" />
                                    <span asp-validation-for="Market" class="d-block mt-2 small text-danger fw-bold"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Section 2: Branch & Sales District -->
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="form-group">
                                    <label asp-for="Branch" class="form-label fw-bold mb-2">
                                        <i class="bi bi-building"></i> Branch <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="Branch"
                                            asp-items="Model.Branches"
                                            class="form-select form-select-lg border-2"
                                            style="border-color: #e0e0e0;">
                                        <option value="">-- Select Branch --</option>
                                    </select>
                                    <span asp-validation-for="Branch" class="d-block mt-2 small text-danger fw-bold"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <div class="form-group">
                                    <label asp-for="SalesDistrict" class="form-label fw-bold mb-2">
                                        <i class="bi bi-map"></i> Sales District <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="SalesDistrict"
                                           class="form-control form-control-lg border-2"
                                           placeholder="CR00015"
                                           style="border-color: #e0e0e0;" />
                                    <span asp-validation-for="SalesDistrict" class="d-block mt-2 small text-danger fw-bold"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Section 3: Customer Type -->
                        <div class="row">
                            <div class="col-12 mb-4">
                                <div class="form-group">
                                    <label asp-for="CustomerType" class="form-label fw-bold mb-2">
                                        <i class="bi bi-tag"></i> Customer Type <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="CustomerType"
                                            asp-items="Model.CustomerTypes"
                                            class="form-select form-select-lg border-2"
                                            style="border-color: #e0e0e0;">
                                        <option value="">-- Select Customer Type --</option>
                                    </select>
                                    <span asp-validation-for="CustomerType" class="d-block mt-2 small text-danger fw-bold"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Footer with Buttons -->
                    <div class="card-footer bg-light p-4 border-0">
                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-success btn-lg flex-grow-1 fw-bold">
                                <i class="bi bi-check-circle"></i> Add Customer
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Help Text -->
            <div class="alert alert-info mt-4 mb-5">
                <i class="bi bi-info-circle"></i>
                <strong>Tip:</strong> All fields are required. Line and Market should be unique identifiers.
            </div>
        </div>
    </div>
</div>

<style>
    .border-5 {
        border-top-width: 5px !important;
    }

    .form-control-lg,
    .form-select-lg {
        font-size: 1rem;
        padding: 0.75rem 1rem;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
    }

        .form-control-lg:focus,
        .form-select-lg:focus {
            border-color: #28a745 !important;
            box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.25);
            transform: translateY(-1px);
        }

    .form-control.is-invalid,
    .form-select.is-invalid {
        border-color: #dc3545 !important;
        background-image: none;
    }

    .form-control.is-valid,
    .form-select.is-valid {
        border-color: #28a745 !important;
        background-image: none;
    }

    .form-label {
        color: #2c3e50;
        font-size: 0.95rem;
        letter-spacing: 0.3px;
    }

        .form-label i {
            margin-right: 0.5rem;
            color: #007bff;
        }

    .card {
        border-radius: 0.75rem;
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .btn-lg {
        padding: 0.75rem 1.5rem;
        font-weight: 500;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
    }

    .btn-success:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(40, 167, 69, 0.3);
        background-color: #218838;
    }

    .text-danger {
        font-weight: 600;
    }

    .alert {
        border-radius: 0.5rem;
        border: none;
        border-left: 4px solid #17a2b8;
    }

        .alert i {
            margin-right: 0.5rem;
        }

    
</style>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('form');
            const fields = form.querySelectorAll('[asp-for]');

            fields.forEach(field => {
                field.addEventListener('blur', function () {
                    validateField(this);
                });

                field.addEventListener('input', this () {
                    validateField(this);
                });

                field.addEventListener('change', function () {
                    validateField(this);
                });
            });

            function validateField(field) {
                if (!field.value.trim()) {
                    field.classList.add('is-invalid');
                    field.classList.remove('is-valid');
                } else {
                    field.classList.remove('is-invalid');
                    field.classList.add('is-valid');
                }
            }

            form.addEventListener('submit', function (e) {
                let isValid = true;
                fields.forEach(field => {
                    if (!field.value.trim()) {
                        field.classList.add('is-invalid');
                        field.classList.remove('is-valid');
                        isValid = false;
                    }
                });

                if (!isValid) {
                    e.preventDefault();
                    e.stopPropagation();
                }
            });
        });
    </script>
}