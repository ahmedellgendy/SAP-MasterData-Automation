@model MasterDataAutomation.Web.ViewModels.CreateCustomerViewModel

@{
    ViewData["Title"] = "إضافة عميل جديد";
}

<style>
    .create-customer-page {
        direction: rtl;
        text-align: right;
        font-family: "Segoe UI", Tahoma, Arial, sans-serif;
        color: #16232c;
    }

    .customer-header-card {
        border-radius: 16px;
        border: none;
        border-top: 5px solid #2f7d6b;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .06);
    }

    .customer-title {
        color: #16232c;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .customer-subtitle {
        color: #6b7a86;
        font-size: 14px;
        margin: 0;
    }

    .customer-form-card {
        border-radius: 16px;
        border: none;
        box-shadow: 0 10px 28px rgba(15, 23, 42, .08);
        overflow: hidden;
    }

    .section-title {
        font-size: 15px;
        font-weight: 900;
        color: #16232c;
        margin-bottom: 18px;
        padding-bottom: 10px;
        border-bottom: 1px solid #e5e9ef;
    }

    .form-label {
        color: #16232c;
        font-size: 14px;
        font-weight: 900;
        margin-bottom: 8px;
    }

        .form-label i {
            margin-left: 6px;
            margin-right: 0;
            color: #2f7d6b;
        }

    .form-control-lg,
    .form-select-lg {
        font-size: 1rem;
        padding: 0.75rem 1rem;
        border-radius: 10px;
        border-color: #dce3e8 !important;
        direction: rtl;
        text-align: right;
    }

        .form-control-lg:focus,
        .form-select-lg:focus {
            border-color: #2f7d6b !important;
            box-shadow: 0 0 0 0.2rem rgba(47, 125, 107, 0.15);
        }

    .form-select {
        background-position: left 0.75rem center;
        padding-left: 2.25rem;
        padding-right: 0.75rem;
    }

    .text-danger {
        display: block;
        text-align: right;
        font-weight: 700;
        margin-top: 6px;
    }

    .required-mark {
        color: #dc3545;
        font-weight: 900;
    }

    .customer-footer {
        background: #f8fafc;
        padding: 22px;
        border-top: 1px solid #e5e9ef;
    }

    .actions-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-save {
        background: #2f7d6b;
        border: 1px solid #2f7d6b;
        color: #fff;
        font-weight: 900;
        border-radius: 10px;
        padding: 12px 22px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 190px;
    }

        .btn-save:hover {
            background: #245f52;
            border-color: #245f52;
            color: #fff;
        }

    .btn-back {
        border: 1px solid #16232c;
        color: #16232c;
        background: transparent;
        font-weight: 900;
        border-radius: 10px;
        padding: 12px 22px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 120px;
    }

        .btn-back:hover {
            background: #16232c;
            color: #fff;
        }

    .help-box {
        background: #e7f3f0;
        border: 1px solid #cfe6de;
        color: #1d5347;
        border-radius: 12px;
        padding: 14px 16px;
        margin-top: 22px;
        font-weight: 700;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    @@media (max-width: 768px) {
        .actions-row {
            flex-direction: column;
        }

        .btn-save,
        .btn-back {
            width: 100%;
        }
    }
</style>

<div class="container mt-5 mb-5 create-customer-page">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card mb-4 customer-header-card">
                <div class="card-body pb-3">
                    <h1 class="customer-title">
                        <i class="bi bi-person-plus"></i>
                        إضافة عميل جديد
                    </h1>

                    <p class="customer-subtitle">
                        أضف بيانات العميل الجديد واحفظ الطلب كمسودة قبل إرساله للمراجعة.
                    </p>
                </div>
            </div>

            <div class="card customer-form-card">
                <form asp-action="Create" method="post">
                    <input asp-for="Index" type="hidden" />

                    <div class="card-body p-4">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="section-title">
                            بيانات العميل
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-4">
                                <div class="form-group">
                                    <label asp-for="Line" class="form-label">
                                        <i class="bi bi-list-ul"></i>
                                        الخط
                                        <span class="required-mark">*</span>
                                    </label>

                                    <input asp-for="Line"
                                           class="form-control form-control-lg border-2"
                                           placeholder="مثال: خط الدقي " />

                                    <span asp-validation-for="Line"
                                          class="small text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6 mb-4">
                                <div class="form-group">
                                    <label asp-for="Market" class="form-label">
                                        <i class="bi bi-shop"></i>
                                        اسم العميل / الماركت
                                        <span class="required-mark">*</span>
                                    </label>

                                    <input asp-for="Market"
                                           class="form-control form-control-lg border-2"
                                           placeholder="مثال: ماركت الحمدلله" />

                                    <span asp-validation-for="Market"
                                          class="small text-danger"></span>
                                </div>
                            </div>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-4">
                                <div class="form-group">
                                    <label asp-for="Branch" class="form-label">
                                        <i class="bi bi-building"></i>
                                        الفرع
                                        <span class="required-mark">*</span>
                                    </label>

                                    <select asp-for="Branch"
                                            asp-items="Model.Branches"
                                            class="form-select form-select-lg border-2">
                                        <option value="">-- اختر الفرع --</option>
                                    </select>

                                    <span asp-validation-for="Branch"
                                          class="small text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6 mb-4">
                                <div class="form-group">
                                    <label asp-for="SalesDistrict" class="form-label">
                                        <i class="bi bi-map"></i>
                                        Sales District
                                        <span class="required-mark">*</span>
                                    </label>

                                    <input asp-for="SalesDistrict"
                                           class="form-control form-control-lg border-2"
                                           placeholder="مثال: CR00015" />

                                    <span asp-validation-for="SalesDistrict"
                                          class="small text-danger"></span>
                                </div>
                            </div>

                        </div>

                        <div class="row">

                            <div class="col-12 mb-2">
                                <div class="form-group">
                                    <label asp-for="CustomerType" class="form-label">
                                        <i class="bi bi-tag"></i>
                                        نوع العميل
                                        <span class="required-mark">*</span>
                                    </label>

                                    <select asp-for="CustomerType"
                                            asp-items="Model.CustomerTypes"
                                            class="form-select form-select-lg border-2">
                                        <option value="">-- اختر نوع العميل --</option>
                                    </select>

                                    <span asp-validation-for="CustomerType"
                                          class="small text-danger"></span>
                                </div>
                            </div>

                        </div>

                    </div>

                    <div class="customer-footer">
                        <div class="actions-row">
                            <button type="submit" class="btn btn-save">
                                <i class="bi bi-save"></i>
                                حفظ كمسودة 
                            </button>

                            <a asp-controller="SalesDashboard"
                               asp-action="Index"
                               class="btn-back">
                                <i class="bi bi-arrow-left-circle"></i>
                                إلغاء
                            </a>
                        </div>
                    </div>
                </form>
            </div>

            <div class="help-box">
                <i class="bi bi-info-circle"></i>
                <span>
                    كل الحقول المطلوبة يجب إدخالها. بعد حفظ العميل  يمكن إرساله للمراجعة من صفحة المسودات.
                </span>
            </div>

        </div>
    </div>
</div>