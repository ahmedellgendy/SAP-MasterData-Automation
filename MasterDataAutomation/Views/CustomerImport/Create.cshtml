@* @model MasterDataAutomation.Web.ViewModels.CreateCustomerViewModel

<h2>Create Customer</h2>

<form asp-action="Create" method="post">
    <input asp-for="Index" type="hidden" />

    <div class="mb-3">
        <label asp-for="Line"></label>
        <input asp-for="Line" class="form-control" />
        <span asp-validation-for="Line" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Market"></label>
        <input asp-for="Market" class="form-control" />
        <span asp-validation-for="Market" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Branch"></label>
        <select asp-for="Branch"
                asp-items="Model.Branches"
                class="form-select">
            <option value="">-- Select Branch --</option>
        </select>
        <span asp-validation-for="Branch" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SalesDistrict"></label>
        <input asp-for="SalesDistrict" class="form-control" />
        <span asp-validation-for="SalesDistrict" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CustomerType"></label>
        <select asp-for="CustomerType"
                asp-items="Model.CustomerTypes"
                class="form-select">
            <option value="">-- Select Customer Type --</option>
        </select>
        <span asp-validation-for="CustomerType" class="text-danger"></span>
    </div>

    <button class="btn btn-success">
        Add Customer
    </button>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
} *@


