@using System.Text.Json
@using MasterDataAutomation.Application.Dtos

@model MasterDataAutomation.Web.ViewModels.UploadViewModel

@if (TempData["Success"] != null)
{
    <div class="alert alert-success shadow-sm">
        <i class="bi bi-check-circle"></i>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger shadow-sm">
        <i class="bi bi-exclamation-triangle"></i>
        @TempData["Error"]
    </div>
}

@if (TempData["UploadErrors"] != null)
{
    var errors = JsonSerializer.Deserialize<List<ExcelErrorDto>>(TempData["UploadErrors"]!.ToString()!);

    if (errors != null && errors.Any())
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-danger text-white fw-bold">
                <i class="bi bi-exclamation-octagon"></i>
                Upload Errors
                <span class="badge bg-light text-danger ms-2">@errors.Count</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Row</th>
                            <th>Column</th>
                            <th>Error Message</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var error in errors)
                        {
                            <tr>
                                <td>@error.RowNumber</td>
                                <td>@error.Column</td>
                                <td class="text-danger fw-semibold">
                                    @error.Message
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <!-- Header Card -->
            <div class="card mb-4 border-info border-top border-5">
                <div class="card-body pb-3">
                    <h1 class="card-title mb-2" style="color: #2c3e50; font-weight: 600;">
                        <i class="bi bi-file-earmark-arrow-up"></i> Upload Excel To Draft
                    </h1>
                    <p class="text-muted mb-0 small">Import your Excel file and create a draft</p>
                </div>
            </div>

            <!-- Form Card -->
            <div class="card shadow">
                <form asp-action="UploadToDraft" method="post" enctype="multipart/form-data" novalidate>
                    <div class="card-body p-5">

                        <!-- File Upload Section -->
                        <div class="mb-4">
                            <label asp-for="File" class="form-label fw-bold mb-3 d-block">
                                <i class="bi bi-file-earmark-excel"></i> Select Excel File <span class="text-danger">*</span>
                            </label>

                            <!-- Drag & Drop Zone -->
                            <div id="dropZone"
                                 class="border-3 border-dashed rounded-3 p-5 text-center"
                                 style="border-color: #17a2b8; cursor: pointer; transition: all 0.3s ease; background-color: #f0f8f9;">

                                <div class="mb-3">
                                    <i class="bi bi-cloud-upload" style="font-size: 3.5rem; color: #17a2b8;"></i>
                                </div>

                                <p class="mb-2 fw-bold" style="color: #2c3e50; font-size: 1.1rem;">
                                    Drag your Excel file here
                                </p>
                                <p class="mb-3 small text-muted">
                                    or click to browse your files
                                </p>
                                <p class="small badge bg-light text-dark">
                                    <i class="bi bi-check-circle"></i> .xlsx only
                                </p>

                                <input asp-for="File"
                                       type="file"
                                       accept=".xlsx"
                                       id="fileInput"
                                       class="position-absolute top-0 start-0 w-100 h-100"
                                       style="opacity: 0; cursor: pointer;" />
                            </div>

                            <!-- File Selected Alert -->
                            <div id="fileAlert" class="mt-3" style="display: none;">
                                <div class="alert alert-success alert-dismissible fade show mb-0" role="alert">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <strong id="fileName" class="ms-2"></strong>
                                    <button type="button" class="btn-close" id="clearFile" aria-label="Close"></button>
                                </div>
                            </div>

                            <!-- Validation Error -->
                            <span asp-validation-for="File" class="d-block mt-3 small text-danger fw-bold"></span>
                        </div>
                    </div>

                    <!-- Footer with Button -->
                    <div class="card-footer bg-light p-4 border-0 d-flex gap-2">
                        <button type="submit" class="btn btn-info btn-lg fw-bold flex-grow-1">
                            <i class="bi bi-cloud-check"></i> Upload
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    </div>
                </form>
            </div>

            <!-- Info Box -->
            <div class="mt-4">
                <div class="alert alert-info border-0">
                    <i class="bi bi-info-circle"></i>
                    <strong> Tip:</strong> Upload a properly formatted Excel file to create a draft quickly
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-5 {
        border-top-width: 5px !important;
    }

    .border-3 {
        border-width: 3px !important;
    }

    .border-dashed {
        border-style: dashed !important;
    }

    .rounded-3 {
        border-radius: 0.75rem;
    }

    #dropZone {
        position: relative;
    }

        #dropZone:hover {
            background-color: #e0f7fa;
            border-color: #0097a7 !important;
            box-shadow: 0 6px 16px rgba(0, 150, 136, 0.15);
            transform: translateY(-2px);
        }

        #dropZone.dragover {
            background-color: #e0f7fa;
            border-color: #00695c !important;
            box-shadow: 0 8px 20px rgba(0, 150, 136, 0.25);
        }

    .form-label {
        color: #2c3e50;
        font-size: 1rem;
        letter-spacing: 0.3px;
    }

        .form-label i {
            margin-right: 0.5rem;
            color: #17a2b8;
        }

    .card {
        border-radius: 0.75rem;
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        transition: all 0.3s ease;
    }

        .card:hover {
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
        }

    .btn-lg {
        padding: 0.75rem 1.5rem;
        font-weight: 500;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
    }

    .btn-info:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(23, 162, 184, 0.3);
        background-color: #0c5460;
        border-color: #0c5460;
    }

    .btn-outline-secondary:hover {
        transform: translateY(-2px);
    }

    .alert {
        border-radius: 0.5rem;
        border: none;
        border-left: 4px solid;
    }

    .alert-success {
        border-left-color: #28a745;
    }

    .alert-info {
        border-left-color: #17a2b8;
    }

    .badge {
        font-size: 0.85rem;
        padding: 0.4rem 0.8rem;
    }


    #dropZone {
        padding: 2.5rem 1rem !important;
    }

        #dropZone i {
            font-size: 2.5rem !important;
        }

    .card-body {
        padding: 1.5rem !important;
    }
</style>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const fileInput = document.getElementById('fileInput');
            const dropZone = document.getElementById('dropZone');
            const fileAlert = document.getElementById('fileAlert');
            const fileName = document.getElementById('fileName');
            const clearFileBtn = document.getElementById('clearFile');
            const form = document.querySelector('form');

            // Prevent default drag behaviors
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, preventDefaults, false);
                document.body.addEventListener(eventName, preventDefaults, false);
            });

            function preventDefaults(e) {
                e.preventDefault();
                e.stopPropagation();
            }

            // Highlight drop zone when item is dragged over
            ['dragenter', 'dragover'].forEach(eventName => {
                dropZone.addEventListener(eventName, () => {
                    dropZone.classList.add('dragover');
                });
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, () => {
                    dropZone.classList.remove('dragover');
                });
            });

            // Handle dropped files
            dropZone.addEventListener('drop', handleDrop, false);

            function handleDrop(e) {
                const files = e.dataTransfer.files;
                fileInput.files = files;
                handleFileSelect();
            }

            // Click to browse
            // dropZone.addEventListener('click', () => {
            //     fileInput.click();
            // });

            // Handle file selection via input
            fileInput.addEventListener('change', handleFileSelect);

            function handleFileSelect() {
                const files = fileInput.files;

                if (files.length === 0) {
                    fileAlert.style.display = 'none';
                    fileInput.classList.remove('is-valid', 'is-invalid');
                    return;
                }

                const file = files[0];

                // Validate file extension
                if (!file.name.endsWith('.xlsx')) {
                    alert('⚠️ Only .xlsx files are allowed');
                    fileInput.value = '';
                    fileAlert.style.display = 'none';
                    fileInput.classList.add('is-invalid');
                    return;
                }

                // Show file name
                fileName.textContent = file.name;
                fileAlert.style.display = 'block';
                fileInput.classList.add('is-valid');
                fileInput.classList.remove('is-invalid');
            }

            // Clear file button
            clearFileBtn.addEventListener('click', () => {
                fileInput.value = '';
                fileAlert.style.display = 'none';
                fileInput.classList.remove('is-valid', 'is-invalid');
            });

            // Form validation on submit
            form.addEventListener('submit', function (e) {
                if (fileInput.files.length === 0) {
                    e.preventDefault();
                    e.stopPropagation();
                    fileInput.classList.add('is-invalid');
                }
            });
        });
    </script>
}