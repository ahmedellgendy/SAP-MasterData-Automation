@model IEnumerable<MasterDataAutomation.Application.Dtos.GenerationHistoryDto>

@{
    ViewData["Title"] = "History";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success shadow-sm">
        <i class="bi bi-check-circle"></i>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger shadow-sm">
        <i class="bi bi-exclamation-triangle"></i>
        @TempData["Error"]
    </div>
}

<div class="card shadow-sm border-0">

    <div class="card-header bg-light fw-bold py-3 d-flex justify-content-between align-items-center">
        <span>
            <i class="bi bi-clock-history"></i>
            Generated SAP Files History
        </span>

        <a asp-controller="SalesDashboard"
           asp-action="Index"
           class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i>
            Back to Dashboard
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">

            <table class="table table-hover mb-0">

                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>File Name</th>
                        <th>Customers</th>
                        <th>First BP</th>
                        <th>Last BP</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @item.Date.ToString("yyyy-MM-dd HH:mm")
                            </td>

                            <td>
                                <i class="bi bi-file-earmark-excel text-success"></i>
                                @item.FileName
                            </td>

                            <td>
                                @item.CustomersCount
                            </td>

                            <td>
                                @item.FirstBpCode
                            </td>

                            <td>
                                @item.LastBpCode
                            </td>

                            <td>
                                @if (item.Status == "Success")
                                {
                                    <span class="badge bg-success">
                                        Success
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        @item.Status
                                    </span>
                                }
                            </td>
                            <td>
                                <a asp-action="DownloadHistoryFile"
                                   asp-route-fileName="@item.FileName"
                                   class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-download"></i>
                                    Download
                                </a>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-inbox fs-1 d-block mb-3"></i>
            <h5>No history yet</h5>
            <p class="mb-0">
                Generated SAP files will appear here.
            </p>
        </div>
    }

</div>