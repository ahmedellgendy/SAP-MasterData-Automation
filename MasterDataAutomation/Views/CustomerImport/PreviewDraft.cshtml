@model List<MasterDataAutomation.Application.Dtos.CustomerImportDto>

@{
    ViewData["Title"] = "Preview Draft";

    var totalRecords = Model?.Count ?? 0;
    var branchCount = Model.Select(x => x.Branch).Distinct().Count();
    var typeCount = Model.Select(x => x.CustomerType).Distinct().Count();
}

<div class="container-fluid mt-4 mb-4">

    <div class="card shadow border-0" style="border-radius:0.75rem; overflow:hidden;">

        <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-1 fw-bold">
                    <i class="bi bi-eye"></i>
                    Preview Before SAP Generation
                </h4>

                <small class="text-muted">
                    Review draft customers before generating SAP upload file.
                </small>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Draft" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Back
                </a>

                <form asp-action="GenerateDraft" method="post">
                    <button type="submit"
                            class="btn btn-success"
                            onclick="return confirm('Generate SAP file now?');">
                        <i class="bi bi-file-earmark-spreadsheet"></i>
                        Confirm Generate
                    </button>
                </form>
            </div>
        </div>

        <div class="card-body bg-light">
            <div class="row g-3">

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center">
                            <i class="bi bi-people fs-2 text-primary"></i>
                            <h3 class="mb-0 mt-2">@totalRecords</h3>
                            <small class="text-muted">Total Customers</small>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center">
                            <i class="bi bi-building fs-2 text-info"></i>
                            <h3 class="mb-0 mt-2">@branchCount</h3>
                            <small class="text-muted">Branches</small>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center">
                            <i class="bi bi-tags fs-2 text-success"></i>
                            <h3 class="mb-0 mt-2">@typeCount</h3>
                            <small class="text-muted">Customer Types</small>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Line</th>
                        <th>Market</th>
                        <th>Branch</th>
                        <th>Sales District</th>
                        <th>Customer Type</th>
                    </tr>
                </thead>

                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr>
                            <td class="fw-bold">@(i + 1)</td>
                            <td>@Model[i].Line</td>
                            <td>@Model[i].Market</td>
                            <td>
                                <span class="badge bg-info text-dark">
                                    @Model[i].Branch
                                </span>
                            </td>
                            <td>@Model[i].SalesDistrict</td>
                            <td>
                                <span class="badge bg-secondary">
                                    @Model[i].CustomerType
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white d-flex justify-content-end gap-2">
            <a asp-action="Draft" class="btn btn-outline-secondary">
                Cancel
            </a>

            <form asp-action="GenerateDraft" method="post">
                <button type="submit"
                        class="btn btn-success"
                        onclick="return confirm('Generate SAP file now?');">
                    <i class="bi bi-check-circle"></i>
                    Confirm Generate SAP File
                </button>
            </form>
        </div>

    </div>

</div>