@{
    ViewData["Title"] = "Upload Customers";
}


<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <!-- Header Card -->
            <div class="card mb-4 border-success border-top border-5">
                <div class="card-body pb-3">
                    <h1 class="card-title mb-2" style="color: #2c3e50; font-weight: 600;">
                        <i class="bi bi-cloud-upload"></i> Upload Customer Excel
                    </h1>
                    <p class="text-muted mb-0 small">Import your Excel file and generate SAP file</p>
                </div>
            </div>

            <!-- Form Card -->
            <div class="card shadow">
                <form method="post" enctype="multipart/form-data" novalidate>
                    <div class="card-body p-5">

                        <!-- File Upload Section -->
                        <div class="mb-4">
                            <label class="form-label fw-bold mb-3 d-block">
                                <i class="bi bi-file-earmark-excel"></i> Select Excel File <span class="text-danger">*</span>
                            </label>

                            <!-- Drag & Drop Zone -->
                            <div id="dropZone"
                                 class="border-3 border-dashed rounded-3 p-5 text-center"
                                 style="border-color: #28a745; cursor: pointer; transition: all 0.3s ease; background-color: #f0fdf4;">

                                <div class="mb-3">
                                    <i class="bi bi-cloud-check" style="font-size: 3.5rem; color: #28a745;"></i>
                                </div>

                                <p class="mb-2 fw-bold" style="color: #2c3e50; font-size: 1.1rem;">
                                    Drag your Excel file here
                                </p>
                                <p class="mb-3 small text-muted">
                                    or click to browse your files
                                </p>
                                <p class="small badge bg-light text-dark">
                                    <i class="bi bi-check-circle"></i> .xlsx only
                                </p>

                                <input type="file"
                                       name="file"
                                       accept=".xlsx"
                                       id="fileInput"
                                       class="position-absolute top-0 start-0 w-100 h-100"
                                       style="opacity: 0; cursor: pointer;"
                                       required />
                            </div>

                            <!-- File Selected Alert -->
                            <div id="fileAlert" class="mt-3" style="display: none;">
                                <div class="alert alert-success alert-dismissible fade show mb-0" role="alert">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <strong id="fileName" class="ms-2"></strong>
                                    <button type="button" class="btn-close" id="clearFile" aria-label="Close"></button>
                                </div>
                            </div>
                        </div>

                        <!-- Info Box -->
                        <div class="alert alert-info border-0 mb-0">
                            <i class="bi bi-info-circle"></i>
                            <strong> Requirements:</strong> Your Excel file should have columns: Line, Market, Branch, Sales District, Customer Type
                        </div>
                    </div>

                    <!-- Footer with Buttons -->
                    <div class="card-footer bg-light p-4 border-0 d-flex gap-2">
                        <button type="submit" class="btn btn-success btn-lg fw-bold flex-grow-1">
                            <i class="bi bi-upload"></i> Upload
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-arrow-left"></i> Back
                        </a>
                    </div>
                </form>
            </div>

            <!-- Tips Box -->
            <div class="mt-4">
                <div class="alert alert-warning border-0">
                    <i class="bi bi-lightbulb"></i>
                    <strong> Tip:</strong> Make sure your Excel file is properly formatted before uploading to avoid errors.
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-5 {
        border-top-width: 5px !important;
    }

    .border-3 {
        border-width: 3px !important;
    }

    .border-dashed {
        border-style: dashed !important;
    }

    .rounded-3 {
        border-radius: 0.75rem;
    }

    #dropZone {
        position: relative;
    }

        #dropZone:hover {
            background-color: #dcfce7;
            border-color: #16a34a !important;
            box-shadow: 0 6px 16px rgba(34, 197, 94, 0.15);
            transform: translateY(-2px);
        }

        #dropZone.dragover {
            background-color: #bbf7d0;
            border-color: #15803d !important;
            box-shadow: 0 8px 20px rgba(34, 197, 94, 0.25);
        }

    .form-label {
        color: #2c3e50;
        font-size: 1rem;
        letter-spacing: 0.3px;
    }

        .form-label i {
            margin-right: 0.5rem;
            color: #28a745;
        }

    .card {
        border-radius: 0.75rem;
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        transition: all 0.3s ease;
    }

        .card:hover {
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
        }

    .btn-lg {
        padding: 0.75rem 1.5rem;
        font-weight: 500;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
    }

    .btn-success:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(40, 167, 69, 0.3);
        background-color: #1e7e34;
        border-color: #1e7e34;
    }

    .btn-outline-secondary:hover {
        transform: translateY(-2px);
    }

    .alert {
        border-radius: 0.5rem;
        border: none;
        border-left: 4px solid;
    }

    .alert-success {
        border-left-color: #28a745;
    }

    .alert-info {
        border-left-color: #0dcaf0;
    }

    .alert-warning {
        border-left-color: #ffc107;
    }

    .alert i {
        margin-right: 0.5rem;
    }


    #dropZone {
        padding: 2.5rem 1rem !important;
    }

        #dropZone i {
            font-size: 2.5rem !important;
        }

    .card-body {
        padding: 1.5rem !important;
    }

    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const fileInput = document.getElementById('fileInput');
        const dropZone = document.getElementById('dropZone');
        const fileAlert = document.getElementById('fileAlert');
        const fileName = document.getElementById('fileName');
        const clearFileBtn = document.getElementById('clearFile');
        const form = document.querySelector('form');

        // Prevent default drag behaviors
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, preventDefaults, false);
            document.body.addEventListener(eventName, preventDefaults, false);
        });

        function preventDefaults(e) {
            e.preventDefault();
            e.stopPropagation();
        }

        // Highlight drop zone when item is dragged over
        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => {
                dropZone.classList.add('dragover');
            });
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => {
                dropZone.classList.remove('dragover');
            });
        });

        // Handle dropped files
        dropZone.addEventListener('drop', handleDrop, false);

        function handleDrop(e) {
            const files = e.dataTransfer.files;
            fileInput.files = files;
            handleFileSelect();
        }

        // Click to browse
        dropZone.addEventListener('click', () => {
            fileInput.click();
        });

        // Handle file selection
        fileInput.addEventListener('change', handleFileSelect);

        function handleFileSelect() {
            const files = fileInput.files;

            if (files.length === 0) {
                fileAlert.style.display = 'none';
                return;
            }

            const file = files[0];

            // Validate file type
            if (!file.name.endsWith('.xlsx')) {
                alert('⚠️ Only .xlsx files are allowed');
                fileInput.value = '';
                fileAlert.style.display = 'none';
                return;
            }

            // Show file name
            fileName.textContent = file.name;
            fileAlert.style.display = 'block';
        }

        // Clear file
        clearFileBtn.addEventListener('click', () => {
            fileInput.value = '';
            fileAlert.style.display = 'none';
        });

        // Form validation
        form.addEventListener('submit', function (e) {
            if (fileInput.files.length === 0) {
                e.preventDefault();
                e.stopPropagation();
                alert('⚠️ Please select a file');
            }
        });
    });
</script>