@* @model List<MasterDataAutomation.Application.Modules.ProductMaster.Dtos.ProductDto>

@{
    ViewData["Title"] = "Products";

    var products = Model ?? new List<MasterDataAutomation.Application.Modules.ProductMaster.Dtos.ProductDto>();

    var totalProducts = products.Count;
    var activeCount = products.Count(p => p.IsActive);
    var inactiveCount = totalProducts - activeCount;

    var canManageProducts = User.IsInRole("Admin") || User.IsInRole("ExecutiveManager");
    var canCreateRequest = User.IsInRole("Admin") || User.IsInRole("AccountsUser");
}

<style>
    :root {
        --ink: #16232c;
        --ink-soft: #5b6b78;
        --ink-faint: #93a0aa;
        --paper: #f3f6f6;
        --surface: #ffffff;
        --line: #e0e6e7;
        --accent: #2f7d6b;
        --accent-ink: #1d5347;
        --accent-soft: #e6f1ee;
        --warn: #b6483f;
        --warn-soft: #f7e9e7;
    }

    .pm-wrap {
        color: var(--ink);
        background: var(--paper);
        border-radius: 0.5rem;
        padding: 1.5rem;
        font-family: "Segoe UI", system-ui, sans-serif;
    }

    .pm-eyebrow {
        font-family: Consolas, monospace;
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent-ink);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.6rem;
    }

        .pm-eyebrow::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--accent);
            display: inline-block;
        }

    .pm-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 1rem;
        border-bottom: 2px solid var(--ink);
        padding-bottom: 1.25rem;
        margin-bottom: 1.5rem;
    }

    .pm-title {
        font-weight: 800;
        font-size: 2rem;
        margin: 0;
        color: var(--ink);
    }

    .pm-sub {
        color: var(--ink-soft);
        font-size: 0.92rem;
        margin: 0.3rem 0 0;
    }

    .pm-actions {
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
    }

    .btn-flat {
        font-weight: 600;
        font-size: 0.85rem;
        border-radius: 0.35rem;
        padding: 0.55rem 1.05rem;
        border: 1.5px solid var(--ink);
        background: transparent;
        color: var(--ink);
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        transition: background 0.12s ease, color 0.12s ease;
        text-decoration: none;
    }

        .btn-flat:hover {
            background: var(--ink);
            color: #fff;
        }

    .btn-flat-solid {
        border-color: var(--accent);
        background: var(--accent);
        color: #fff;
    }

        .btn-flat-solid:hover {
            background: var(--accent-ink);
            border-color: var(--accent-ink);
            color: #fff;
        }

    .pm-ticker {
        display: flex;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 0.45rem;
        margin-bottom: 1.5rem;
        overflow: hidden;
    }

    .pm-ticker-item {
        flex: 1;
        padding: 1rem 1.4rem;
        border-right: 1px solid var(--line);
        display: flex;
        align-items: baseline;
        gap: 0.6rem;
    }

        .pm-ticker-item:last-child {
            border-right: none;
        }

    .pm-ticker-num {
        font-weight: 800;
        font-size: 1.6rem;
        color: var(--ink);
    }

    .pm-ticker-label {
        font-family: Consolas, monospace;
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-faint);
    }

    .pm-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 0.4rem;
    }

    .dot-accent {
        background: var(--accent);
    }

    .dot-warn {
        background: var(--warn);
    }

    .dot-ink {
        background: var(--ink-faint);
    }

    .pm-panel {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 0.45rem;
        overflow: hidden;
    }

    .pm-panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--line);
    }

    .pm-panel-title {
        font-family: Consolas, monospace;
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-soft);
        font-weight: 600;
    }

    .pm-search-form {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        flex: 1;
        max-width: 480px;
    }

    .pm-search-input {
        flex: 1;
        border: 1px solid var(--line);
        border-radius: 0.35rem;
        padding: 0.5rem 0.85rem;
        font-size: 0.88rem;
        background: var(--paper);
    }

        .pm-search-input:focus {
            outline: none;
            border-color: var(--accent);
            background: #fff;
        }

    .btn-icon-flat {
        border: 1px solid var(--line);
        background: #fff;
        border-radius: 0.35rem;
        padding: 0.5rem 0.7rem;
        color: var(--ink-soft);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: all 0.12s ease;
    }

        .btn-icon-flat:hover {
            border-color: var(--ink);
            color: var(--ink);
        }

    table.pm-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
    }

        table.pm-table thead th {
            font-family: Consolas, monospace;
            font-size: 0.68rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--ink-faint);
            font-weight: 600;
            text-align: left;
            padding: 0.75rem 1.1rem;
            background: var(--paper);
            border-bottom: 1px solid var(--line);
            white-space: nowrap;
        }

        table.pm-table tbody td {
            padding: 0.85rem 1.1rem;
            border-bottom: 1px solid var(--line);
            vertical-align: middle;
            font-size: 0.9rem;
        }

        table.pm-table tbody tr:last-child td {
            border-bottom: none;
        }

        table.pm-table tbody tr:hover {
            background: var(--accent-soft);
        }

    .pm-idx {
        font-family: Consolas, monospace;
        color: var(--ink-faint);
        font-size: 0.8rem;
    }

    .pm-code {
        font-family: Consolas, monospace;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--ink);
        border-left: 3px solid var(--accent);
        padding-left: 0.55rem;
    }

    .pm-name {
        font-weight: 600;
        color: var(--ink);
    }

    .pm-price {
        font-family: Consolas, monospace;
        font-weight: 600;
        color: var(--ink);
        text-align: right;
    }

    .pm-currency {
        font-family: Consolas, monospace;
        font-size: 0.72rem;
        color: var(--ink-soft);
        border: 1px solid var(--line);
        padding: 0.15rem 0.45rem;
        border-radius: 0.25rem;
    }

    .pm-status {
        display: inline-flex;
        align-items: center;
        font-size: 0.82rem;
        font-weight: 600;
    }

        .pm-status.is-active {
            color: var(--accent-ink);
        }

        .pm-status.is-inactive {
            color: var(--warn);
        }

    .pm-row-actions {
        display: flex;
        gap: 0.4rem;
        justify-content: flex-end;
    }

    .pm-btn-mini {
        border: 1px solid var(--line);
        background: #fff;
        border-radius: 0.35rem;
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--ink-soft);
        text-decoration: none;
        transition: all 0.12s ease;
    }

        .pm-btn-mini:hover {
            border-color: var(--accent);
            color: var(--accent-ink);
            background: var(--accent-soft);
        }

        .pm-btn-mini.danger:hover {
            border-color: var(--warn);
            color: var(--warn);
            background: var(--warn-soft);
        }

    .pm-empty {
        text-align: center;
        padding: 3.5rem 2rem;
    }

    .pm-empty-tag {
        width: 60px;
        height: 60px;
        border: 1.5px dashed var(--ink-faint);
        border-radius: 0.45rem;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.1rem;
        color: var(--ink-faint);
        font-size: 1.4rem;
    }

    .pm-alert {
        border-radius: 0.35rem;
        padding: 0.85rem 1.1rem;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.9rem;
        font-weight: 500;
        border: 1px solid transparent;
    }

    .pm-alert-success {
        background: var(--accent-soft);
        color: var(--accent-ink);
        border-color: #cfe6de;
    }

    .pm-alert-error {
        background: var(--warn-soft);
        color: var(--warn);
        border-color: #edd2ce;
    }

    @@media (max-width: 767px) {
        .pm-ticker {
            flex-direction: column;
        }

        .pm-ticker-item {
            border-right: none;
            border-bottom: 1px solid var(--line);
        }

            .pm-ticker-item:last-child {
                border-bottom: none;
            }

        .pm-search-form {
            max-width: 100%;
        }
    }
</style>

@if (TempData["Success"] != null)
{
    <div class="pm-alert pm-alert-success">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="pm-alert pm-alert-error">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<div class="pm-wrap">

    <div class="pm-header">
        <div>
            <div class="pm-eyebrow">Master Data · SAP Price List</div>
            <h1 class="pm-title">Products</h1>
            <p class="pm-sub">Retail and outlet selling prices for approved products.</p>
        </div>

        <div class="pm-actions">
            @if (canCreateRequest)
            {
                <a asp-controller="ProductRequests" asp-action="Create" class="btn-flat">
                    <i class="bi bi-file-earmark-plus"></i>
                    New Product Request
                </a>
            }

            @if (canManageProducts)
            {
                <a asp-controller="Products"
                   asp-action="Import"
                   class="btn-flat">
                    <i class="bi bi-file-earmark-excel"></i>
                    Import Excel
                </a>

                <a asp-controller="Products"
                   asp-action="Export"
                   asp-route-searchTerm="@ViewBag.SearchTerm"
                   class="btn btn-success mb-3">
                    <i class="bi bi-file-earmark-excel"></i>
                    Export Excel
                </a>

                <a asp-controller="Products" asp-action="Create" class="btn-flat btn-flat-solid">
                    <i class="bi bi-plus-lg"></i>
                    Add Product
                </a>
            }
        </div>
    </div>

    <div class="pm-ticker">
        <div class="pm-ticker-item">
            <span class="pm-ticker-num">@totalProducts</span>
            <span class="pm-ticker-label"><span class="pm-dot dot-ink"></span>Total</span>
        </div>

        <div class="pm-ticker-item">
            <span class="pm-ticker-num">@activeCount</span>
            <span class="pm-ticker-label"><span class="pm-dot dot-accent"></span>Active</span>
        </div>

        <div class="pm-ticker-item">
            <span class="pm-ticker-num">@inactiveCount</span>
            <span class="pm-ticker-label"><span class="pm-dot dot-warn"></span>Inactive</span>
        </div>
    </div>

    <div class="pm-panel">

        <div class="pm-panel-head">
            <span class="pm-panel-title">
                <i class="bi bi-table"></i>
                Product Records — @totalProducts
            </span>

            <form asp-controller="Products" asp-action="Index" method="get" class="pm-search-form">
                <input type="text"
                       name="searchTerm"
                       value="@ViewBag.SearchTerm"
                       class="pm-search-input"
                       placeholder="Search item code or name..." />

                <button type="submit" class="btn-icon-flat" title="Search">
                    <i class="bi bi-search"></i>
                </button>

                <a asp-controller="Products" asp-action="Index" class="btn-icon-flat" title="Clear">
                    <i class="bi bi-x-lg"></i>
                </a>
            </form>
        </div>

        @if (products.Any())
        {
            <div class="table-responsive">
                <table class="pm-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Item Code</th>
                            <th>Item Name</th>
                            <th style="text-align:right;">Retail Price</th>
                            <th style="text-align:right;">Outlet Price</th>
                            <th>Currency</th>
                            <th>Status</th>
                            @if (canManageProducts)
                            {
                                <th style="text-align:right;">Actions</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @for (int i = 0; i < products.Count; i++)
                        {
                            var product = products[i];

                            <tr>
                                <td class="pm-idx">@(i + 1)</td>

                                <td>
                                    <span class="pm-code">@product.ItemCode</span>
                                </td>

                                <td class="pm-name">@product.ItemName</td>

                                <td class="pm-price">
                                    @(product.RetailSellingPrice?.ToString("N2") ?? "-")
                                </td>

                                <td class="pm-price">
                                    @(product.OutletSellingPrice?.ToString("N2") ?? "-")
                                </td>

                                <td>
                                    <span class="pm-currency">
                                        @(product.Currency ?? "-")
                                    </span>
                                </td>

                                <td>
                                    @if (product.IsActive)
                                    {
                                        <span class="pm-status is-active">
                                            <span class="pm-dot dot-accent"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="pm-status is-inactive">
                                            <span class="pm-dot dot-warn"></span>
                                            Inactive
                                        </span>
                                    }
                                </td>

                                @if (canManageProducts)
                                {
                                    <td>
                                        <div class="pm-row-actions">
                                            <a asp-controller="Products"
                                               asp-action="Edit"
                                               asp-route-id="@product.Id"
                                               class="pm-btn-mini"
                                               title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <form asp-controller="Products"
                                                  asp-action="Delete"
                                                  method="post"
                                                  class="m-0"
                                                  onsubmit="return confirm('Are you sure you want to delete this product?');">

                                                <input type="hidden" name="id" value="@product.Id" />

                                                <button type="submit" class="pm-btn-mini danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="pm-empty">
                <div class="pm-empty-tag">
                    <i class="bi bi-inbox"></i>
                </div>

                <h5>No products found</h5>

                @if (!string.IsNullOrWhiteSpace(Convert.ToString(ViewBag.SearchTerm)))
                {
                    <p class="text-muted mb-3">No products match your search term.</p>

                    <a asp-controller="Products" asp-action="Index" class="btn-flat">
                        <i class="bi bi-x-circle"></i>
                        Clear Search
                    </a>
                }
                else
                {
                    <p class="text-muted mb-3">
                        Products will appear here after they are created or imported.
                    </p>

                    @if (canManageProducts)
                    {
                        <a asp-controller="Products" asp-action="Import" class="btn-flat btn-flat-solid">
                            <i class="bi bi-file-earmark-excel"></i>
                            Import Products
                        </a>
                    }
                }
            </div>
        }

    </div>

</div> *@
@model List<MasterDataAutomation.Application.Modules.ProductMaster.Dtos.ProductDto>

@{
    ViewData["Title"] = "Products";

    var products = Model ?? new List<MasterDataAutomation.Application.Modules.ProductMaster.Dtos.ProductDto>();

    var totalProducts = products.Count;
    var activeCount = products.Count(x => x.IsActive);
    var inactiveCount = totalProducts - activeCount;

    var canManageProducts = User.IsInRole("Admin") || User.IsInRole("ExecutiveManager");
    var canCreateRequest = User.IsInRole("Admin") || User.IsInRole("AccountsUser");

    var searchTerm = Convert.ToString(ViewBag.SearchTerm);
}

<style>
    .products-page {
        font-family: "Segoe UI", system-ui, sans-serif;
        color: #17212b;
    }

    .products-hero {
        background: linear-gradient(135deg, #111827, #0f766e);
        border-radius: 22px;
        padding: 26px;
        color: #fff;
        margin-bottom: 22px;
        position: relative;
        overflow: hidden;
    }

        .products-hero::after {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            right: -90px;
            top: -100px;
        }

    .hero-inner {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
    }

    .hero-label {
        font-size: 12px;
        letter-spacing: .14em;
        text-transform: uppercase;
        opacity: .85;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .hero-title {
        font-size: 34px;
        font-weight: 900;
        margin: 0;
    }

    .hero-subtitle {
        margin: 8px 0 0;
        opacity: .88;
        font-size: 15px;
    }

    .hero-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .hero-btn {
        border: 0;
        border-radius: 12px;
        padding: 11px 16px;
        text-decoration: none;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .hero-btn.light {
            background: #fff;
            color: #0f766e;
        }

        .hero-btn.outline {
            background: rgba(255,255,255,.12);
            color: #fff;
            border: 1px solid rgba(255,255,255,.35);
        }

        .hero-btn.success {
            background: #16a34a;
            color: #fff;
        }

        .hero-btn:hover {
            transform: translateY(-1px);
            color: inherit;
        }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .summary-card {
        background: #fff;
        border: 1px solid #e5e9ef;
        border-radius: 18px;
        padding: 20px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .05);
    }

    .summary-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .summary-label {
        color: #64748b;
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

    .summary-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }

    .icon-total {
        background: #eef2ff;
        color: #4f46e5;
    }

    .icon-active {
        background: #ecfdf5;
        color: #059669;
    }

    .icon-inactive {
        background: #fef2f2;
        color: #dc2626;
    }

    .summary-number {
        font-size: 34px;
        font-weight: 900;
        margin: 0;
        line-height: 1;
    }

    .summary-text {
        color: #64748b;
        font-size: 13px;
        margin: 8px 0 0;
    }

    .toolbar-card {
        background: #fff;
        border: 1px solid #e5e9ef;
        border-radius: 18px;
        padding: 16px;
        margin-bottom: 18px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .05);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
    }

    .search-form {
        display: flex;
        gap: 8px;
        flex: 1;
        min-width: 280px;
        max-width: 580px;
    }

    .search-input {
        border: 1px solid #dbe3ea;
        border-radius: 12px;
        padding: 11px 14px;
        flex: 1;
        outline: none;
        font-size: 14px;
    }

        .search-input:focus {
            border-color: #0f766e;
            box-shadow: 0 0 0 3px rgba(15,118,110,.10);
        }

    .tool-btn {
        border-radius: 12px;
        padding: 10px 14px;
        border: 1px solid #dbe3ea;
        background: #fff;
        color: #17212b;
        text-decoration: none;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

        .tool-btn:hover {
            background: #f8fafc;
            color: #17212b;
        }

        .tool-btn.primary {
            background: #0f766e;
            border-color: #0f766e;
            color: #fff;
        }

            .tool-btn.primary:hover {
                background: #134e4a;
                color: #fff;
            }

    .products-panel {
        background: #fff;
        border: 1px solid #e5e9ef;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .05);
    }

    .panel-header {
        padding: 16px 18px;
        border-bottom: 1px solid #e5e9ef;
        background: #fbfcfe;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .panel-title {
        font-weight: 900;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .panel-subtitle {
        color: #64748b;
        font-size: 13px;
        margin-top: 4px;
    }

    .clean-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

        .clean-table th {
            background: #f8fafc;
            color: #64748b;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .05em;
            padding: 12px 14px;
            border-bottom: 1px solid #e5e9ef;
            white-space: nowrap;
        }

        .clean-table td {
            padding: 14px;
            border-bottom: 1px solid #eef2f7;
            vertical-align: middle;
            font-size: 14px;
        }

        .clean-table tr:last-child td {
            border-bottom: none;
        }

        .clean-table tbody tr:hover {
            background: #f8fafc;
        }

    .row-index {
        color: #94a3b8;
        font-weight: 700;
    }

    .item-code {
        font-family: Consolas, monospace;
        font-weight: 900;
        color: #0f766e;
        background: #ecfdf5;
        border-radius: 8px;
        padding: 5px 8px;
        display: inline-block;
    }

    .item-name {
        font-weight: 900;
        color: #17212b;
    }

    .product-name-header {
        text-align: center !important;
        min-width: 280px;
    }

    .product-name-cell {
        text-align: center;
        min-width: 280px;
    }

    .product-name-text {
        display: inline-block;
        min-width: 180px;
        max-width: 360px;
        text-align: center;
        font-weight: 900;
        color: #17212b;
        line-height: 1.6;
        font-size: 14px;
        font-family: "Segoe UI", Tahoma, Arial, sans-serif;
    }

    .price {
        font-family: Consolas, monospace;
        font-weight: 900;
        text-align: right;
    }

    .currency-chip {
        font-family: Consolas, monospace;
        background: #f1f5f9;
        color: #475569;
        border-radius: 8px;
        padding: 4px 8px;
        font-size: 12px;
        font-weight: 900;
    }

    .status-chip {
        border-radius: 999px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .status-chip::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
        }

    .status-active {
        background: #ecfdf5;
        color: #059669;
    }

        .status-active::before {
            background: #059669;
        }

    .status-inactive {
        background: #fef2f2;
        color: #dc2626;
    }

        .status-inactive::before {
            background: #dc2626;
        }

    .action-group {
        display: flex;
        justify-content: flex-end;
        gap: 7px;
    }

    .action-btn {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        border: 1px solid #dbe3ea;
        background: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #475569;
        text-decoration: none;
    }

        .action-btn:hover {
            background: #f1f5f9;
            color: #0f766e;
        }

        .action-btn.danger:hover {
            background: #fef2f2;
            color: #dc2626;
            border-color: #fecaca;
        }

    .empty-state {
        text-align: center;
        padding: 54px 20px;
    }

    .empty-icon {
        width: 66px;
        height: 66px;
        border-radius: 18px;
        background: #f1f5f9;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        margin: 0 auto 14px;
    }

    .empty-state h5 {
        font-weight: 900;
        margin-bottom: 6px;
    }

    .empty-state p {
        color: #64748b;
        margin-bottom: 16px;
    }

    @@media (max-width: 1000px) {
        .summary-grid {
            grid-template-columns: 1fr;
        }

        .hero-title {
            font-size: 28px;
        }

        .search-form {
            max-width: 100%;
        }
    }
</style>

<div class="products-page">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm">
            <i class="bi bi-check-circle"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm">
            <i class="bi bi-exclamation-triangle"></i>
            @TempData["Error"]
        </div>
    }

    <div class="products-hero">
        <div class="hero-inner">
            <div>
                <div class="hero-label">Company Product Catalog</div>
                <h1 class="hero-title">Products Master</h1>
                <p class="hero-subtitle">
                    View product codes, Arabic names, retail prices, outlet prices and active status.
                </p>
            </div>

            <div class="hero-actions">
                <a asp-controller="Products"
                   asp-action="Export"
                   asp-route-searchTerm="@searchTerm"
                   class="hero-btn success">
                    <i class="bi bi-file-earmark-excel"></i>
                    Export Excel
                </a>

                @if (canCreateRequest)
                {
                    <a asp-controller="ProductRequests"
                       asp-action="Create"
                       class="hero-btn outline">
                        <i class="bi bi-file-earmark-plus"></i>
                        New Request
                    </a>
                }

                @if (canManageProducts)
                {
                    <a asp-controller="Products"
                       asp-action="Import"
                       class="hero-btn outline">
                        <i class="bi bi-upload"></i>
                        Import
                    </a>

                    <a asp-controller="Products"
                       asp-action="Create"
                       class="hero-btn light">
                        <i class="bi bi-plus-circle"></i>
                        Add Product
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="summary-grid">
        <div class="summary-card">
            <div class="summary-head">
                <div class="summary-label">Total Products</div>
                <div class="summary-icon icon-total">
                    <i class="bi bi-boxes"></i>
                </div>
            </div>
            <h2 class="summary-number">@totalProducts</h2>
            <p class="summary-text">Products loaded in master catalog.</p>
        </div>

        <div class="summary-card">
            <div class="summary-head">
                <div class="summary-label">Active</div>
                <div class="summary-icon icon-active">
                    <i class="bi bi-check-circle"></i>
                </div>
            </div>
            <h2 class="summary-number">@activeCount</h2>
            <p class="summary-text">Available products for operations.</p>
        </div>

        <div class="summary-card">
            <div class="summary-head">
                <div class="summary-label">Inactive</div>
                <div class="summary-icon icon-inactive">
                    <i class="bi bi-x-circle"></i>
                </div>
            </div>
            <h2 class="summary-number">@inactiveCount</h2>
            <p class="summary-text">Stopped or disabled products.</p>
        </div>
    </div>

    <div class="toolbar-card">
        <form asp-controller="Products"
              asp-action="Index"
              method="get"
              class="search-form">

            <input type="text"
                   name="searchTerm"
                   value="@searchTerm"
                   class="search-input"
                   placeholder="Search by item code or product name..." />

            <button type="submit" class="tool-btn primary">
                <i class="bi bi-search"></i>
                Search
            </button>

            <a asp-controller="Products"
               asp-action="Index"
               class="tool-btn">
                <i class="bi bi-x-lg"></i>
                Clear
            </a>
        </form>

        <a asp-controller="Products"
           asp-action="Export"
           asp-route-searchTerm="@searchTerm"
           class="tool-btn">
            <i class="bi bi-download"></i>
            Export Current View
        </a>
    </div>

    <div class="products-panel">

        <div class="panel-header">
            <div>
                <h4 class="panel-title">
                    <i class="bi bi-table text-success"></i>
                    Product Records
                </h4>
                <div class="panel-subtitle">
                    Showing @products.Count product(s)
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <span> matching "@searchTerm"</span>
                    }
                </div>
            </div>
        </div>

        @if (products.Any())
        {
            <div class="table-responsive">
                <table class="clean-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Item Code</th>
                            <th class="product-name-header">Product Name</th>
                            <th style="text-align:right;">Retail Price</th>
                            <th style="text-align:right;">Outlet Price</th>
                            <th>Currency</th>
                            <th>Status</th>
                            @if (canManageProducts)
                            {
                                <th style="text-align:right;">Actions</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @for (int i = 0; i < products.Count; i++)
                        {
                            var item = products[i];

                            <tr>
                                <td class="row-index">@(i + 1)</td>

                                <td>
                                    <span class="item-code">@item.ItemCode</span>
                                </td>

                                <td class="product-name-cell">
                                    <div class="product-name-text" dir="auto">
                                        @item.ItemName
                                    </div>
                                </td>

                                <td class="price">
                                    @(item.RetailSellingPrice?.ToString("N2") ?? "-")
                                </td>

                                <td class="price">
                                    @(item.OutletSellingPrice?.ToString("N2") ?? "-")
                                </td>

                                <td>
                                    <span class="currency-chip">@(item.Currency ?? "EGP")</span>
                                </td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="status-chip status-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="status-chip status-inactive">Inactive</span>
                                    }
                                </td>

                                @if (canManageProducts)
                                {
                                    <td>
                                        <div class="action-group">
                                            <a asp-controller="Products"
                                               asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="action-btn"
                                               title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <form asp-controller="Products"
                                                  asp-action="Delete"
                                                  method="post"
                                                  class="m-0"
                                                  onsubmit="return confirm('Are you sure you want to delete this product?');">

                                                <input type="hidden" name="id" value="@item.Id" />

                                                <button type="submit"
                                                        class="action-btn danger"
                                                        title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="bi bi-inbox"></i>
                </div>

                <h5>No products found</h5>

                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    <p>No products match your search term.</p>

                    <a asp-controller="Products"
                       asp-action="Index"
                       class="tool-btn primary">
                        <i class="bi bi-x-circle"></i>
                        Clear Search
                    </a>
                }
                else
                {
                    <p>Products will appear here after importing or creating products.</p>

                    @if (canManageProducts)
                    {
                        <a asp-controller="Products"
                           asp-action="Import"
                           class="tool-btn primary">
                            <i class="bi bi-upload"></i>
                            Import Products
                        </a>
                    }
                }
            </div>
        }

    </div>

</div>