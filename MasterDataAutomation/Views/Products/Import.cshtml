@{
    ViewData["Title"] = "Import Products";

    var errors = ViewBag.Errors as List<string> ?? new List<string>();
    var successMessage = ViewBag.SuccessMessage as string;
}

<div class="container-fluid mt-4 mb-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="fw-bold mb-1" style="color:#2c3e50;">
                <i class="bi bi-file-earmark-excel"></i>
                Import Products
            </h1>

            <p class="text-muted mb-0">
                Upload Excel file to insert or update products master data.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Products"
               asp-action="DownloadImportTemplate"
               class="btn btn-outline-success">
                <i class="bi bi-download"></i>
                Download Template
            </a>

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success shadow-sm">
            <i class="bi bi-check-circle"></i>
            @successMessage
        </div>
    }

    @if (errors.Any())
    {
        <div class="alert alert-warning shadow-sm">
            <div class="fw-bold mb-2">
                <i class="bi bi-exclamation-triangle"></i>
                Some rows were not imported
            </div>

            <ul class="mb-0">
                @foreach (var error in errors.Take(20))
                {
                    <li>@error</li>
                }
            </ul>

            @if (errors.Count > 20)
            {
                <div class="mt-2">
                    And @(errors.Count - 20) more error(s)...
                </div>
            }
        </div>
    }

    <div class="card shadow-sm border-0" style="border-radius:0.9rem;">
        <div class="card-body p-4">

            <form asp-controller="Products"
                  asp-action="Import"
                  method="post"
                  enctype="multipart/form-data">

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Excel File
                    </label>

                    <input type="file"
                           name="file"
                           accept=".xlsx"
                           class="form-control" />

                    <small class="text-muted">
                        Required columns:
                        ItemCode, ItemName, RetailSellingPrice, OutletSellingPrice, Currency, IsActive
                    </small>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-upload"></i>
                    Import Products
                </button>

            </form>

        </div>
    </div>

    <div class="card shadow-sm border-0 mt-4" style="border-radius:0.9rem;">
        <div class="card-header bg-light fw-bold">
            Excel Format
        </div>

        <div class="table-responsive">
            <table class="table table-bordered mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ItemCode</th>
                        <th>ItemName</th>
                        <th>RetailSellingPrice</th>
                        <th>OutletSellingPrice</th>
                        <th>Currency</th>
                        <th>IsActive</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>P001</td>
                        <td>Vanilla Cup 100ml</td>
                        <td>15</td>
                        <td>12</td>
                        <td>EGP</td>
                        <td>TRUE</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>