@model List<MasterDataAutomation.Application.Modules.CustomerModification.Dtos.CustomerModificationRequestDto>
@using MasterDataAutomation.Application.Modules.CustomerModification.Enums

@{
    ViewData["Title"] = "طلبات تعديل العملاء المرفوضة";

    var requests = Model ?? new List<MasterDataAutomation.Application.Modules.CustomerModification.Dtos.CustomerModificationRequestDto>();
}

@functions {
    string CustomerTypeText(CustomerModificationCustomerType type)
    {
        return type switch
        {
            CustomerModificationCustomerType.Private => "خاص",
            CustomerModificationCustomerType.Fridge => "ثلاجة",
            _ => "-"
        };
    }

    string ModificationTypeText(CustomerModificationType type)
    {
        return type switch
        {
            CustomerModificationType.RemoveFridge => "رفع الثلاجة",
            CustomerModificationType.ChangeName => "تعديل اسم",
            CustomerModificationType.ChangeToPrivate => "تحويل إلى خاص",
            CustomerModificationType.ChangeToFridge => "تحويل إلى ثلاجة",
            _ => "-"
        };
    }   
}

<style>
    .rejected-page {
        direction: rtl;
        text-align: right;
        font-family: "Segoe UI", Tahoma, Arial, sans-serif;
        color: #16232c;
    }

    .rejected-header {
        background: linear-gradient(135deg, #7f1d1d, #dc2626);
        color: #fff;
        border-radius: 20px;
        padding: 28px;
        margin-bottom: 24px;
    }

    .rejected-title {
        font-size: 30px;
        font-weight: 900;
        margin: 0;
    }

    .rejected-subtitle {
        margin: 8px 0 0;
        opacity: .9;
        font-size: 14px;
    }

    .top-actions {
        margin-bottom: 18px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-main {
        background: #2f7d6b;
        border: 1px solid #2f7d6b;
        color: #fff;
        font-weight: 900;
        border-radius: 10px;
        padding: 10px 16px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-main:hover {
            background: #245f52;
            color: #fff;
        }

    .btn-back {
        border: 1px solid #16232c;
        color: #16232c;
        background: transparent;
        font-weight: 900;
        border-radius: 10px;
        padding: 10px 16px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-back:hover {
            background: #16232c;
            color: #fff;
        }

    .rejected-panel {
        background: #fff;
        border: 1px solid #e5e9ef;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .06);
    }

    .rejected-panel-head {
        padding: 18px 20px;
        background: #f8fafc;
        border-bottom: 1px solid #e5e9ef;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        font-weight: 900;
    }

    .rejected-count {
        background: #fee2e2;
        color: #991b1b;
        border-radius: 999px;
        padding: 6px 14px;
        font-size: 13px;
        font-weight: 900;
    }

    .rejected-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

        .rejected-table th {
            background: #f4f7f8;
            color: #64748b;
            padding: 12px 14px;
            font-size: 12px;
            border-bottom: 1px solid #e5e9ef;
            white-space: nowrap;
            text-align: right;
        }

        .rejected-table td {
            padding: 14px;
            border-bottom: 1px solid #e5e9ef;
            vertical-align: middle;
            font-size: 14px;
        }

    .customer-code {
        font-family: Consolas, monospace;
        font-weight: 900;
        background: #ecfdf5;
        color: #0f766e;
        padding: 5px 8px;
        border-radius: 8px;
        display: inline-block;
    }

    .customer-name {
        font-weight: 900;
    }

    .chip {
        border-radius: 999px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 900;
        background: #f1f5f9;
        color: #475569;
        display: inline-block;
        white-space: nowrap;
    }

    .reason-box {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
        border-radius: 10px;
        padding: 8px 10px;
        font-weight: 800;
        min-width: 180px;
    }

    .empty-box {
        text-align: center;
        padding: 55px 20px;
    }

        .empty-box h5 {
            font-weight: 900;
            margin-bottom: 8px;
        }

        .empty-box p {
            color: #64748b;
            margin: 0;
        }
</style>

<div class="rejected-page">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success fw-bold">
            <i class="bi bi-check-circle"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger fw-bold">
            <i class="bi bi-exclamation-triangle"></i>
            @TempData["Error"]
        </div>
    }
    <div class="rejected-header">
        <h1 class="rejected-title">طلبات تعديل العملاء المرفوضة</h1>
        <p class="rejected-subtitle">
            هنا تظهر الطلبات التي رفضها المدير مع سبب الرفض.
        </p>
    </div>

    <div class="top-actions">
        <a asp-controller="CustomerModificationRequests"
           asp-action="Create"
           class="btn-main">
            <i class="bi bi-plus-circle"></i>
            طلب تعديل جديد
        </a>

        <a asp-controller="CustomerModificationRequests"
           asp-action="Drafts"
           class="btn-back">
            <i class="bi bi-list-check"></i>
            المسودات
        </a>
    </div>

    <div class="rejected-panel">

        <div class="rejected-panel-head">
            <span>
                <i class="bi bi-x-octagon"></i>
                الطلبات المرفوضة
            </span>

            <span class="rejected-count">
                @requests.Count طلب
            </span>
        </div>

        @if (requests.Any())
        {
            <div class="table-responsive">
                <table class="rejected-table">
                    <thead>
                        <tr>
                            <th>الفرع</th>
                            <th>كود العميل</th>
                            <th>اسم العميل</th>
                            <th>نوع العميل الحالي</th>
                            <th>نوع التعديل</th>
                            <th>الاسم الجديد</th>
                            <th>سبب الرفض</th>
                            <th>تاريخ المراجعة</th>
                            <th>إجراء</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in requests)
                        {
                            <tr>
                                <td>@item.BranchName</td>

                                <td>
                                    <span class="customer-code">@item.MarketCode</span>
                                </td>

                                <td class="customer-name">@item.MarketName</td>

                                <td>
                                    <span class="chip">@CustomerTypeText(item.CurrentCustomerType)</span>
                                </td>

                                <td>
                                    <span class="chip">@ModificationTypeText(item.ModificationType)</span>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.NewMarketName) ? "-" : item.NewMarketName)
                                </td>

                                <td>
                                    <div class="reason-box">
                                        @(string.IsNullOrWhiteSpace(item.RejectionReason) ? "لم يتم إدخال سبب" : item.RejectionReason)
                                    </div>
                                </td>

                                <td>
                                    @(item.ReviewedAt.HasValue? item.ReviewedAt.Value.ToString("yyyy-MM-dd") : "-")
                                </td>
                                <td>
                                    <a asp-controller="CustomerModificationRequests"
                                       asp-action="EditRejected"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-warning fw-bold">
                                        <i class="bi bi-pencil-square"></i>
                                        تعديل وإرسال
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-box">
                <h5>لا توجد طلبات مرفوضة</h5>
                <p>أي طلب يرفضه المدير سيظهر هنا مع سبب الرفض.</p>
            </div>
        }

    </div>

</div>