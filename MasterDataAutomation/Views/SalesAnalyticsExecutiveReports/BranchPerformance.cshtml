@model List<MasterDataAutomation.Application.Modules.SalesAnalytics.DashboardDtos.BranchPerformanceAnalysisDto>

@{
    ViewData["Title"] = "تحليل أداء الفروع";

    var selectedDate =
        ViewBag.SelectedDate as string
        ?? DateTime.Today.ToString("yyyy-MM-dd");

    var selectedBranchCode =
        ViewBag.SelectedBranchCode as string
        ?? string.Empty;

    var branches =
        ViewBag.Branches as IEnumerable<dynamic>
        ?? Enumerable.Empty<dynamic>();

    var operationalBranches =
        Model
            .Where(x =>
                x.PerformanceStatus != "لا توجد بيانات تشغيلية")
            .ToList();

    var noDataBranches =
        Model
            .Where(x =>
                x.PerformanceStatus == "لا توجد بيانات تشغيلية")
            .OrderBy(x => x.BranchName)
            .ToList();

    var attentionBranches =
        operationalBranches
            .Where(x =>
                x.PerformanceStatus == "متأخر" ||
                x.PerformanceStatus == "متأخر بشكل ملحوظ")
            .OrderBy(x => x.PaceGapPercentage)
            .Take(5)
            .ToList();

    var totalTarget =
        operationalBranches.Sum(x => x.MonthlyTarget);

    var totalActualSales =
        operationalBranches.Sum(x => x.ActualSales);

    var totalVisits =
        operationalBranches.Sum(x => x.ActualVisits);

    var totalPositiveVisits =
        operationalBranches.Sum(x => x.PositiveVisits);

    var overallAchievement =
        totalTarget <= 0
            ? 0
            : Math.Round(
                totalActualSales /
                totalTarget *
                100,
                2);

    var overallPositiveVisitRate =
        totalVisits <= 0
            ? 0
            : Math.Round(
                (decimal)totalPositiveVisits /
                totalVisits *
                100,
                2);

    var expectedAchievement =
        operationalBranches
            .FirstOrDefault()
            ?.ExpectedAchievementPercentage
        ?? 0;

    var bestBranch =
        operationalBranches
            .OrderByDescending(x => x.PaceGapPercentage)
            .ThenByDescending(x => x.AchievementPercentage)
            .FirstOrDefault();

    string StatusClass(string status)
    {
        return status switch
        {
            "محقق التارجت" => "status-achieved",
            "متقدم عن المعدل" => "status-ahead",
            "يسير حسب المعدل" => "status-ontrack",
            "متأخر" => "status-late",
            "متأخر بشكل ملحوظ" => "status-critical",
            "لا توجد بيانات تشغيلية" => "status-nodata",
            _ => "status-neutral"
        };
    }

    string PaceClass(decimal value)
    {
        if (value >= 5)
            return "pace-good";

        if (value >= -5)
            return "pace-neutral";

        return "pace-bad";
    }
}

<style>
    .branch-page {
        direction: rtl;
        max-width: 1600px;
        margin: 0 auto;
    }

    /* =========================================================
           Hero
        ========================================================= */

    .executive-hero {
        background: linear-gradient(135deg, #0f172a 0%, #172554 55%, #1e3a8a 100%);
        color: #fff;
        border-radius: 22px;
        padding: 26px;
        margin-bottom: 20px;
        box-shadow: 0 16px 38px rgba(15, 23, 42, .18);
    }

    .hero-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
    }

    .hero-title {
        font-size: 28px;
        font-weight: 950;
        margin-bottom: 7px;
    }

    .hero-subtitle {
        color: rgba(255, 255, 255, .78);
        font-size: 13px;
        font-weight: 600;
        line-height: 1.8;
        max-width: 780px;
    }

    .hero-meta {
        margin-top: 12px;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .hero-pill {
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.16);
        color: #fff;
        border-radius: 999px;
        padding: 6px 11px;
        font-size: 12px;
        font-weight: 800;
    }

    /* =========================================================
           Filter
        ========================================================= */

    .filter-panel {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 20px;
        box-shadow: 0 8px 22px rgba(15, 23, 42, .04);
    }

    /* =========================================================
           KPIs
        ========================================================= */

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 22px;
    }

    .kpi-card {
        background: #fff;
        border: 1px solid #edf0f5;
        border-radius: 17px;
        padding: 19px;
        box-shadow: 0 9px 24px rgba(15, 23, 42, .05);
    }

    .kpi-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 9px;
    }

    .kpi-label {
        color: #64748b;
        font-size: 13px;
        font-weight: 800;
    }

    .kpi-icon {
        width: 38px;
        height: 38px;
        border-radius: 11px;
        background: #f1f5f9;
        color: #334155;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .kpi-value {
        font-size: 24px;
        font-weight: 950;
        color: #0f172a;
        line-height: 1.2;
    }

    .kpi-hint {
        color: #94a3b8;
        font-size: 11px;
        margin-top: 6px;
        font-weight: 700;
    }

    /* =========================================================
           Section
        ========================================================= */

    .section {
        margin-bottom: 22px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
        flex-wrap: wrap;
    }

    .section-title {
        font-size: 18px;
        font-weight: 950;
        color: #0f172a;
        margin: 0;
    }

    .section-subtitle {
        color: #94a3b8;
        font-size: 12px;
        font-weight: 700;
    }

    /* =========================================================
           Branch Cards
        ========================================================= */

    .branch-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    .branch-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 17px;
        padding: 18px;
        box-shadow: 0 9px 24px rgba(15, 23, 42, .05);
    }

    .branch-card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 14px;
    }

    .branch-name {
        font-size: 16px;
        font-weight: 950;
        color: #0f172a;
    }

    .branch-code {
        font-size: 11px;
        color: #94a3b8;
        font-weight: 800;
        margin-top: 2px;
    }

    .rank-circle {
        min-width: 34px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #f1f5f9;
        color: #334155;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: 950;
    }

    .branch-main-value {
        font-size: 23px;
        font-weight: 950;
        color: #0f172a;
    }

    .branch-main-label {
        color: #64748b;
        font-size: 11px;
        font-weight: 800;
    }

    .branch-metrics {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 9px;
        margin-top: 14px;
    }

    .mini-metric {
        background: #f8fafc;
        border-radius: 11px;
        padding: 10px;
    }

    .mini-label {
        color: #94a3b8;
        font-size: 10px;
        font-weight: 800;
    }

    .mini-value {
        color: #0f172a;
        font-size: 13px;
        font-weight: 950;
        margin-top: 3px;
    }

    .progress-shell {
        width: 100%;
        height: 8px;
        background: #e2e8f0;
        border-radius: 999px;
        overflow: hidden;
        margin-top: 12px;
    }

    .progress-bar-custom {
        height: 100%;
        background: #2563eb;
        border-radius: 999px;
    }

    /* =========================================================
           Status
        ========================================================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 5px 9px;
        font-size: 11px;
        font-weight: 950;
    }

    .status-achieved {
        background: #dcfce7;
        color: #15803d;
    }

    .status-ahead {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .status-ontrack {
        background: #ecfccb;
        color: #3f6212;
    }

    .status-late {
        background: #fef3c7;
        color: #a16207;
    }

    .status-critical {
        background: #fee2e2;
        color: #b91c1c;
    }

    .status-nodata {
        background: #e2e8f0;
        color: #475569;
    }

    .status-neutral {
        background: #f1f5f9;
        color: #64748b;
    }

    .pace-good {
        color: #15803d;
    }

    .pace-neutral {
        color: #a16207;
    }

    .pace-bad {
        color: #dc2626;
    }

    /* =========================================================
           Attention
        ========================================================= */

    .attention-panel {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 17px;
        padding: 18px;
        box-shadow: 0 9px 24px rgba(15, 23, 42, .05);
    }

    .attention-item {
        display: grid;
        grid-template-columns: minmax(180px, 1.6fr) 1fr 1fr auto;
        gap: 12px;
        align-items: center;
        padding: 13px 0;
        border-bottom: 1px solid #eef2f7;
    }

        .attention-item:last-child {
            border-bottom: none;
        }

    /* =========================================================
           No Data
        ========================================================= */

    .nodata-panel {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 17px;
        padding: 18px;
    }

    .nodata-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
    }

    .nodata-item {
        padding: 13px;
        border-radius: 12px;
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
    }

    .nodata-name {
        font-size: 14px;
        font-weight: 900;
        color: #334155;
    }

    .nodata-code {
        font-size: 11px;
        color: #94a3b8;
        font-weight: 700;
        margin-top: 2px;
    }

    .nodata-target {
        margin-top: 7px;
        color: #64748b;
        font-size: 11px;
        font-weight: 800;
    }

    /* =========================================================
           Table
        ========================================================= */

    .table-panel {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 17px;
        overflow: hidden;
        box-shadow: 0 9px 24px rgba(15, 23, 42, .05);
    }

    .table-head {
        padding: 17px 19px;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .report-table {
        margin-bottom: 0;
    }

        .report-table thead th {
            background: #f8fafc;
            color: #475569;
            font-size: 11px;
            font-weight: 900;
            white-space: nowrap;
        }

        .report-table tbody td {
            vertical-align: middle;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

    .table-branch {
        font-weight: 900;
        color: #0f172a;
    }

    .table-code {
        color: #94a3b8;
        font-size: 10px;
        font-weight: 700;
    }

    @@media (max-width: 1200px) {
        .branch-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .kpi-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .branch-grid,
        .kpi-grid,
        .nodata-grid {
            grid-template-columns: 1fr;
        }

        .attention-item {
            grid-template-columns: 1fr;
        }

        .hero-title {
            font-size: 22px;
        }
    }
</style>

<div class="branch-page">

    <!-- ===================================================== -->
    <!-- Hero -->
    <!-- ===================================================== -->

    <div class="executive-hero">

        <div class="hero-content">

            <div>

                <div class="hero-title">
                    <i class="bi bi-buildings ms-2"></i>
                    تحليل أداء الفروع
                </div>

                <div class="hero-subtitle">
                    مقارنة أداء الفروع مقابل التارجت الشهري والمعدل المتوقع حتى التاريخ المحدد،
                    مع فصل الفروع التي لم تُرفع لها بيانات تشغيلية عن الفروع ذات الأداء الفعلي.
                </div>

                <div class="hero-meta">

                    <span class="hero-pill">
                        حتى @selectedDate
                    </span>

                    <span class="hero-pill">
                        المعدل المتوقع @expectedAchievement.ToString("N1")%
                    </span>

                    <span class="hero-pill">
                        @operationalBranches.Count فرع ببيانات تشغيلية
                    </span>

                </div>

            </div>

            <a asp-controller="SalesAnalyticsDashboard"
               asp-action="Index"
               asp-route-reportDate="@selectedDate"
               asp-route-branchCode="@selectedBranchCode"
               class="btn btn-light fw-bold">

                <i class="bi bi-speedometer2 ms-1"></i>
                لوحة الإدارة التنفيذية
            </a>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- Filters -->
    <!-- ===================================================== -->

    <div class="filter-panel">

        <form asp-controller="SalesAnalyticsExecutiveReports"
              asp-action="BranchPerformance"
              method="get">

            <div class="row g-3 align-items-end">

                <div class="col-lg-3 col-md-6">

                    <label class="form-label fw-bold">
                        حتى تاريخ
                    </label>

                    <input type="date"
                           name="reportDate"
                           value="@selectedDate"
                           class="form-control" />

                </div>

                <div class="col-lg-4 col-md-6">

                    <label class="form-label fw-bold">
                        الفرع
                    </label>

                    <select name="branchCode"
                            class="form-select">

                        <option value="">
                            كل الفروع
                        </option>

                        @foreach (var branch in branches)
                        {
                            var code =
                            branch.BranchCode?.ToString()
                            ?? string.Empty;

                            var name =
                            branch.BranchName?.ToString()
                            ?? code;

                            if (code == selectedBranchCode)
                            {
                                <option value="@code" selected>
                                    @name
                                </option>
                            }
                            else
                            {
                                <option value="@code">
                                    @name
                                </option>
                            }
                        }

                    </select>

                </div>

                <div class="col-lg-5">

                    <div class="d-flex gap-2 flex-wrap">

                        <button type="submit"
                                class="btn btn-primary fw-bold">
                            <i class="bi bi-funnel ms-1"></i>
                            تطبيق
                        </button>

                        <a asp-controller="SalesAnalyticsExecutiveReports"
                           asp-action="BranchPerformance"
                           class="btn btn-outline-secondary">
                            إعادة ضبط
                        </a>

                        <a asp-controller="SalesAnalyticsExecutiveReports"
                           asp-action="ExportBranchPerformanceExcel"
                           asp-route-reportDate="@selectedDate"
                           asp-route-branchCode="@selectedBranchCode"
                           class="btn btn-success fw-bold">
                            <i class="bi bi-file-earmark-excel ms-1"></i>
                            Excel
                        </a>

                    </div>

                </div>

            </div>

        </form>

    </div>

    <!-- ===================================================== -->
    <!-- Main KPIs -->
    <!-- ===================================================== -->

    <div class="kpi-grid">

        <div class="kpi-card">

            <div class="kpi-top">
                <div class="kpi-label">
                    إجمالي المبيعات
                </div>

                <div class="kpi-icon">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>

            <div class="kpi-value">
                @totalActualSales.ToString("N0")
            </div>

            <div class="kpi-hint">
                جنيه من الفروع التي لديها بيانات تشغيلية
            </div>

        </div>

        <div class="kpi-card">

            <div class="kpi-top">
                <div class="kpi-label">
                    نسبة تحقيق التارجت
                </div>

                <div class="kpi-icon">
                    <i class="bi bi-bullseye"></i>
                </div>
            </div>

            <div class="kpi-value">
                @overallAchievement.ToString("N1")%
            </div>

            <div class="kpi-hint">
                المعدل المتوقع حتى اليوم @expectedAchievement.ToString("N1")%
            </div>

        </div>

        <div class="kpi-card">

            <div class="kpi-top">
                <div class="kpi-label">
                    إجمالي الزيارات
                </div>

                <div class="kpi-icon">
                    <i class="bi bi-geo-alt"></i>
                </div>
            </div>

            <div class="kpi-value">
                @totalVisits.ToString("N0")
            </div>

            <div class="kpi-hint">
                نسبة الزيارات الإيجابية @overallPositiveVisitRate.ToString("N1")%
            </div>

        </div>

        <div class="kpi-card">

            <div class="kpi-top">
                <div class="kpi-label">
                    الفروع المتأخرة
                </div>

                <div class="kpi-icon">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
            </div>

            <div class="kpi-value text-danger">
                @attentionBranches.Count
            </div>

            <div class="kpi-hint">
                من الفروع التي تم رفع بياناتها فقط
            </div>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- Executive Highlight -->
    <!-- ===================================================== -->
    @if (bestBranch != null)
    {
        <div class="section">

            <div class="section-header">
                <div>
                    <h3 class="section-title">
                        ملخص الأداء الحالي
                    </h3>

                    <div class="section-subtitle">
                        أفضل أداء فعلي مقارنة بالمعدل المتوقع للشهر.
                    </div>
                </div>
            </div>

            <div class="branch-card">

                <div class="branch-card-top">

                    <div>
                        <div class="branch-name">
                            @bestBranch.BranchName
                        </div>

                        <div class="branch-code">
                            @bestBranch.BranchCode
                        </div>
                    </div>

                    <span class="status-badge @StatusClass(bestBranch.PerformanceStatus)">
                        @bestBranch.PerformanceStatus
                    </span>

                </div>

                <div class="row g-3">

                    <div class="col-lg-3 col-md-6">
                        <div class="branch-main-label">
                            المبيعات الفعلية
                        </div>

                        <div class="branch-main-value">
                            @bestBranch.ActualSales.ToString("N0")
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <div class="branch-main-label">
                            تحقيق التارجت
                        </div>

                        <div class="branch-main-value">
                            @bestBranch.AchievementPercentage.ToString("N1")%
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <div class="branch-main-label">
                            فجوة الأداء
                        </div>

                        <div class="branch-main-value @PaceClass(bestBranch.PaceGapPercentage)">
                            @bestBranch.PaceGapPercentage.ToString("+0.0;-0.0;0.0")%
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <div class="branch-main-label">
                            الزيارات الإيجابية
                        </div>

                        <div class="branch-main-value">
                            @bestBranch.PositiveVisitPercentage.ToString("N1")%
                        </div>
                    </div>

                </div>

            </div>

        </div>
    }

    <!-- ===================================================== -->
    <!-- Branch Ranking Cards -->
    <!-- ===================================================== -->

    <div class="section">

        <div class="section-header">

            <div>
                <h3 class="section-title">
                    ترتيب الفروع
                </h3>

                <div class="section-subtitle">
                    الترتيب يعتمد على فجوة الأداء مقابل المعدل المتوقع وليس حجم المبيعات فقط.
                </div>
            </div>

        </div>

        @if (!operationalBranches.Any())
        {
            <div class="nodata-panel text-muted fw-bold">
                لا توجد بيانات تشغيلية متاحة للفروع وفقًا للفلاتر الحالية.
            </div>
        }
        else
        {
            <div class="branch-grid">

                @foreach (var branch in operationalBranches)
                {
                    var progress =
                    Math.Min(
                    Math.Max(branch.AchievementPercentage, 0),
                    100);

                    <div class="branch-card">

                        <div class="branch-card-top">

                            <div>

                                <div class="branch-name">
                                    @branch.BranchName
                                </div>

                                <div class="branch-code">
                                    @branch.BranchCode
                                </div>

                            </div>

                            <div class="rank-circle">
                                @branch.Rank
                            </div>

                        </div>

                        <div class="d-flex justify-content-between align-items-end gap-3">

                            <div>

                                <div class="branch-main-label">
                                    نسبة التحقيق
                                </div>

                                <div class="branch-main-value">
                                    @branch.AchievementPercentage.ToString("N1")%
                                </div>

                            </div>

                            <span class="status-badge @StatusClass(branch.PerformanceStatus)">
                                @branch.PerformanceStatus
                            </span>

                        </div>

                        <div class="progress-shell">
                            <div class="progress-bar-custom"
                                 style="width:@progress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                            </div>
                        </div>

                        <div class="branch-metrics">

                            <div class="mini-metric">
                                <div class="mini-label">
                                    المبيعات
                                </div>

                                <div class="mini-value">
                                    @branch.ActualSales.ToString("N0")
                                </div>
                            </div>

                            <div class="mini-metric">
                                <div class="mini-label">
                                    التارجت
                                </div>

                                <div class="mini-value">
                                    @branch.MonthlyTarget.ToString("N0")
                                </div>
                            </div>

                            <div class="mini-metric">
                                <div class="mini-label">
                                    فجوة الأداء
                                </div>

                                <div class="mini-value @PaceClass(branch.PaceGapPercentage)">
                                    @branch.PaceGapPercentage.ToString("+0.0;-0.0;0.0")%
                                </div>
                            </div>

                            <div class="mini-metric">
                                <div class="mini-label">
                                    الزيارات الإيجابية
                                </div>

                                <div class="mini-value">
                                    @branch.PositiveVisitPercentage.ToString("N1")%
                                </div>
                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

    <!-- ===================================================== -->
    <!-- Needs Attention -->
    <!-- ===================================================== -->
    @if (attentionBranches.Any())
    {
        <div class="section">

            <div class="section-header">

                <div>
                    <h3 class="section-title">
                        <i class="bi bi-exclamation-triangle text-danger ms-1"></i>
                        فروع تحتاج متابعة
                    </h3>

                    <div class="section-subtitle">
                        فروع لديها بيانات تشغيلية فعلية ولكنها أقل من المعدل المتوقع.
                    </div>
                </div>

            </div>

            <div class="attention-panel">

                @foreach (var branch in attentionBranches)
                {
                    <div class="attention-item">

                        <div>
                            <div class="fw-bold">
                                @branch.BranchName
                            </div>

                            <div class="small text-muted">
                                @branch.BranchCode
                            </div>
                        </div>

                        <div>
                            <div class="small text-muted">
                                فجوة الأداء
                            </div>

                            <div class="fw-bold pace-bad">
                                @branch.PaceGapPercentage.ToString("+0.0;-0.0;0.0")%
                            </div>
                        </div>

                        <div>
                            <div class="small text-muted">
                                المطلوب يوميًا
                            </div>

                            <div class="fw-bold">
                                @branch.RequiredDailySales.ToString("N0")
                                جنيه
                            </div>
                        </div>

                        <span class="status-badge @StatusClass(branch.PerformanceStatus)">
                            @branch.PerformanceStatus
                        </span>

                    </div>
                }

            </div>

        </div>
    }

    <!-- ===================================================== -->
    <!-- Branches Without Operational Data -->
    <!-- ===================================================== -->
    @if (noDataBranches.Any())
    {
        <div class="section">

            <div class="section-header">

                <div>
                    <h3 class="section-title">
                        <i class="bi bi-cloud-arrow-up ms-1"></i>
                        فروع لم تُرفع بياناتها التشغيلية
                    </h3>

                    <div class="section-subtitle">
                        هذه الفروع لديها تارجت مسجل، لكن لا توجد لها مبيعات أو زيارات فعلية حتى التاريخ المحدد؛
                        لذلك لا تدخل في تقييم الأداء.
                    </div>
                </div>

                <span class="badge text-bg-secondary">
                    @noDataBranches.Count فرع
                </span>

            </div>

            <div class="nodata-panel">

                <div class="nodata-grid">

                    @foreach (var branch in noDataBranches)
                    {
                        <div class="nodata-item">

                            <div class="nodata-name">
                                @branch.BranchName
                            </div>

                            <div class="nodata-code">
                                @branch.BranchCode
                            </div>

                            <div class="nodata-target">
                                التارجت:
                                @branch.MonthlyTarget.ToString("N0")
                                جنيه
                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>
    }

    <!-- ===================================================== -->
    <!-- Compact Table -->
    <!-- ===================================================== -->

    <div class="section">

        <div class="section-header">

            <div>
                <h3 class="section-title">
                    تفاصيل الأداء
                </h3>

                <div class="section-subtitle">
                    عرض مختصر للمؤشرات الأساسية للفروع التي لديها بيانات تشغيلية.
                </div>
            </div>

        </div>

        <div class="table-panel">

            <div class="table-head">

                <div class="fw-bold">
                    مقارنة الفروع
                </div>

                <div class="small text-muted">
                    @operationalBranches.Count فرع
                </div>

            </div>

            @if (!operationalBranches.Any())
            {
                <div class="p-4 text-center text-muted fw-bold">
                    لا توجد بيانات للعرض.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover report-table">

                        <thead>
                            <tr>
                                <th>#</th>
                                <th>الفرع</th>
                                <th>المبيعات</th>
                                <th>التحقيق</th>
                                <th>فجوة الأداء</th>
                                <th>الزيارات</th>
                                <th>إيجابية</th>
                                <th>المطلوب يوميًا</th>
                                <th>الحالة</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var branch in operationalBranches)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @branch.Rank
                                        </strong>
                                    </td>

                                    <td>
                                        <div class="table-branch">
                                            @branch.BranchName
                                        </div>

                                        <div class="table-code">
                                            @branch.BranchCode
                                        </div>
                                    </td>

                                    <td>
                                        @branch.ActualSales.ToString("N0")
                                    </td>

                                    <td class="fw-bold">
                                        @branch.AchievementPercentage.ToString("N1")%
                                    </td>

                                    <td class="@PaceClass(branch.PaceGapPercentage) fw-bold">
                                        @branch.PaceGapPercentage.ToString("+0.0;-0.0;0.0")%
                                    </td>

                                    <td>
                                        @branch.ActualVisits.ToString("N0")
                                    </td>

                                    <td>
                                        @branch.PositiveVisitPercentage.ToString("N1")%
                                    </td>

                                    <td>
                                        @branch.RequiredDailySales.ToString("N0")
                                    </td>

                                    <td>
                                        <span class="status-badge @StatusClass(branch.PerformanceStatus)">
                                            @branch.PerformanceStatus
                                        </span>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>