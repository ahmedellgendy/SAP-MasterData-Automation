@model List<MasterDataAutomation.Infrastructure.Data.Entities.AppUserEntity>

@{
    ViewData["Title"] = "Users Management";
}

<div class="container-fluid mt-4 mb-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1" style="color:#2c3e50;">
                <i class="bi bi-people"></i>
                Users Management
            </h1>

            <p class="text-muted mb-0">
                Manage sales, managers, accounts users, executive managers, and admins.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus"></i>
            Create User
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success shadow-sm">
            <i class="bi bi-check-circle"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm">
            <i class="bi bi-exclamation-triangle"></i>
            @TempData["Error"]
        </div>
    }

    <div class="card shadow border-0" style="border-radius:0.75rem; overflow:hidden;">

        <div class="card-header bg-light fw-bold py-3">
            <i class="bi bi-table"></i>
            Users
            <span class="badge bg-primary ms-2">@Model.Count</span>
        </div>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Full Name</th>
                            <th>Username</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Created At</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <tr>
                                <td class="fw-bold">@(i + 1)</td>

                                <td>@Model[i].FullName</td>

                                <td>
                                    <span class="fw-semibold">
                                        @Model[i].UserName
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-info text-dark">
                                        @Model[i].Role
                                    </span>
                                </td>

                                <td>
                                    @if (Model[i].IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>

                                <td>@Model[i].CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>

                                <td class="text-end">

                                    <form asp-controller="AdminUsers"
                                          asp-action="ToggleStatus"
                                          method="post"
                                          class="d-inline">
                                        <input type="hidden" name="id" value="@Model[i].Id" />

                                        <button type="submit"
                                                class="btn btn-sm @(Model[i].IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                            @if (Model[i].IsActive)
                                            {
                                                <span>
                                                    <i class="bi bi-x-circle"></i>
                                                    Deactivate
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                    <i class="bi bi-check-circle"></i>
                                                    Activate
                                                </span>
                                            }
                                        </button>
                                    </form>

                                    <form asp-controller="AdminUsers"
                                          asp-action="Delete"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this user?');">

                                        <input type="hidden" name="id" value="@Model[i].Id" />

                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash"></i>
                                            Delete
                                        </button>
                                    </form>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                <h5>No users yet</h5>
            </div>
        }

    </div>

</div>