@{
    ViewData["Title"] = "Visits Range Upload";

    var today =
        ViewBag.Today as string
        ?? DateTime.Today.ToString("yyyy-MM-dd");

    var monthStart =
        new DateTime(
            DateTime.Today.Year,
            DateTime.Today.Month,
            1)
        .ToString("yyyy-MM-dd");
}

<style>
    .upload-page {
        max-width: 950px;
        margin: 0 auto;
    }

    .upload-hero {
        background: linear-gradient(135deg, #0f172a, #334155);
        color: #fff;
        border-radius: 20px;
        padding: 26px;
        margin-bottom: 22px;
        box-shadow: 0 14px 32px rgba(15, 23, 42, .16);
    }

    .upload-title {
        font-size: 28px;
        font-weight: 950;
        margin-bottom: 8px;
    }

    .upload-subtitle {
        color: rgba(255,255,255,.78);
        font-size: 14px;
        font-weight: 600;
        line-height: 1.7;
    }

    .upload-card {
        background: #fff;
        border-radius: 18px;
        padding: 24px;
        border: 1px solid #edf0f5;
        box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
    }

    .form-label {
        font-weight: 900;
        color: #0f172a;
        margin-bottom: 8px;
    }

    .form-control {
        border-radius: 12px;
        padding: 12px;
        font-weight: 700;
    }

    .btn-main {
        background: #0f172a;
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 12px 18px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-main:hover {
            color: #fff;
            background: #334155;
        }

    .note-box {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1e3a8a;
        border-radius: 14px;
        padding: 14px 16px;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 18px;
        line-height: 1.7;
    }

    .warning-box {
        background: #fff7ed;
        border: 1px solid #fed7aa;
        color: #9a3412;
        border-radius: 14px;
        padding: 14px 16px;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 18px;
        line-height: 1.7;
    }

    .date-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .date-help {
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
        margin-top: 6px;
        line-height: 1.6;
    }

    .alert {
        border-radius: 14px;
        font-weight: 800;
    }

    @@media (max-width: 700px) {
        .date-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="upload-page">

    <div class="upload-hero">

        <div class="upload-title">
            Visits Range Upload
        </div>

        <div class="upload-subtitle">
            Upload a SalesBuzz visits report for a specific date range within the same month.
            The selected period must match the report period exactly.
        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="note-box" accesskeydir="rtl" style="text-align:right;">

        <i class="bi bi-info-circle me-1"></i>

        استخدم هذه الصفحة لرفع تقرير زيارات يغطي فترة محددة داخل نفس الشهر.
        يمكن استخدام التقرير لاستكمال الأيام التي لم يتم رفعها من خلال Daily Visits.

    </div>

    <div class="warning-box" accesskeydir="rtl" style="text-align:right;">

        <i class="bi bi-exclamation-triangle me-1"></i>

        يجب أن يتطابق تاريخ البداية وتاريخ النهاية مع الفترة الفعلية
        التي تم استخراج التقرير بها من SalesBuzz.

    </div>

    <div class="upload-card">

        <form asp-controller="SalesAnalyticsMasterData"
              asp-action="UploadMtdVisitsReport"
              method="post"
              enctype="multipart/form-data"
              id="visitsRangeUploadForm">

            @Html.AntiForgeryToken()

            <div class="date-grid">

                <div class="mb-3">

                    <label class="form-label">
                        Report From Date
                    </label>

                    <input type="date"
                           id="fromDate"
                           name="fromDate"
                           value="@monthStart"
                           class="form-control"
                           required />

                    <div class="date-help" accesskeydir="rtl" style="text-align:right;">
                        تاريخ بداية الفترة داخل التقرير.
                    </div>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Report To Date
                    </label>

                    <input type="date"
                           id="toDate"
                           name="toDate"
                           value="@today"
                           class="form-control"
                           required />

                    <div class="date-help" dir="rtl" style="text-align:right;">
                        تاريخ نهاية الفترة داخل التقرير.
                    </div>

                </div>

            </div>

            <div class="mb-4">

                <label class="form-label">
                    SalesBuzz Visits Report
                </label>

                <input type="file"
                       name="file"
                       class="form-control"
                       accept=".xls,.xlsx"
                       required />

            </div>

            <button type="submit"
                    class="btn-main">

                <i class="bi bi-cloud-upload"></i>

                Upload Visits Range

            </button>

        </form>

    </div>

</div>

@section Scripts {

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const form =
                    document.getElementById(
                        "visitsRangeUploadForm");

                const fromDate =
                    document.getElementById(
                        "fromDate");

                const toDate =
                    document.getElementById(
                        "toDate");

                if (!form || !fromDate || !toDate) {
                    return;
                }

                function validateRange() {

                    if (
                        !fromDate.value ||
                        !toDate.value) {

                        return true;
                    }

                    if (
                        fromDate.value >
                        toDate.value) {

                        alert(
                            "تاريخ البداية لا يمكن أن يكون بعد تاريخ النهاية.");

                        return false;
                    }

                    const from =
                        new Date(fromDate.value);

                    const to =
                        new Date(toDate.value);

                    if (
                        from.getFullYear() !==
                        to.getFullYear()
                        ||
                        from.getMonth() !==
                        to.getMonth()) {

                        alert(
                            "الفترة يجب أن تكون داخل نفس الشهر.");

                        return false;
                    }

                    return true;
                }

                form.addEventListener(
                    "submit",
                    function (event) {

                        if (!validateRange()) {
                            event.preventDefault();
                        }
                    });

                fromDate.addEventListener(
                    "change",
                    function () {

                        toDate.min =
                            fromDate.value;
                    });
            });
    </script>
}