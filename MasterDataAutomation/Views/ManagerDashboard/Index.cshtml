@model MasterDataAutomation.Web.ViewModels.ManagerDashboardViewModel

@{
    ViewData["Title"] = "Manager Dashboard";

    var pendingCustomersCount = Model?.SubmittedCount ?? 0;
    var approvedCustomersCount = Model?.ApprovedCount ?? 0;
    var rejectedCustomersCount = Model?.RejectedCount ?? 0;

    var pendingModificationsCount = ViewBag.PendingModificationsCount as int? ?? 0;
    var approvedModificationsCount = ViewBag.ApprovedModificationsCount as int? ?? 0;

    var totalActions =
        pendingCustomersCount +
        approvedCustomersCount +
        pendingModificationsCount +
        approvedModificationsCount;
}

<style>
    .manager-dashboard {
        font-family: "Segoe UI", system-ui, sans-serif;
        color: #16232c;
    }

    .manager-hero {
        background: linear-gradient(135deg, #16232c, #2f7d6b);
        color: #fff;
        border-radius: 22px;
        padding: 30px;
        margin-bottom: 24px;
        position: relative;
        overflow: hidden;
    }

        .manager-hero::after {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            right: -90px;
            top: -110px;
        }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    .hero-label {
        font-size: 12px;
        letter-spacing: .16em;
        text-transform: uppercase;
        opacity: .85;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .hero-title {
        font-size: 34px;
        font-weight: 900;
        margin: 0;
    }

    .hero-subtitle {
        margin: 10px 0 0;
        opacity: .9;
        font-size: 15px;
        max-width: 780px;
        line-height: 1.7;
    }

    .manager-alert {
        background: #fff7ed;
        border: 1px solid #fed7aa;
        color: #9a3412;
        border-radius: 16px;
        padding: 16px 18px;
        margin-bottom: 22px;
        display: flex;
        align-items: center;
        gap: 14px;
        box-shadow: 0 8px 22px rgba(15, 23, 42, .05);
    }

    .alert-icon {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        background: #ffedd5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .alert-title {
        font-weight: 900;
        font-size: 16px;
    }

    .alert-text {
        font-size: 14px;
        margin-top: 2px;
    }

    .quick-alert-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 24px;
    }

    .quick-alert-card {
        background: #fff;
        border: 1px solid #e5e9ef;
        border-radius: 16px;
        padding: 16px;
        box-shadow: 0 8px 22px rgba(15, 23, 42, .05);
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: #16232c;
        transition: .18s ease;
    }

        .quick-alert-card:hover {
            transform: translateY(-3px);
            border-color: #2f7d6b;
            color: #16232c;
        }

    .quick-icon {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        flex-shrink: 0;
    }

    .quick-number {
        font-size: 24px;
        font-weight: 900;
        line-height: 1;
    }

    .quick-label {
        color: #64748b;
        font-size: 13px;
        font-weight: 700;
        margin-top: 3px;
    }

    .section-title {
        font-size: 17px;
        font-weight: 900;
        margin: 26px 0 14px;
        color: #16232c;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
    }

    .modification-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        max-width: 760px;
    }

    .dashboard-card {
        background: #fff;
        border: 1px solid #e5e9ef;
        border-radius: 18px;
        padding: 22px;
        text-decoration: none;
        color: #16232c;
        box-shadow: 0 8px 22px rgba(15, 23, 42, .05);
        transition: .18s ease;
        min-height: 175px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
    }

        .dashboard-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 34px rgba(15, 23, 42, .10);
            color: #16232c;
            border-color: #2f7d6b;
        }

    .card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
    }

    .card-icon {
        width: 54px;
        height: 54px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
        margin-bottom: 16px;
    }

    .icon-warning {
        background: #fff7ed;
        color: #f59e0b;
    }

    .icon-success {
        background: #ecfdf5;
        color: #059669;
    }

    .icon-danger {
        background: #fef2f2;
        color: #dc2626;
    }

    .icon-primary {
        background: #eff6ff;
        color: #2563eb;
    }

    .icon-dark {
        background: #f1f5f9;
        color: #334155;
    }

    .action-badge {
        background: #dc2626;
        color: #fff;
        border-radius: 999px;
        min-width: 30px;
        height: 30px;
        padding: 0 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 900;
    }

        .action-badge.success {
            background: #059669;
        }

        .action-badge.neutral {
            background: #334155;
        }

    .card-title-text {
        font-size: 18px;
        font-weight: 900;
        margin-bottom: 6px;
    }

    .card-description {
        color: #64748b;
        font-size: 13px;
        line-height: 1.6;
        margin: 0;
    }

    .card-footer-line {
        margin-top: 18px;
        color: #2f7d6b;
        font-size: 13px;
        font-weight: 900;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .workflow-panel {
        margin-top: 28px;
        background: #fff;
        border: 1px solid #e5e9ef;
        border-radius: 18px;
        padding: 22px;
        box-shadow: 0 8px 22px rgba(15, 23, 42, .05);
    }

    .workflow-title {
        font-weight: 900;
        font-size: 18px;
        margin-bottom: 8px;
        color: #16232c;
    }

    .workflow-text {
        color: #64748b;
        margin: 0;
        line-height: 1.8;
        font-size: 14px;
    }

    @@media (max-width: 1200px) {
        .dashboard-grid,
        .quick-alert-grid,
        .modification-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            max-width: none;
        }
    }

    @@media (max-width: 768px) {
        .dashboard-grid,
        .quick-alert-grid,
        .modification-grid {
            grid-template-columns: 1fr;
        }

        .hero-title {
            font-size: 28px;
        }

        .manager-hero {
            padding: 24px;
        }
    }
</style>

<div class="container-fluid mt-4 mb-4 manager-dashboard">

    <div class="manager-hero">
        <div class="hero-content">
            <div class="hero-label">Operations Management</div>

            <h1 class="hero-title">
                <i class="bi bi-speedometer2"></i>
                Manager Dashboard
            </h1>

            <p class="hero-subtitle">
                Review customer creation requests, approve customer modifications, export approved changes,
                and follow SAP generation history.
            </p>
        </div>
    </div>

    @if (totalActions > 0)
    {
        <div class="manager-alert">
            <div class="alert-icon">
                <i class="bi bi-bell-fill"></i>
            </div>

            <div>
                <div class="alert-title">
                    Manager Actions Required
                </div>

                <div class="alert-text">
                    You have <strong>@totalActions</strong> item(s) waiting for action.
                </div>
            </div>
        </div>

        <div class="quick-alert-grid">

            @if (pendingCustomersCount > 0)
            {
                <a asp-controller="ManagerDashboard"
                   asp-action="SubmittedCustomers"
                   class="quick-alert-card">
                    <div class="quick-icon icon-warning">
                        <i class="bi bi-send-check"></i>
                    </div>
                    <div>
                        <div class="quick-number">@pendingCustomersCount</div>
                        <div class="quick-label">Pending customer approvals</div>
                    </div>
                </a>
            }

            @if (approvedCustomersCount > 0)
            {
                <a asp-controller="ManagerDashboard"
                   asp-action="ApprovedCustomers"
                   class="quick-alert-card">
                    <div class="quick-icon icon-success">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div>
                        <div class="quick-number">@approvedCustomersCount</div>
                        <div class="quick-label">Approved customers ready for SAP</div>
                    </div>
                </a>
            }

            @if (pendingModificationsCount > 0)
            {
                <a asp-controller="CustomerModificationManager"
                   asp-action="Index"
                   class="quick-alert-card">
                    <div class="quick-icon icon-dark">
                        <i class="bi bi-clipboard-check"></i>
                    </div>
                    <div>
                        <div class="quick-number">@pendingModificationsCount</div>
                        <div class="quick-label">Modification requests need review</div>
                    </div>
                </a>
            }

            @if (approvedModificationsCount > 0)
            {
                <a asp-controller="CustomerModificationManager"
                   asp-action="Approved"
                   class="quick-alert-card">
                    <div class="quick-icon icon-success">
                        <i class="bi bi-patch-check"></i>
                    </div>
                    <div>
                        <div class="quick-number">@approvedModificationsCount</div>
                        <div class="quick-label">Approved modifications ready to export</div>
                    </div>
                </a>
            }

        </div>
    }

    <div class="section-title">
        <i class="bi bi-person-plus"></i>
        Customer Creation Workflow
    </div>

    <div class="dashboard-grid">

        <a asp-controller="ManagerDashboard"
           asp-action="SubmittedCustomers"
           class="dashboard-card">

            <div>
                <div class="card-top">
                    <div class="card-icon icon-warning">
                        <i class="bi bi-send-check"></i>
                    </div>

                    @if (pendingCustomersCount > 0)
                    {
                        <span class="action-badge">@pendingCustomersCount</span>
                    }
                </div>

                <div class="card-title-text">
                    Pending Customers
                </div>

                <p class="card-description">
                    Review customer requests submitted by sales users.
                </p>
            </div>

            <div class="card-footer-line">
                <span>Open requests</span>
                <i class="bi bi-arrow-right"></i>
            </div>
        </a>

        <a asp-controller="ManagerDashboard"
           asp-action="ApprovedCustomers"
           class="dashboard-card">

            <div>
                <div class="card-top">
                    <div class="card-icon icon-success">
                        <i class="bi bi-check-circle"></i>
                    </div>

                    @if (approvedCustomersCount > 0)
                    {
                        <span class="action-badge success">@approvedCustomersCount</span>
                    }
                </div>

                <div class="card-title-text">
                    Approved Customers
                </div>

                <p class="card-description">
                    View approved customers and generate SAP files.
                </p>
            </div>

            <div class="card-footer-line">
                <span>View approved</span>
                <i class="bi bi-arrow-right"></i>
            </div>
        </a>

        <a asp-controller="ManagerDashboard"
           asp-action="RejectedCustomers"
           class="dashboard-card">

            <div>
                <div class="card-top">
                    <div class="card-icon icon-danger">
                        <i class="bi bi-x-circle"></i>
                    </div>

                    @if (rejectedCustomersCount > 0)
                    {
                        <span class="action-badge neutral">@rejectedCustomersCount</span>
                    }
                </div>

                <div class="card-title-text">
                    Rejected Customers
                </div>

                <p class="card-description">
                    View rejected customer requests and rejection reasons.
                </p>
            </div>

            <div class="card-footer-line">
                <span>View rejected</span>
                <i class="bi bi-arrow-right"></i>
            </div>
        </a>

        <a asp-controller="CustomerImport"
           asp-action="History"
           class="dashboard-card">

            <div>
                <div class="card-top">
                    <div class="card-icon icon-primary">
                        <i class="bi bi-clock-history"></i>
                    </div>

                    @if ((Model?.HistoryCount ?? 0) > 0)
                    {
                        <span class="action-badge neutral">@Model.HistoryCount</span>
                    }
                </div>

                <div class="card-title-text">
                    SAP History
                </div>

                <p class="card-description">
                    Track generated SAP files and previous exports.
                </p>
            </div>

            <div class="card-footer-line">
                <span>Open history</span>
                <i class="bi bi-arrow-right"></i>
            </div>
        </a>

    </div>

    <div class="section-title">
        <i class="bi bi-pencil-square"></i>
        Customer Modification Workflow
    </div>

    <div class="dashboard-grid modification-grid">

        <a asp-controller="CustomerModificationManager"
           asp-action="Index"
           class="dashboard-card">

            <div>
                <div class="card-top">
                    <div class="card-icon icon-dark">
                        <i class="bi bi-clipboard-check"></i>
                    </div>

                    @if (pendingModificationsCount > 0)
                    {
                        <span class="action-badge">@pendingModificationsCount</span>
                    }
                </div>

                <div class="card-title-text">
                    Modification Review
                </div>

                <p class="card-description">
                    Approve or reject customer modification requests submitted by sales.
                </p>
            </div>

            <div class="card-footer-line">
                <span>Review requests</span>
                <i class="bi bi-arrow-right"></i>
            </div>
        </a>

        <a asp-controller="CustomerModificationManager"
           asp-action="Approved"
           class="dashboard-card">

            <div>
                <div class="card-top">
                    <div class="card-icon icon-success">
                        <i class="bi bi-patch-check"></i>
                    </div>

                    @if (approvedModificationsCount > 0)
                    {
                        <span class="action-badge success">@approvedModificationsCount</span>
                    }
                </div>

                <div class="card-title-text">
                    Approved Modifications
                </div>

                <p class="card-description">
                    View approved modifications and export them from inside the page.
                </p>
            </div>

            <div class="card-footer-line">
                <span>View approved</span>
                <i class="bi bi-arrow-right"></i>
            </div>
        </a>

    </div>

    <div class="workflow-panel">
        <div class="workflow-title">
            Workflow Summary
        </div>

        <p class="workflow-text">
            Sales users can create new customers or submit modification requests.
            Managers review submitted requests, approve or reject them, and export approved data for further processing.
            Any card with a badge needs manager attention.
        </p>
    </div>

</div>