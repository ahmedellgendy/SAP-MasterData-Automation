@{
    ViewData["Title"] = "Sales Dashboard";
}

<style>
    .sales-dashboard {
        font-family: "Segoe UI", system-ui, sans-serif;
        color: #16232c;
    }

    .sales-hero {
        background: linear-gradient(135deg, #0f766e, #134e4a);
        border-radius: 22px;
        padding: 30px;
        color: #fff;
        margin-bottom: 24px;
        position: relative;
        overflow: hidden;
    }

        .sales-hero::after {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: rgba(255,255,255,.09);
            right: -80px;
            top: -90px;
        }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    .hero-label {
        font-size: 12px;
        letter-spacing: .14em;
        text-transform: uppercase;
        opacity: .85;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .hero-title {
        font-size: 34px;
        font-weight: 900;
        margin: 0;
    }

    .hero-subtitle {
        margin: 8px 0 0;
        opacity: .9;
        font-size: 15px;
    }

    .action-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
    }

    .action-card {
        background: #fff;
        border: 1px solid #e5e9ef;
        border-radius: 20px;
        padding: 28px;
        text-decoration: none;
        color: #16232c;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .05);
        transition: all .18s ease;
        min-height: 210px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

        .action-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 34px rgba(15, 23, 42, .10);
            color: #16232c;
            border-color: #0f766e;
        }

    .action-icon {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        margin-bottom: 18px;
    }

    .icon-create {
        background: #ecfdf5;
        color: #059669;
    }

    .icon-edit {
        background: #eff6ff;
        color: #2563eb;
    }

    .action-title {
        font-size: 22px;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .action-text {
        color: #64748b;
        font-size: 14px;
        margin: 0;
        line-height: 1.6;
    }

    .action-footer {
        margin-top: 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 800;
        color: #0f766e;
    }

    .action-card:hover .action-footer i {
        transform: translateX(-4px);
    }

    .action-footer i {
        transition: .18s ease;
    }

    @@media (max-width: 900px) {
        .action-grid {
            grid-template-columns: 1fr;
        }

        .hero-title {
            font-size: 28px;
        }
    }
</style>

<div class="sales-dashboard">

    <div class="sales-hero">
        <div class="hero-content">
            <div class="hero-label">Sales Operations</div>
            <h1 class="hero-title">Sales Dashboard</h1>
            <p class="hero-subtitle">
                اختار العملية المطلوبة: إضافة عميل جديد أو طلب تعديل بيانات عميل موجود.
            </p>
        </div>
    </div>

    <div class="action-grid">

        <a asp-controller="CustomerImport"
           asp-action="Create"
           class="action-card">

            <div>
                <div class="action-icon icon-create">
                    <i class="bi bi-person-plus"></i>
                </div>

                <div class="action-title">
                    إضافة عميل جديد
                </div>

                <p class="action-text">
                    إنشاء طلب إضافة عميل جديد وإرساله للمراجعة والاعتماد.
                </p>
            </div>

            <div class="action-footer">
                <span>ابدأ الإضافة</span>
                <i class="bi bi-arrow-left"></i>
            </div>
        </a>

        <a asp-controller="CustomerModificationRequests"
           asp-action="Create"
           class="action-card">

            <div>
                <div class="action-icon icon-edit">
                    <i class="bi bi-pencil-square"></i>
                </div>

                <div class="action-title">
                    تعديل عميل
                </div>

                <p class="action-text">
                    طلب تعديل بيانات عميل موجود مثل تعديل الاسم أو نوع العميل أو رفع الثلاجة.
                </p>
            </div>

            <div class="action-footer">
                <span>ابدأ التعديل</span>
                <i class="bi bi-arrow-left"></i>
            </div>
        </a>

    </div>

</div>