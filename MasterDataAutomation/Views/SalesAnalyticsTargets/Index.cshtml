@using MasterDataAutomation.Application.Modules.SalesAnalytics.Dtos
@model List<SalesDistrictMonthlyTargetDto>

@{
    ViewData["Title"] = "Sales District Targets";

    var year = ViewBag.Year as int? ?? DateTime.Today.Year;
    var month = ViewBag.Month as int? ?? DateTime.Today.Month;

    var salesDistricts = ViewBag.SalesDistricts as List<SalesDistrictOptionDto>
        ?? new List<SalesDistrictOptionDto>();

    string Money(decimal value) => $"{value:N0} EGP";
}

<style>
    .targets-page {
        max-width: 1300px;
        margin: 0 auto;
    }

    .page-hero {
        background: linear-gradient(135deg, #0b2a5b, #123a78);
        color: #fff;
        border-radius: 20px;
        padding: 24px;
        margin-bottom: 20px;
        box-shadow: 0 14px 32px rgba(15, 23, 42, .14);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
    }

    .page-title {
        font-size: 26px;
        font-weight: 950;
        margin-bottom: 6px;
    }

    .page-subtitle {
        color: rgba(255,255,255,.78);
        font-size: 14px;
        font-weight: 600;
    }

    .filter-card,
    .form-card,
    .table-card {
        background: #fff;
        border: 1px solid #edf0f5;
        border-radius: 18px;
        padding: 20px;
        margin-bottom: 18px;
        box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
    }

    .section-title {
        font-size: 18px;
        font-weight: 950;
        color: #0f172a;
        margin-bottom: 16px;
    }

    .form-label {
        font-weight: 850;
        color: #334155;
        font-size: 13px;
    }

    .form-control,
    .form-select {
        border-radius: 10px;
        border: 1px solid #dbe2ea;
        padding: 10px 12px;
        font-weight: 700;
    }

    .btn-main {
        background: #0b2a5b;
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 10px 16px;
        font-weight: 900;
    }

        .btn-main:hover {
            background: #123a78;
            color: #fff;
        }

    .btn-danger-soft {
        background: #fff;
        color: #dc2626;
        border: 1px solid #fecaca;
        border-radius: 10px;
        padding: 7px 10px;
        font-weight: 800;
    }

        .btn-danger-soft:hover {
            background: #fee2e2;
            color: #991b1b;
        }

    .alert {
        border-radius: 12px;
        font-weight: 800;
    }

    .table {
        margin-bottom: 0;
        vertical-align: middle;
    }

        .table thead th {
            background: #f8fafc;
            color: #475569;
            font-size: 12px;
            font-weight: 950;
            white-space: nowrap;
        }

        .table tbody td {
            font-size: 13px;
            color: #334155;
            font-weight: 750;
        }

    .line-name {
        color: #0f172a;
        font-weight: 950;
    }

    .muted-code {
        color: #94a3b8;
        font-size: 12px;
        font-weight: 800;
    }
</style>

<div class="targets-page">

    <div class="page-hero">
        <div>
            <div class="page-title">
                Sales District Monthly Targets
            </div>

            <div class="page-subtitle">
                Define monthly sales target and planned visits for each sales district.
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="filter-card">
        <form asp-controller="SalesAnalyticsTargets"
              asp-action="Index"
              method="get"
              class="row g-3 align-items-end">

            <div class="col-md-3">
                <label class="form-label">Year</label>
                <input type="number"
                       name="year"
                       class="form-control"
                       value="@year" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Month</label>
                <select name="month" class="form-select">
                    @for (var i = 1; i <= 12; i++)
                    {
                        <option value="@i" selected="@(i == month)">
                            @i
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <button type="submit" class="btn-main">
                    <i class="bi bi-funnel"></i>
                    Filter
                </button>
            </div>

        </form>
    </div>

    <div class="form-card">
        <div class="section-title">
            Add / Update Target
        </div>

        <form asp-controller="SalesAnalyticsTargets"
              asp-action="Save"
              method="post"
              class="row g-3 align-items-end">

            @Html.AntiForgeryToken()

            <input type="hidden" name="Year" value="@year" />
            <input type="hidden" name="Month" value="@month" />

            <div class="col-md-4">
                <label class="form-label">Sales District</label>
                <select name="SalesDistrictCode" class="form-select" required>
                    <option value="">-- Select Sales District --</option>

                    @foreach (var district in salesDistricts)
                    {
                        <option value="@district.SalesDistrictCode">
                            @district.SalesDistrictCode - @district.SalesDistrictName
                            @if (!string.IsNullOrWhiteSpace(district.BranchName))
                            {
                                @: / @district.BranchName
                            }
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Monthly Sales Target</label>
                <input type="number"
                       step="0.01"
                       min="0"
                       name="MonthlySalesTarget"
                       class="form-control"
                       placeholder="Example: 500000"
                       required />
            </div>

            <div class="col-md-3">
                <label class="form-label">Planned Visits</label>
                <input type="number"
                       min="0"
                       name="PlannedVisits"
                       class="form-control"
                       placeholder="Example: 300"
                       required />
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn-main w-100">
                    <i class="bi bi-save"></i>
                    Save
                </button>
            </div>

        </form>
    </div>

    <div class="table-card">
        <div class="section-title">
            Targets for @month / @year
        </div>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Branch</th>
                        <th>Sales District</th>
                        <th>Monthly Target</th>
                        <th>Planned Visits</th>
                        <th style="width:90px;">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-muted fw-bold">
                                No targets saved for this month.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="line-name">
                                        @(string.IsNullOrWhiteSpace(item.BranchName) ? "-" : item.BranchName)
                                    </div>
                                    <div class="muted-code">
                                        @item.BranchCode
                                    </div>
                                </td>

                                <td>
                                    <div class="line-name">
                                        @item.SalesDistrictName
                                    </div>
                                    <div class="muted-code">
                                        @item.SalesDistrictCode
                                    </div>
                                </td>

                                <td>
                                    @Money(item.MonthlySalesTarget)
                                </td>

                                <td>
                                    @item.PlannedVisits
                                </td>

                                <td>
                                    <form asp-controller="SalesAnalyticsTargets"
                                          asp-action="Delete"
                                          method="post"
                                          onsubmit="return confirm('Delete this target?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="year" value="@year" />
                                        <input type="hidden" name="month" value="@month" />

                                        <button type="submit" class="btn-danger-soft">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>
    </div>

</div>