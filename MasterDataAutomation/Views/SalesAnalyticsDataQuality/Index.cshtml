@model MasterDataAutomation.Application.Modules.SalesAnalytics.DataQualityDtos.SalesAnalyticsDataQualityReportDto
@using MasterDataAutomation.Application.Modules.SalesAnalytics.DashboardDtos

@{
    ViewData["Title"] = "Sales Analytics Data Quality";

    var branches = ViewBag.Branches as List<BranchOptionDto>
        ?? new List<BranchOptionDto>();

    var selectedBranchCode = ViewBag.SelectedBranchCode as string ?? string.Empty;

    string Money(decimal value) => $"{value:N0} EGP";
    string Number(decimal value) => $"{value:N0}";
}

<style>
    .quality-page {
        max-width: 1500px;
        margin: 0 auto;
    }

    .quality-hero {
        background: linear-gradient(135deg, #0f172a, #334155);
        color: #fff;
        border-radius: 20px;
        padding: 26px;
        margin-bottom: 22px;
        box-shadow: 0 14px 32px rgba(15, 23, 42, .16);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
    }

    .hero-title {
        font-size: 28px;
        font-weight: 950;
        margin-bottom: 6px;
    }

    .hero-subtitle {
        color: rgba(255,255,255,.78);
        font-size: 14px;
        font-weight: 600;
    }

    .date-filter {
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 14px;
        padding: 14px;
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }

        .date-filter input,
        .date-filter select {
            border: none;
            border-radius: 10px;
            padding: 10px 12px;
            font-weight: 800;
        }

    .btn-filter {
        background: #fff;
        color: #0f172a;
        border: none;
        border-radius: 10px;
        padding: 10px 14px;
        font-weight: 900;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .summary-card {
        background: #fff;
        border-radius: 18px;
        padding: 20px;
        border: 1px solid #edf0f5;
        box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
    }

    .summary-label {
        color: #64748b;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .summary-value {
        color: #0f172a;
        font-size: 26px;
        font-weight: 950;
    }

    .summary-hint {
        color: #94a3b8;
        font-size: 12px;
        font-weight: 700;
        margin-top: 6px;
    }

    .issues-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 22px;
    }

    .issue-card {
        background: #fff;
        border-radius: 16px;
        padding: 16px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .06);
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }

    .issue-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .issue-title {
        font-size: 14px;
        font-weight: 950;
        color: #0f172a;
        margin-bottom: 5px;
    }

    .issue-message {
        font-size: 12px;
        font-weight: 700;
        color: #64748b;
        line-height: 1.6;
    }

    .issue-count {
        margin-top: 8px;
        display: inline-flex;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 950;
        background: #f1f5f9;
        color: #334155;
    }

    .issue-critical {
        border-color: #fecaca;
        background: #fff5f5;
    }

        .issue-critical .issue-icon {
            background: #fee2e2;
            color: #991b1b;
        }

    .issue-warning {
        border-color: #fed7aa;
        background: #fff7ed;
    }

        .issue-warning .issue-icon {
            background: #ffedd5;
            color: #9a3412;
        }

    .issue-info {
        border-color: #bfdbfe;
        background: #eff6ff;
    }

        .issue-info .issue-icon {
            background: #dbeafe;
            color: #1e3a8a;
        }

    .section-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-bottom: 18px;
    }

    .panel {
        background: #fff;
        border-radius: 18px;
        padding: 20px;
        border: 1px solid #edf0f5;
        box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
    }

    .panel-title {
        font-size: 18px;
        font-weight: 950;
        color: #0f172a;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .table {
        margin-bottom: 0;
        vertical-align: middle;
    }

        .table thead th {
            color: #475569;
            font-size: 12px;
            font-weight: 900;
            background: #f8fafc;
            border-bottom: 1px solid #e5e7eb;
            white-space: nowrap;
        }

        .table tbody td {
            font-size: 13px;
            font-weight: 700;
            color: #334155;
        }

    .strong-name {
        font-weight: 900;
        color: #0f172a;
    }

    .muted-code {
        color: #94a3b8;
        font-size: 12px;
        font-weight: 800;
    }

    .empty-state {
        background: #ecfdf5;
        border: 1px solid #bbf7d0;
        color: #166534;
        padding: 18px;
        border-radius: 16px;
        font-weight: 900;
        margin-bottom: 18px;
    }

    @@media (max-width: 1100px) {
        .summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .issues-grid,
        .section-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 650px) {
        .summary-grid {
            grid-template-columns: 1fr;
        }

        .hero-title {
            font-size: 22px;
        }
    }
</style>

<div class="quality-page">

    <div class="quality-hero">
        <div>
            <div class="hero-title">
                Data Quality Report
            </div>
            <div class="hero-subtitle">
                Detect missing mappings between SalesBuzz reports, Customer Master, Sales Districts, Branches, and Targets.
            </div>
        </div>

        <form asp-controller="SalesAnalyticsDataQuality"
              asp-action="Index"
              method="get"
              class="date-filter">

            <input type="date"
                   name="reportDate"
                   value="@ViewBag.SelectedDate" />

            <select name="branchCode">
                <option value="">All Branches</option>

                @foreach (var branch in branches)
                {
                    if (selectedBranchCode == branch.BranchCode)
                    {
                        <option value="@branch.BranchCode" selected>
                            @branch.BranchName
                        </option>
                    }
                    else
                    {
                        <option value="@branch.BranchCode">
                            @branch.BranchName
                        </option>
                    }
                }
            </select>

            <button type="submit" class="btn-filter">
                <i class="bi bi-search"></i>
                Check
            </button>
        </form>
    </div>

    <div class="summary-grid">

        <div class="summary-card">
            <div class="summary-label">Sales Rows</div>
            <div class="summary-value">@Model.TotalSalesRows</div>
            <div class="summary-hint">Daily sales rows found</div>
        </div>

        <div class="summary-card">
            <div class="summary-label">Visit Rows</div>
            <div class="summary-value">@Model.TotalVisitRows</div>
            <div class="summary-hint">Daily visit rows found</div>
        </div>

        <div class="summary-card">
            <div class="summary-label">Unmapped Visit Customers</div>
            <div class="summary-value">@Model.UnmappedVisitCustomersCount</div>
            <div class="summary-hint">Visit customers not found in master</div>
        </div>

        <div class="summary-card">
            <div class="summary-label">Unmapped Sales Lines</div>
            <div class="summary-value">@Model.UnmappedSalesLinesCount</div>
            <div class="summary-hint">Sales lines not linked to districts</div>
        </div>

    </div>

    @if (!Model.Issues.Any())
    {
        <div class="empty-state">
            <i class="bi bi-check-circle"></i>
            No major data quality issues detected for the selected date and branch.
        </div>
    }
    else
    {
        <div class="issues-grid">
            @foreach (var issue in Model.Issues)
            {
                var issueClass = issue.Severity switch
                {
                    "Critical" => "issue-critical",
                    "Warning" => "issue-warning",
                    _ => "issue-info"
                };

                <div class="issue-card @issueClass">
                    <div class="issue-icon">
                        <i class="bi @issue.Icon"></i>
                    </div>

                    <div>
                        <div class="issue-title">@issue.Title</div>
                        <div class="issue-message">@issue.Message</div>
                        <div class="issue-count">Count: @issue.Count</div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="section-grid">

        <div class="panel">
            <div class="panel-title">
                <i class="bi bi-person-x"></i>
                Unmapped Visit Customers
            </div>

            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Sales Rep</th>
                            <th>Visits</th>
                            <th>Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.UnmappedVisitCustomers.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-muted fw-bold">
                                    No unmapped visit customers.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.UnmappedVisitCustomers)
                            {
                                <tr>
                                    <td>
                                        <div class="strong-name">@item.CustomerName</div>
                                        <div class="muted-code">@item.CustomerCode</div>
                                    </td>
                                    <td>
                                        <div>@item.SalesRepName</div>
                                        <div class="muted-code">@item.SalesRepCode</div>
                                    </td>
                                    <td>@item.VisitsCount</td>
                                    <td>@Money(item.VisitValue)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="panel">
            <div class="panel-title">
                <i class="bi bi-diagram-3"></i>
                Unmapped Sales Lines
            </div>

            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Line</th>
                            <th>Rows</th>
                            <th>Sales</th>
                            <th>Quantity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.UnmappedSalesLines.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-muted fw-bold">
                                    No unmapped sales lines.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.UnmappedSalesLines)
                            {
                                <tr>
                                    <td>
                                        <div class="strong-name">@item.LineName</div>
                                        <div class="muted-code">@item.LineCode</div>
                                    </td>
                                    <td>@item.RowsCount</td>
                                    <td>@Money(item.TotalSales)</td>
                                    <td>@Number(item.TotalQuantity)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <div class="section-grid">

        <div class="panel">
            <div class="panel-title">
                <i class="bi bi-people"></i>
                Customers Missing Sales District
            </div>

            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Branch</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.CustomersMissingSalesDistrict.Any())
                        {
                            <tr>
                                <td colspan="2" class="text-muted fw-bold">
                                    No customers missing sales district.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.CustomersMissingSalesDistrict)
                            {
                                <tr>
                                    <td>
                                        <div class="strong-name">@item.CustomerName</div>
                                        <div class="muted-code">@item.CustomerCode</div>
                                    </td>
                                    <td>
                                        <div>@item.BranchName</div>
                                        <div class="muted-code">@item.BranchCode</div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="panel">
            <div class="panel-title">
                <i class="bi bi-bullseye"></i>
                Targets Without Sales
            </div>

            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Branch</th>
                            <th>Sales District</th>
                            <th>Target</th>
                            <th>Planned Visits</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.TargetsWithoutSales.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-muted fw-bold">
                                    No targets without sales.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.TargetsWithoutSales)
                            {
                                <tr>
                                    <td>
                                        <div>@item.BranchName</div>
                                        <div class="muted-code">@item.BranchCode</div>
                                    </td>
                                    <td>
                                        <div class="strong-name">@item.SalesDistrictName</div>
                                        <div class="muted-code">@item.SalesDistrictCode</div>
                                    </td>
                                    <td>@Money(item.MonthlyTarget)</td>
                                    <td>@item.PlannedVisits</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

</div>