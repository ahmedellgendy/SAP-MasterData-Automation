<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - @AppBrand.AppName</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <link rel="icon"
          type="image/png"
          href="~/images/fridayops-icon.png" />



    <style>
            body {
                background-color: #f4f6f9;
            }

            .sidebar {
                width: 260px;
                height: 100vh;
                min-height: 100vh;
                background: #1f2937;
                position: fixed;
                left: 0;
                top: 0;
                padding: 18px;
                overflow-y: auto;
                overflow-x: hidden;
                box-sizing: border-box;
                overscroll-behavior: contain;
                transition: width .22s ease, padding .22s ease;
                z-index: 1040;
            }

            .sidebar-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
                margin-bottom: 24px;
            }

            .sidebar-toggle {
                width: 36px;
                height: 36px;
                flex: 0 0 36px;
                border: 1px solid rgba(255,255,255,.12);
                background: rgba(255,255,255,.06);
                color: #d1d5db;
                border-radius: 10px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                transition: .15s ease;
            }

                .sidebar-toggle:hover {
                    background: #374151;
                    color: #fff;
                    border-color: rgba(255,255,255,.20);
                }

            .sidebar::-webkit-scrollbar {
                width: 6px;
            }

            .sidebar::-webkit-scrollbar-track {
                background: #1f2937;
            }

            .sidebar::-webkit-scrollbar-thumb {
                background: #4b5563;
                border-radius: 20px;
            }

                .sidebar::-webkit-scrollbar-thumb:hover {
                    background: #6b7280;
                }

            .sidebar-title {
                color: white;
                font-size: 20px;
                font-weight: 800;
                margin-bottom: 0;
                display: flex;
                align-items: center;
                gap: 10px;
                min-width: 0;
            }

            .sidebar-section {
                color: #9ca3af !important;
                font-size: 11px;
                letter-spacing: 1.2px;
                margin-top: 18px;
                margin-bottom: 8px;
                text-transform: uppercase;
                font-weight: 800;
            }

            .sidebar a,
            .sidebar-menu-toggle {
                display: flex;
                align-items: center;
                color: #d1d5db;
                text-decoration: none;
                padding: 10px 12px;
                border-radius: 10px;
                margin-bottom: 5px;
                font-size: 14px;
                transition: 0.15s ease;
                border: 0;
                background: transparent;
                width: 100%;
                text-align: left;
            }

                .sidebar a:hover,
                .sidebar-menu-toggle:hover {
                    background: #374151;
                    color: white;
                }

                .sidebar a i,
                .sidebar-menu-toggle i:first-child {
                    margin-right: 10px;
                    font-size: 16px;
                    width: 20px;
                    text-align: center;
                }

                .sidebar a.active {
                    background: #2563eb;
                    color: #fff;
                }

                    .sidebar a.active i {
                        color: #fff;
                    }

            .sidebar-submenu a {
                font-size: 13px;
                padding: 9px 12px 9px 42px;
                margin-bottom: 3px;
            }

            .sidebar-menu-toggle .chevron {
                margin-left: auto;
                font-size: 13px;
                transition: transform 0.2s ease;
            }

            .sidebar-menu-toggle[aria-expanded="true"] .chevron {
                transform: rotate(180deg);
            }

            .sidebar-footer {
                margin-top: 24px;
                padding-top: 14px;
                padding-bottom: 16px;
                border-top: 1px solid rgba(255,255,255,0.12);
            }

            .main-content {
                margin-left: 260px;
                padding: 25px;
                transition: margin-left .22s ease;
            }

            /* =====================================================
                                                   Collapsed Sidebar
                                                   ===================================================== */

            body.sidebar-collapsed .sidebar {
                width: 76px;
                padding-left: 10px;
                padding-right: 10px;
            }

            body.sidebar-collapsed .main-content {
                margin-left: 76px;
            }

            body.sidebar-collapsed .sidebar-header {
                flex-direction: column;
                justify-content: center;
                gap: 8px;
            }

            body.sidebar-collapsed .sidebar-title {
                justify-content: center;
                width: 100%;
                font-size: 0;
            }

                body.sidebar-collapsed .sidebar-title img {
                    margin: 0;
                }

            body.sidebar-collapsed .sidebar-section {
                display: none;
            }

            body.sidebar-collapsed .sidebar > a,
            body.sidebar-collapsed .sidebar-menu-toggle {
                justify-content: center;
                padding-left: 10px;
                padding-right: 10px;
                font-size: 0;
            }

                body.sidebar-collapsed .sidebar > a i,
                body.sidebar-collapsed .sidebar-menu-toggle i:first-child {
                    margin-right: 0;
                    width: auto;
                    font-size: 18px;
                }

                body.sidebar-collapsed .sidebar-menu-toggle .chevron {
                    display: none;
                }

            body.sidebar-collapsed .sidebar-submenu {
                display: none !important;
            }

            body.sidebar-collapsed .sidebar-footer {
                display: none;
            }

            .app-topbar {
                background: #fff;
                border-radius: 14px;
                padding: 14px 22px;
                margin-bottom: 22px;
                box-shadow: 0 8px 22px rgba(15, 23, 42, .05);
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 16px;
                flex-wrap: wrap;
            }

            .greeting-title {
                font-size: 18px;
                font-weight: 900;
                color: #16232c;
                margin-bottom: 2px;
            }

            .greeting-subtitle {
                color: #64748b;
                font-size: 13px;
                font-weight: 600;
            }

            .topbar-actions {
                display: flex;
                align-items: center;
                gap: 12px;
                flex-wrap: wrap;
            }

            .user-chip {
                color: #475569;
                background: #f8fafc;
                border: 1px solid #e5e9ef;
                border-radius: 999px;
                padding: 7px 12px;
                font-size: 13px;
                font-weight: 700;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

            .logout-btn {
                border: 1px solid #ef4444;
                color: #ef4444;
                background: #fff;
                border-radius: 8px;
                padding: 7px 12px;
                font-size: 13px;
                font-weight: 800;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                transition: .15s ease;
            }

                .logout-btn:hover {
                    background: #ef4444;
                    color: #fff;
                }

            .content-card {
                background: white;
                border-radius: 12px;
                padding: 25px;
                box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            }

            .action-card {
                transition: .25s;
                cursor: pointer;
            }

                .action-card:hover {
                    transform: translateY(-6px);
                    box-shadow: 0 15px 30px rgba(0,0,0,.12) !important;
                }

                .action-card .card-body {
                    min-height: 180px;
                }

                .action-card i {
                    transition: .25s;
                }

                .action-card:hover i {
                    transform: scale(1.2);
                }

            @@media (max-width: 900px) {
                .main-content {
                    padding: 18px;
                }

                .app-topbar {
                    align-items: flex-start;
                }
            }

            @@media (max-width: 650px) {
                .sidebar {
                    width: 76px;
                    padding-left: 10px;
                    padding-right: 10px;
                }

                .main-content {
                    margin-left: 76px;
                    padding: 14px;
                }

                .sidebar-header {
                    flex-direction: column;
                    justify-content: center;
                    gap: 8px;
                }

                .sidebar-title {
                    justify-content: center;
                    width: 100%;
                    font-size: 0;
                }

                .sidebar-section,
                .sidebar-submenu,
                .sidebar-footer,
                .sidebar-menu-toggle .chevron {
                    display: none !important;
                }

                .sidebar > a,
                .sidebar-menu-toggle {
                    justify-content: center;
                    padding-left: 10px;
                    padding-right: 10px;
                    font-size: 0;
                }

                    .sidebar > a i,
                    .sidebar-menu-toggle i:first-child {
                        margin-right: 0;
                        width: auto;
                        font-size: 18px;
                    }
            }
    </style>
</head>

<body>

    @{
        var layoutIsAdmin = User.IsInRole("Admin");
        var layoutIsSales = User.IsInRole("Sales");
        var layoutIsManager = User.IsInRole("Manager");
        var layoutIsAccountsUser = User.IsInRole("AccountsUser");
        var layoutIsAccountsManager = User.IsInRole("AccountsManager");

        // Customer Care roles
        var layoutIsComplaintAgent = User.IsInRole("ComplaintAgent");
        var layoutIsComplaintSupervisor = User.IsInRole("ComplaintSupervisor");
        var layoutIsComplaintManager = User.IsInRole("ComplaintManager");

        var layoutCanAccessCustomerCare =
        layoutIsAdmin ||
        layoutIsComplaintAgent ||
        layoutIsComplaintSupervisor ||
        layoutIsComplaintManager;

        var layoutCanViewCustomerCareDashboard =
        layoutIsAdmin ||
        layoutIsComplaintSupervisor ||
        layoutIsComplaintManager;

        var layoutCanViewCustomerCareReports =
            layoutIsAdmin ||
            layoutIsComplaintManager;

        // Product Executive role القديم
        var layoutIsProductExecutiveManager =
        User.IsInRole("ExecutiveManager");

        // CEO Dashboard role
        var layoutIsExecutiveDashboardOnly =
        !layoutIsAdmin &&
        (
        User.IsInRole("Executive Manager") ||
        User.IsInRole("CEO")
        );
    }

    @if (layoutCanAccessCustomerCare)
    {
        <div class="modal fade"
             id="fridayBuddyModal"
             tabindex="-1"
             aria-labelledby="fridayBuddyModalLabel"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content border-0"
                     style="
                    border-radius:28px;
                    overflow:hidden;
                    box-shadow:0 30px 80px rgba(15,23,42,.28);
                    ">

                    <div class="modal-body p-0">

                        <div id="fridayBuddyCard"
                             style="
                            position:relative;
                            overflow:hidden;
                            background:
                            radial-gradient(
                            circle at 50% -10%,
                            rgba(59,130,246,.16),
                            transparent 38%
                            ),
                            linear-gradient(
                            180deg,
                            #f8fbff 0%,
                            #eff6ff 100%
                            );
                            padding:24px 28px 28px;
                            text-align:center;
                            direction:rtl;
                            ">

                            <div style="
                                position:absolute;
                                width:150px;
                                height:150px;
                                border-radius:50%;
                                background:rgba(59,130,246,.06);
                                top:-75px;
                                right:-55px;
                                pointer-events:none;
                                ">
                            </div>

                            <div style="
                                position:absolute;
                                width:100px;
                                height:100px;
                                border-radius:50%;
                                background:rgba(99,102,241,.05);
                                bottom:-45px;
                                left:-35px;
                                pointer-events:none;
                                ">
                            </div>

                            <div style="
                                position:relative;
                                z-index:1;
                                display:inline-flex;
                                align-items:center;
                                gap:7px;
                                background:rgba(255,255,255,.82);
                                border:1px solid rgba(148,163,184,.18);
                                border-radius:999px;
                                padding:6px 12px;
                                margin-bottom:14px;
                                box-shadow:0 5px 16px rgba(15,23,42,.05);
                                ">

                                <img src="~/images/fridayops-icon.png"
                                     alt="FridayOps"
                                     style="
                                width:22px;
                                height:22px;
                                object-fit:contain;
                                " />

                                <span style="
                                    font-size:11px;
                                    font-weight:900;
                                    color:#334155;
                                    direction:ltr;
                                    ">
                                    Friday Buddy
                                </span>
                            </div>

                            <div style="
                                position:relative;
                                z-index:1;
                                display:flex;
                                justify-content:center;
                                margin-bottom:13px;
                                ">

                                <div style="
                                    position:relative;
                                    width:235px;
                                    max-width:100%;
                                    border-radius:25px;
                                    padding:7px;
                                    background:rgba(255,255,255,.95);
                                    border:1px solid rgba(255,255,255,.9);
                                    box-shadow:
                                    0 18px 40px rgba(15,23,42,.14);
                                    ">

                                    <img id="fridayBuddyImage"
                                         src="~/images/friday-buddy/happy.png"
                                         alt="Friday Buddy"
                                         style="
                                    display:block;
                                    width:100%;
                                    height:auto;
                                    max-height:245px;
                                    object-fit:contain;
                                    border-radius:19px;
                                    " />
                                </div>
                            </div>

                            <div id="fridayBuddyMode"
                                 style="
                                position:relative;
                                z-index:1;
                                display:inline-flex;
                                align-items:center;
                                justify-content:center;
                                min-height:28px;
                                background:#dbeafe;
                                color:#1d4ed8;
                                border-radius:999px;
                                padding:5px 13px;
                                font-size:11px;
                                font-weight:950;
                                margin-bottom:9px;
                                direction:ltr;
                                ">
                                Happy Mode
                            </div>

                            <h3 id="fridayBuddyTitle"
                                style="
                                position:relative;
                                z-index:1;
                                font-size:21px;
                                font-weight:950;
                                color:#0f172a;
                                margin:0 0 7px;
                                line-height:1.5;
                                ">
                                صباح الخير ☀️
                            </h3>

                            <div id="fridayBuddyMessage"
                                 style="
                                position:relative;
                                z-index:1;
                                max-width:410px;
                                margin:0 auto 15px;
                                font-size:13px;
                                line-height:1.9;
                                color:#64748b;
                                font-weight:600;
                                ">
                                جاهزين ليوم هادي؟ خلينا نشوف 😄
                            </div>

                            <div style="
                                position:relative;
                                z-index:1;
                                max-width:440px;
                                margin:0 auto 18px;
                                ">

                                <div style="
                                    display:flex;
                                    align-items:center;
                                    gap:11px;
                                    text-align:right;
                                    background:rgba(255,255,255,.9);
                                    border:1px solid #bfdbfe;
                                    border-radius:16px;
                                    padding:11px 13px;
                                    box-shadow:0 6px 18px rgba(37,99,235,.05);
                                    ">

                                    <div style="
                                        width:38px;
                                        height:38px;
                                        flex:0 0 38px;
                                        display:flex;
                                        align-items:center;
                                        justify-content:center;
                                        border-radius:12px;
                                        background:#eff6ff;
                                        color:#2563eb;
                                        font-size:18px;
                                        ">
                                        🎯
                                    </div>

                                    <div>
                                        <div style="
                                            font-size:9px;
                                            font-weight:950;
                                            color:#2563eb;
                                            margin-bottom:2px;
                                            ">
                                            مهمة اليوم
                                        </div>

                                        <div id="fridayBuddyMission"
                                             style="
                                            font-size:11px;
                                            line-height:1.7;
                                            color:#334155;
                                            font-weight:700;
                                            ">
                                            خلّص أول Follow-up قبل القهوة.
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <button type="button"
                                    class="btn btn-primary"
                                    data-bs-dismiss="modal"
                                    style="
                                position:relative;
                                z-index:1;
                                min-width:160px;
                                border-radius:13px;
                                padding:10px 22px;
                                font-size:13px;
                                font-weight:950;
                                box-shadow:
                                0 10px 22px rgba(37,99,235,.22);
                                ">

                                <i class="bi bi-rocket-takeoff ms-1"></i>
                                يلا نبدأ
                            </button>

                            <div style="
                                position:relative;
                                z-index:1;
                                margin-top:13px;
                                font-size:8px;
                                font-weight:850;
                                letter-spacing:1.2px;
                                color:#94a3b8;
                                direction:ltr;
                                ">
                                HAPPIER AGENTS · HAPPIER CUSTOMERS
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="sidebar">

        <!-- ================================================= -->
        <!-- App Title -->
        <!-- ================================================= -->

        <div class="sidebar-header">

            <div class="sidebar-title">

                <img src="~/images/fridayops-icon.png"
                     alt="FridayOps"
                     style="width:34px;height:34px;border-radius:8px;" />

                @AppBrand.AppName

            </div>

            <button type="button"
                    class="sidebar-toggle"
                    id="sidebarToggle"
                    aria-label="Toggle sidebar"
                    aria-pressed="false"
                    title="Collapse sidebar">
                <i class="bi bi-layout-sidebar-inset"
                   id="sidebarToggleIcon"></i>
            </button>

        </div>

        <!-- ================================================= -->
        <!-- Dashboard -->
        <!-- ================================================= -->

        <div class="sidebar-section">
            Dashboard
        </div>

        @if (!layoutIsExecutiveDashboardOnly &&
                (layoutIsManager || layoutIsAdmin))
        {
            <a asp-controller="ManagerDashboard"
               asp-action="Index">
                <i class="bi bi-speedometer2"></i>
                Manager Dashboard
            </a>
        }

        @if (layoutIsExecutiveDashboardOnly)
        {
            <!-- ============================================= -->
            <!-- CEO Dashboard -->
            <!-- ============================================= -->

            <a asp-controller="SalesAnalyticsDashboard"
               asp-action="Index">
                <i class="bi bi-bar-chart-line"></i>
                CEO Dashboard
            </a>

            <!-- ============================================= -->
            <!-- Executive Reports -->
            <!-- ============================================= -->

            <div class="sidebar-section">
                Executive Reports
            </div>

            <a asp-controller="SalesAnalyticsExecutiveReports"
               asp-action="NoSalesCustomers">
                <i class="bi bi-person-exclamation"></i>
                Customers Without Sales
            </a>

            <a asp-controller="SalesAnalyticsExecutiveReports"
               asp-action="SalesRepEffectiveness">
                <i class="bi bi-person-workspace"></i>
                Sales Rep Performance
            </a>

            <a asp-controller="SalesAnalyticsExecutiveReports"
               asp-action="BranchPerformance">
                <i class="bi bi-buildings"></i>
                Branch Performance
            </a>

            <a asp-controller="SalesAnalyticsDataQuality"
               asp-action="Index">
                <i class="bi bi-shield-check"></i>
                Data Quality Report
            </a>

            <!-- ============================================= -->
            <!-- Target Management -->
            <!-- ============================================= -->

            <div class="sidebar-section">
                Target Management
            </div>

            <a asp-controller="SalesAnalyticsTargets"
               asp-action="Index">
                <i class="bi bi-bullseye"></i>
                Targets
            </a>
        }


        <!-- ================================================= -->
        <!-- Modules -->
        <!-- ================================================= -->
        @if (!layoutIsExecutiveDashboardOnly &&
                (
                layoutIsSales ||
                layoutIsManager ||
                layoutIsAdmin ||
                layoutIsAccountsUser ||
                layoutIsAccountsManager ||
                layoutIsProductExecutiveManager ||
                layoutIsComplaintAgent ||
                layoutIsComplaintSupervisor ||
                layoutIsComplaintManager
                ))
        {
            <div class="sidebar-section">
                Modules
            </div>
        }


        <!-- ================================================= -->
        <!-- Customer Care -->
        <!-- ================================================= -->
        @if (!layoutIsExecutiveDashboardOnly &&
                layoutCanAccessCustomerCare)
        {
            <button class="sidebar-menu-toggle"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#customerCareMenu"
                    aria-expanded="false"
                    aria-controls="customerCareMenu">

                <i class="bi bi-headset"></i>

                Customer Care

                <i class="bi bi-chevron-down chevron"></i>
            </button>

            <div class="collapse sidebar-submenu"
                 id="customerCareMenu">

                @if (layoutCanViewCustomerCareDashboard)
                {
                    <a asp-controller="CustomerCare"
                       asp-action="Dashboard">
                        <i class="bi bi-speedometer2"></i>
                        Dashboard
                    </a>
                }

                <a asp-controller="CustomerCare"
                   asp-action="Index">
                    <i class="bi bi-inboxes"></i>
                    Ticket Center
                </a>

                <a asp-controller="CustomerCare"
                   asp-action="Create">
                    <i class="bi bi-plus-circle"></i>
                    New Ticket
                </a>

                
                @if (layoutCanViewCustomerCareReports)
                {
                    <a asp-controller="CustomerCareReports"
                       asp-action="Index"
                       class="sidebar-link">
                        <i class="bi bi-file-earmark-bar-graph"></i>
                        <span>تقارير خدمة العملاء</span>
                    </a>
                }


            </div>
        }


        <!-- ================================================= -->
        <!-- Customers -->
        <!-- ================================================= -->
        @if (!layoutIsExecutiveDashboardOnly &&
                (layoutIsSales || layoutIsManager || layoutIsAdmin))
        {
            <button class="sidebar-menu-toggle"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#customersMenu"
                    aria-expanded="false"
                    aria-controls="customersMenu">

                <i class="bi bi-people"></i>

                Customers

                <i class="bi bi-chevron-down chevron"></i>
            </button>

            <div class="collapse sidebar-submenu"
                 id="customersMenu">

                @if (layoutIsSales || layoutIsAdmin)
                {
                    <a asp-controller="CustomerImport"
                       asp-action="Create">
                        <i class="bi bi-person-plus"></i>
                        Create Customer
                    </a>

                    <a asp-controller="CustomerModificationRequests"
                       asp-action="Create">
                        <i class="bi bi-pencil-square"></i>
                        Customer Modification
                    </a>

                    <a asp-controller="CustomerImport"
                       asp-action="Draft">
                        <i class="bi bi-list-check"></i>
                        Draft Customers
                    </a>

                    <a asp-controller="CustomerImport"
                       asp-action="RejectedForReview">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        Rejected Review
                    </a>
                }

                @if (layoutIsManager || layoutIsAdmin)
                {
                    <a asp-controller="ManagerDashboard"
                       asp-action="SubmittedCustomers">
                        <i class="bi bi-send-check"></i>
                        Pending Customers
                    </a>

                    <a asp-controller="ManagerDashboard"
                       asp-action="ApprovedCustomers">
                        <i class="bi bi-check-circle"></i>
                        Approved Customers
                    </a>

                    <a asp-controller="ManagerDashboard"
                       asp-action="RejectedCustomers">
                        <i class="bi bi-x-circle"></i>
                        Rejected Customers
                    </a>

                    <a asp-controller="CustomerModificationManager"
                       asp-action="Index">
                        <i class="bi bi-clipboard-check"></i>
                        Customer Modification Review
                    </a>

                    <a asp-controller="CustomerImport"
                       asp-action="History">
                        <i class="bi bi-clock-history"></i>
                        SAP History
                    </a>
                }

            </div>
        }


        <!-- ================================================= -->
        <!-- Products -->
        <!-- ================================================= -->
        @if (!layoutIsExecutiveDashboardOnly &&
                (
                layoutIsAdmin ||
                layoutIsSales ||
                layoutIsManager ||
                layoutIsAccountsUser ||
                layoutIsAccountsManager ||
                layoutIsProductExecutiveManager
                ))
        {
            <button class="sidebar-menu-toggle"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#productsMenu"
                    aria-expanded="false"
                    aria-controls="productsMenu">

                <i class="bi bi-box-seam"></i>

                Products

                <i class="bi bi-chevron-down chevron"></i>
            </button>

            <div class="collapse sidebar-submenu"
                 id="productsMenu">

                @if (layoutIsAdmin ||
                            layoutIsSales ||
                            layoutIsManager ||
                            layoutIsAccountsUser ||
                            layoutIsAccountsManager ||
                            layoutIsProductExecutiveManager)
                {
                    <a asp-controller="Products"
                       asp-action="Index"
                       class="sidebar-link">
                        <i class="bi bi-box-seam"></i>
                        Products Master
                    </a>
                }

                @if (layoutIsAdmin || layoutIsAccountsUser)
                {
                    <a asp-controller="ProductRequests"
                       asp-action="Index">
                        <i class="bi bi-file-earmark-plus"></i>
                        Product Requests
                    </a>
                }

                @if (layoutIsAdmin || layoutIsAccountsManager)
                {
                    <a asp-controller="ProductAccountsManager"
                       asp-action="Index">
                        <i class="bi bi-clipboard-check"></i>
                        Accounts Review
                    </a>
                }

                @if (layoutIsAdmin ||
                            layoutIsProductExecutiveManager)
                {
                    <a asp-controller="ProductExecutiveManager"
                       asp-action="Index">
                        <i class="bi bi-cash-coin"></i>
                        Executive Pricing
                    </a>
                }

            </div>
        }


        <!-- ================================================= -->
        <!-- Sales Analytics -->
        <!-- ================================================= -->
        @if (!layoutIsExecutiveDashboardOnly &&
                false)
        {
            <button class="sidebar-menu-toggle"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#salesAnalyticsMenu"
                    aria-expanded="false"
                    aria-controls="salesAnalyticsMenu">

                <i class="bi bi-bar-chart-line"></i>

                Sales Analytics

                <i class="bi bi-chevron-down chevron"></i>
            </button>

            <div class="collapse sidebar-submenu"
                 id="salesAnalyticsMenu">

                <!-- CEO Dashboard -->

                <a asp-controller="SalesAnalyticsDashboard"
                   asp-action="Index">
                    <i class="bi bi-speedometer"></i>
                    CEO Dashboard
                </a>

                <!-- Executive Reports -->





                <a asp-controller="SalesAnalyticsExecutiveReports"
                   asp-action="BranchPerformance"
                   class="nav-link">
                    <i class="bi bi-buildings"></i>
                    <span>Branch Performance</span>
                </a>
                <a asp-controller="SalesAnalyticsExecutiveReports"
                   asp-action="SalesRepEffectiveness">
                    <i class="bi bi-person-workspace"></i>
                    Sales Rep Field Performance
                </a>

                <a asp-controller="SalesAnalyticsExecutiveReports"
                   asp-action="NoSalesCustomers">
                    <i class="bi bi-person-exclamation"></i>
                    Customers Without Sales
                </a>
                <!-- Data Quality -->

                <a asp-controller="SalesAnalyticsDataQuality"
                   asp-action="Index">
                    <i class="bi bi-shield-check"></i>
                    Data Quality Report
                </a>

                <!-- Upload Center -->

                <a asp-controller="SalesAnalyticsMasterData"
                   asp-action="UploadCenter">
                    <i class="bi bi-cloud-upload"></i>
                    Upload Center
                </a>

                <!-- Targets -->

                <a asp-controller="SalesAnalyticsTargets"
                   asp-action="Index">
                    <i class="bi bi-bullseye"></i>
                    Targets
                </a>

                <!-- Customer Master -->

                <a asp-controller="SalesAnalyticsMasterData"
                   asp-action="CustomerMaster">
                    <i class="bi bi-people"></i>
                    Customer Master Upload
                </a>

                <!-- Sales Rep Master -->

                <a asp-controller="SalesAnalyticsMasterData"
                   asp-action="SalesRepMaster">
                    <i class="bi bi-person-badge"></i>
                    Sales Rep Master Upload
                </a>

                <!-- Daily Sales -->

                <a asp-controller="SalesAnalyticsMasterData"
                   asp-action="DailySalesReport">
                    <i class="bi bi-file-earmark-spreadsheet"></i>
                    Daily Sales Upload
                </a>

                <!-- MTD Sales -->

                <a asp-controller="SalesAnalyticsMasterData"
                   asp-action="MtdSalesReport">
                    <i class="bi bi-calendar-range"></i>
                    MTD Sales Upload
                </a>

                <!-- MTD Visits -->

                <a asp-controller="SalesAnalyticsMasterData"
                   asp-action="MtdVisitsReport">
                    <i class="bi bi-calendar-check"></i>
                    MTD Visits Upload
                </a>

                <!-- Daily Visits -->

                <a asp-controller="SalesAnalyticsMasterData"
                   asp-action="DailyVisitsReport">
                    <i class="bi bi-geo-alt"></i>
                    Daily Visits Upload
                </a>

            </div>
        }


        <!-- ================================================= -->
        <!-- Administration -->
        <!-- ================================================= -->
        @if (layoutIsAdmin || layoutIsManager)
        {
            <div class="sidebar-section">
                Administration
            </div>

            <button class="sidebar-menu-toggle"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#adminMenu"
                    aria-expanded="false"
                    aria-controls="adminMenu">

                <i class="bi bi-shield-lock"></i>

                Admin Tools

                <i class="bi bi-chevron-down chevron"></i>
            </button>

            <div class="collapse sidebar-submenu"
                 id="adminMenu">

                @if (layoutIsAdmin)
                {
                    <a asp-controller="AdminUsers"
                       asp-action="Index">
                        <i class="bi bi-people"></i>
                        Users Management
                    </a>

                    <a asp-controller="CustomerImport"
                       asp-action="Upload">
                        <i class="bi bi-file-earmark-excel"></i>
                        Upload SAP Sheet
                    </a>

                    <a asp-controller="ActivityLogs"
                       asp-action="Index">
                        <i class="bi bi-activity"></i>
                        Activity Logs
                    </a>
                }

                @if (layoutIsAdmin || layoutIsManager)
                {
                    <a asp-controller="SystemSettings"
                       asp-action="Index">
                        <i class="bi bi-gear"></i>
                        Settings
                    </a>
                }

            </div>
        }


        <!-- ================================================= -->
        <!-- Footer -->
        <!-- ================================================= -->

        <div class="sidebar-footer">

            <div class="text-secondary small">
                Developed by
            </div>

            <div class="text-white fw-semibold small">
                @AppBrand.DeveloperName
            </div>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- Main Content -->
    <!-- ===================================================== -->

    <div class="main-content">

        @{
            var fullName =
            User.FindFirst("FullName")?.Value;

            var userName =
            !string.IsNullOrWhiteSpace(fullName)
            ? fullName
            : User.Identity?.Name ?? "User";

            var userRole =
            User.FindFirst(
            System.Security.Claims.ClaimTypes.Role)
            ?.Value
            ?? "User";

            var hour =
            DateTime.Now.Hour;

            var greeting =
            hour < 12
            ? "Good morning"
            : hour < 18
            ? "Good afternoon"
            : "Good evening";
        }

        <!-- ================================================= -->
        <!-- Top Bar -->
        <!-- ================================================= -->

        <div class="app-topbar">

            <div>

                <div class="greeting-title">
                    @greeting, @userName
                </div>

                <div class="greeting-subtitle">
                    Welcome back to @AppBrand.AppName
                </div>

            </div>

            <div class="topbar-actions">

                <span class="user-chip">

                    <i class="bi bi-person-circle"></i>

                    @userName - @userRole

                </span>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="m-0">

                    <button type="submit"
                            class="logout-btn">

                        <i class="bi bi-box-arrow-right"></i>

                        Logout

                    </button>

                </form>

            </div>

        </div>

        @RenderBody()

    </div>

    <!-- ===================================================== -->
    <!-- Scripts -->
    <!-- ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            document.addEventListener("DOMContentLoaded", function () {

                const body =
                    document.body;

                const sidebarToggle =
                    document.getElementById("sidebarToggle");

                const sidebarToggleIcon =
                    document.getElementById("sidebarToggleIcon");

                        const sidebarStorageKey =
                "fridayops.sidebar.collapsed";

            function setSidebarCollapsed(collapsed) {

                body.classList.toggle(
                    "sidebar-collapsed",
                    collapsed);

                if (sidebarToggle) {

                    sidebarToggle.setAttribute(
                        "aria-pressed",
                        collapsed ? "true" : "false");

                    sidebarToggle.setAttribute(
                        "title",
                        collapsed
                            ? "Expand sidebar"
                            : "Collapse sidebar");
                }

                if (sidebarToggleIcon) {

                    sidebarToggleIcon.className =
                        collapsed
                            ? "bi bi-layout-sidebar-inset-reverse"
                            : "bi bi-layout-sidebar-inset";
                }

                localStorage.setItem(
                    sidebarStorageKey,
                    collapsed ? "true" : "false");
            }


            // آخر حالة اختارها المستخدم
            const storedSidebarState =
                localStorage.getItem(
                    sidebarStorageKey);

            const shouldStartCollapsed =
                storedSidebarState === "true";

            setSidebarCollapsed(
                shouldStartCollapsed);


            // فتح / قفل يدوي فقط
            sidebarToggle?.addEventListener(
                "click",
                function () {

                    const isCollapsed =
                        body.classList.contains(
                            "sidebar-collapsed");

                    setSidebarCollapsed(
                        !isCollapsed);
                });

                document
                    .querySelectorAll(".sidebar-menu-toggle")
                    .forEach(button => {

                        button.addEventListener(
                            "click",
                            function (event) {

                                if (!body.classList.contains(
                                    "sidebar-collapsed")) {
                                    return;
                                }

                                event.preventDefault();
                                event.stopPropagation();

                                setSidebarCollapsed(false);

                                const targetSelector =
                                    button.getAttribute(
                                        "data-bs-target");

                                if (!targetSelector) {
                                    return;
                                }

                                const target =
                                    document.querySelector(
                                        targetSelector);

                                if (!target) {
                                    return;
                                }

                                window.setTimeout(
                                    function () {

                                        const collapse =
                                            bootstrap.Collapse
                                                .getOrCreateInstance(
                                                    target,
                                                    {
                                                        toggle: false
                                                    });

                                        collapse.show();

                                        button.setAttribute(
                                            "aria-expanded",
                                            "true");
                                    },
                                    160);
                            });
                    });

                const currentPath =
                    window.location.pathname
                        .toLowerCase();

                document
                    .querySelectorAll(".sidebar a[href]")
                    .forEach(link => {

                        const linkPath =
                            link.getAttribute("href")
                                ?.toLowerCase();

                        if (!linkPath ||
                            linkPath === "#") {
                            return;
                        }

                        if (
                            currentPath === linkPath ||
                            currentPath.startsWith(
                                linkPath + "/")
                        ) {
                            link.classList.add("active");

                            const collapseParent =
                                link.closest(".collapse");

                            if (collapseParent) {

                                collapseParent.classList.add(
                                    "show");

                                const toggleButton =
                                    document.querySelector(
                                        `[data-bs-target="#${collapseParent.id}"]`
                                    );

                                if (toggleButton) {
                                    toggleButton.setAttribute(
                                        "aria-expanded",
                                        "true");
                                }
                            }
                        }
                    });


                            const fridayBuddyModalElement =
                document.getElementById("fridayBuddyModal");

            if (fridayBuddyModalElement) {

                const currentUser =
                    '@(User.Identity?.Name ?? "user")';

                const today =
                    new Date()
                        .toISOString()
                        .split("T")[0];

                const buddyStorageKey =
                    `fridayops.dailyfun.${currentUser}.${today}`;

                const alreadyShown =
                    localStorage.getItem(
                        buddyStorageKey);

                if (!alreadyShown) {

                    const hour =
                        new Date().getHours();

                    const day =
                        new Date().getDay();

                    let mode =
                        "Happy Mode";

                    let title =
                        "صباح الخير ☀️";

                    let message =
                        "جاهزين ليوم هادي؟ خلينا نشوف 😄";

                    let mission =
                        "خلّص أول Follow-up قبل القهوة.";

                    let image =
                        "/images/friday-buddy/happy.png";

                    if (day === 5) {

                        mode =
                            "Friday Mode 😎";

                        title =
                            "Friday on Friday 🍦";

                        message =
                            "النهارده Friday... يعني المزاج أعلى من الـ SLA 😄";

                        mission =
                            "خلّص يومك من غير Ticket دراما.";

                        image =
                            "/images/friday-buddy/friday.png";
                    }
                    else if (hour >= 16) {

                        mode =
                            "End of Shift Mode 🌙";

                        title =
                            "قربنا نخلص 😴";

                        message =
                            "آخر Ticket... إن شاء الله 😂";

                        mission =
                            "اقفل آخر Follow-up قبل ما تقول سلام.";

                        image =
                            "/images/friday-buddy/end-shift.png";
                    }
                    else if (hour >= 13) {

                        mode =
                            "Tired Mode ☕";

                        title =
                            "Coffee Survival Mode";

                        message =
                            "لسه اليوم مخلصش... بس الإحساس End of Shift ☕";

                        mission =
                            "خلّص Ticket واحدة قبل القهوة الجاية.";

                        image =
                            "/images/friday-buddy/tired.png";
                    }
                    else {

                        const random =
                            Math.random();

                        if (random > 0.75) {

                            mode =
                                "Angry Customer Mode 🔥";

                            title =
                                "خليك هادي 😅";

                            message =
                                "العميل قال: أنا بكلمكم من أسبوع... والتيكت لسه متفتحة من 10 دقايق 😂";

                            mission =
                                "حافظ على هدوءك لأول 3 Calls.";

                            image =
                                "/images/friday-buddy/angry.png";
                        }
                    }

                    const modeElement =
                        document.getElementById(
                            "fridayBuddyMode");

                    const titleElement =
                        document.getElementById(
                            "fridayBuddyTitle");

                    const messageElement =
                        document.getElementById(
                            "fridayBuddyMessage");

                    const missionElement =
                        document.getElementById(
                            "fridayBuddyMission");

                    const imageElement =
                        document.getElementById(
                            "fridayBuddyImage");

                    if (imageElement) {
                        imageElement.src =
                            image;
                    }

                    if (modeElement) {
                        modeElement.textContent =
                            mode;
                    }

                    if (titleElement) {
                        titleElement.textContent =
                            title;
                    }

                    if (messageElement) {
                        messageElement.textContent =
                            message;
                    }

                    if (missionElement) {
                        missionElement.textContent =
                            mission;
                    }

                    const buddyModal =
                        new bootstrap.Modal(
                            fridayBuddyModalElement);

                    window.setTimeout(
                        function () {

                            buddyModal.show();

                            localStorage.setItem(
                                buddyStorageKey,
                                "true");
                        },
                        600);
                }
            }
            });
    </script>

    @await RenderSectionAsync(
    "Scripts",
        required: false
        )

</body>
</html>