<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - @AppBrand.AppName</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <link rel="icon"
          type="image/png"
          href="~/images/fridayops-icon.png" />

    

    <style>
        body {
            background-color: #f4f6f9;
        }

        .sidebar {
            width: 260px;
            height: 100vh;
            min-height: 100vh;
            background: #1f2937;
            position: fixed;
            left: 0;
            top: 0;
            padding: 18px;
            overflow-y: auto;
            overflow-x: hidden;
            box-sizing: border-box;
            overscroll-behavior: contain;
        }

            .sidebar::-webkit-scrollbar {
                width: 6px;
            }

            .sidebar::-webkit-scrollbar-track {
                background: #1f2937;
            }

            .sidebar::-webkit-scrollbar-thumb {
                background: #4b5563;
                border-radius: 20px;
            }

                .sidebar::-webkit-scrollbar-thumb:hover {
                    background: #6b7280;
                }

        .sidebar-title {
            color: white;
            font-size: 20px;
            font-weight: 800;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sidebar-section {
            color: #9ca3af !important;
            font-size: 11px;
            letter-spacing: 1.2px;
            margin-top: 18px;
            margin-bottom: 8px;
            text-transform: uppercase;
            font-weight: 800;
        }

        .sidebar a,
        .sidebar-menu-toggle {
            display: flex;
            align-items: center;
            color: #d1d5db;
            text-decoration: none;
            padding: 10px 12px;
            border-radius: 10px;
            margin-bottom: 5px;
            font-size: 14px;
            transition: 0.15s ease;
            border: 0;
            background: transparent;
            width: 100%;
            text-align: left;
        }

            .sidebar a:hover,
            .sidebar-menu-toggle:hover {
                background: #374151;
                color: white;
            }

            .sidebar a i,
            .sidebar-menu-toggle i:first-child {
                margin-right: 10px;
                font-size: 16px;
                width: 20px;
                text-align: center;
            }

            .sidebar a.active {
                background: #2563eb;
                color: #fff;
            }

                .sidebar a.active i {
                    color: #fff;
                }

        .sidebar-submenu a {
            font-size: 13px;
            padding: 9px 12px 9px 42px;
            margin-bottom: 3px;
        }

        .sidebar-menu-toggle .chevron {
            margin-left: auto;
            font-size: 13px;
            transition: transform 0.2s ease;
        }

        .sidebar-menu-toggle[aria-expanded="true"] .chevron {
            transform: rotate(180deg);
        }

        .sidebar-footer {
            margin-top: 24px;
            padding-top: 14px;
            padding-bottom: 16px;
            border-top: 1px solid rgba(255,255,255,0.12);
        }

        .main-content {
            margin-left: 260px;
            padding: 25px;
        }

        .app-topbar {
            background: #fff;
            border-radius: 14px;
            padding: 14px 22px;
            margin-bottom: 22px;
            box-shadow: 0 8px 22px rgba(15, 23, 42, .05);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .greeting-title {
            font-size: 18px;
            font-weight: 900;
            color: #16232c;
            margin-bottom: 2px;
        }

        .greeting-subtitle {
            color: #64748b;
            font-size: 13px;
            font-weight: 600;
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .user-chip {
            color: #475569;
            background: #f8fafc;
            border: 1px solid #e5e9ef;
            border-radius: 999px;
            padding: 7px 12px;
            font-size: 13px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .logout-btn {
            border: 1px solid #ef4444;
            color: #ef4444;
            background: #fff;
            border-radius: 8px;
            padding: 7px 12px;
            font-size: 13px;
            font-weight: 800;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: .15s ease;
        }

            .logout-btn:hover {
                background: #ef4444;
                color: #fff;
            }

        .content-card {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .action-card {
            transition: .25s;
            cursor: pointer;
        }

            .action-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 15px 30px rgba(0,0,0,.12) !important;
            }

            .action-card .card-body {
                min-height: 180px;
            }

            .action-card i {
                transition: .25s;
            }

            .action-card:hover i {
                transform: scale(1.2);
            }

        @@media (max-width: 900px) {
            .main-content {
                margin-left: 260px;
                padding: 18px;
            }

            .app-topbar {
                align-items: flex-start;
            }
        }
    </style>
</head>

<body>

    @{
        var layoutIsAdmin = User.IsInRole("Admin");
        var layoutIsSales = User.IsInRole("Sales");
        var layoutIsManager = User.IsInRole("Manager");
        var layoutIsAccountsUser = User.IsInRole("AccountsUser");
        var layoutIsAccountsManager = User.IsInRole("AccountsManager");

        // Product Executive role القديم
        var layoutIsProductExecutiveManager =
        User.IsInRole("ExecutiveManager");

        // CEO Dashboard role
        var layoutIsExecutiveDashboardOnly =
        !layoutIsAdmin &&
        (
        User.IsInRole("Executive Manager") ||
        User.IsInRole("CEO")
        );
    }

    <div class="sidebar">

        <!-- ================================================= -->
        <!-- App Title -->
        <!-- ================================================= -->

        <div class="sidebar-title">

            <img src="~/images/fridayops-icon.png"
                 alt="FridayOps"
                 style="width:34px;height:34px;border-radius:8px;" />

            @AppBrand.AppName

        </div>

        <!-- ================================================= -->
        <!-- Dashboard -->
        <!-- ================================================= -->

        <div class="sidebar-section">
            Dashboard
        </div>

        @if (!layoutIsExecutiveDashboardOnly &&
                (layoutIsManager || layoutIsAdmin))
        {
            <a asp-controller="ManagerDashboard"
               asp-action="Index">
                <i class="bi bi-speedometer2"></i>
                Manager Dashboard
            </a>
        }

        @if (layoutIsExecutiveDashboardOnly)
        {
            <!-- ============================================= -->
            <!-- CEO Dashboard -->
            <!-- ============================================= -->

            <a asp-controller="SalesAnalyticsDashboard"
               asp-action="Index">
                <i class="bi bi-bar-chart-line"></i>
                CEO Dashboard
            </a>

            <!-- ============================================= -->
            <!-- Executive Reports -->
            <!-- ============================================= -->

            <div class="sidebar-section">
                Executive Reports
            </div>

            <a asp-controller="SalesAnalyticsExecutiveReports"
               asp-action="NoSalesCustomers">
                <i class="bi bi-person-exclamation"></i>
                Customers Without Sales
            </a>

            <a asp-controller="SalesAnalyticsExecutiveReports"
               asp-action="SalesRepEffectiveness">
                <i class="bi bi-person-workspace"></i>
                Sales Rep Performance
            </a>

            <a asp-controller="SalesAnalyticsExecutiveReports"
               asp-action="BranchPerformance">
                <i class="bi bi-buildings"></i>
                Branch Performance
            </a>

            <a asp-controller="SalesAnalyticsDataQuality"
               asp-action="Index">
                <i class="bi bi-shield-check"></i>
                Data Quality Report
            </a>

            <!-- ============================================= -->
            <!-- Target Management -->
            <!-- ============================================= -->

            <div class="sidebar-section">
                Target Management
            </div>

            <a asp-controller="SalesAnalyticsTargets"
               asp-action="Index">
                <i class="bi bi-bullseye"></i>
                Targets
            </a>
        }
        

        <!-- ================================================= -->
        <!-- Modules -->
        <!-- ================================================= -->
        @if (!layoutIsExecutiveDashboardOnly &&
                (
                layoutIsSales ||
                layoutIsManager ||
                layoutIsAdmin ||
                layoutIsAccountsUser ||
                layoutIsAccountsManager ||
                layoutIsProductExecutiveManager
                ))
        {
            <div class="sidebar-section">
                Modules
            </div>
        }

        <!-- ================================================= -->
        <!-- Customers -->
        <!-- ================================================= -->
        @if (!layoutIsExecutiveDashboardOnly &&
                (layoutIsSales || layoutIsManager || layoutIsAdmin))
        {
            <button class="sidebar-menu-toggle"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#customersMenu"
                    aria-expanded="false"
                    aria-controls="customersMenu">

                <i class="bi bi-people"></i>

                Customers

                <i class="bi bi-chevron-down chevron"></i>
            </button>

            <div class="collapse sidebar-submenu"
                 id="customersMenu">

                @if (layoutIsSales || layoutIsAdmin)
                {
                    <a asp-controller="CustomerImport"
                       asp-action="Create">
                        <i class="bi bi-person-plus"></i>
                        Create Customer
                    </a>

                    <a asp-controller="CustomerModificationRequests"
                       asp-action="Create">
                        <i class="bi bi-pencil-square"></i>
                        Customer Modification
                    </a>

                    <a asp-controller="CustomerImport"
                       asp-action="Draft">
                        <i class="bi bi-list-check"></i>
                        Draft Customers
                    </a>

                    <a asp-controller="CustomerImport"
                       asp-action="RejectedForReview">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        Rejected Review
                    </a>
                }

                @if (layoutIsManager || layoutIsAdmin)
                {
                    <a asp-controller="ManagerDashboard"
                       asp-action="SubmittedCustomers">
                        <i class="bi bi-send-check"></i>
                        Pending Customers
                    </a>

                    <a asp-controller="ManagerDashboard"
                       asp-action="ApprovedCustomers">
                        <i class="bi bi-check-circle"></i>
                        Approved Customers
                    </a>

                    <a asp-controller="ManagerDashboard"
                       asp-action="RejectedCustomers">
                        <i class="bi bi-x-circle"></i>
                        Rejected Customers
                    </a>

                    <a asp-controller="CustomerModificationManager"
                       asp-action="Index">
                        <i class="bi bi-clipboard-check"></i>
                        Customer Modification Review
                    </a>

                    <a asp-controller="CustomerImport"
                       asp-action="History">
                        <i class="bi bi-clock-history"></i>
                        SAP History
                    </a>
                }

            </div>
        }

        <!-- ================================================= -->
        <!-- Products -->
        <!-- ================================================= -->
        @if (!layoutIsExecutiveDashboardOnly &&
                User.Identity?.IsAuthenticated == true)
        {
            <button class="sidebar-menu-toggle"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#productsMenu"
                    aria-expanded="false"
                    aria-controls="productsMenu">

                <i class="bi bi-box-seam"></i>

                Products

                <i class="bi bi-chevron-down chevron"></i>
            </button>

            <div class="collapse sidebar-submenu"
                 id="productsMenu">

                <a asp-controller="Products"
                   asp-action="Index"
                   class="sidebar-link">
                    <i class="bi bi-box-seam"></i>
                    Products Master
                </a>

                @if (layoutIsAdmin || layoutIsAccountsUser)
                {
                    <a asp-controller="ProductRequests"
                       asp-action="Index">
                        <i class="bi bi-file-earmark-plus"></i>
                        Product Requests
                    </a>
                }

                @if (layoutIsAdmin || layoutIsAccountsManager)
                {
                    <a asp-controller="ProductAccountsManager"
                       asp-action="Index">
                        <i class="bi bi-clipboard-check"></i>
                        Accounts Review
                    </a>
                }

                @if (layoutIsAdmin ||
                            layoutIsProductExecutiveManager)
                {
                    <a asp-controller="ProductExecutiveManager"
                       asp-action="Index">
                        <i class="bi bi-cash-coin"></i>
                        Executive Pricing
                    </a>
                }

            </div>
        }

        <!-- ================================================= -->
        <!-- Sales Analytics -->
        <!-- ================================================= -->
        @if (!layoutIsExecutiveDashboardOnly &&
                (layoutIsAdmin || layoutIsManager))
        {
            <button class="sidebar-menu-toggle"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#salesAnalyticsMenu"
                    aria-expanded="false"
                    aria-controls="salesAnalyticsMenu">

                <i class="bi bi-bar-chart-line"></i>

                Sales Analytics

                <i class="bi bi-chevron-down chevron"></i>
            </button>

            <div class="collapse sidebar-submenu"
                 id="salesAnalyticsMenu">

                <!-- CEO Dashboard -->

                <a asp-controller="SalesAnalyticsDashboard"
                   asp-action="Index">
                    <i class="bi bi-speedometer"></i>
                    CEO Dashboard
                </a>

                <!-- Executive Reports -->

                

                

                <a asp-controller="SalesAnalyticsExecutiveReports"
                   asp-action="BranchPerformance"
                   class="nav-link">
                    <i class="bi bi-buildings"></i>
                    <span>Branch Performance</span>
                </a>
                <a asp-controller="SalesAnalyticsExecutiveReports"
                   asp-action="SalesRepEffectiveness">
                    <i class="bi bi-person-workspace"></i>
                    Sales Rep Field Performance
                </a>

                <a asp-controller="SalesAnalyticsExecutiveReports"
                   asp-action="NoSalesCustomers">
                    <i class="bi bi-person-exclamation"></i>
                    Customers Without Sales
                </a>
                <!-- Data Quality -->

                <a asp-controller="SalesAnalyticsDataQuality"
                   asp-action="Index">
                    <i class="bi bi-shield-check"></i>
                    Data Quality Report
                </a>

                <!-- Upload Center -->

                <a asp-controller="SalesAnalyticsMasterData"
                   asp-action="UploadCenter">
                    <i class="bi bi-cloud-upload"></i>
                    Upload Center
                </a>

                <!-- Targets -->

                <a asp-controller="SalesAnalyticsTargets"
                   asp-action="Index">
                    <i class="bi bi-bullseye"></i>
                    Targets
                </a>

                <!-- Customer Master -->

                <a asp-controller="SalesAnalyticsMasterData"
                   asp-action="CustomerMaster">
                    <i class="bi bi-people"></i>
                    Customer Master Upload
                </a>

                <!-- Sales Rep Master -->

                <a asp-controller="SalesAnalyticsMasterData"
                   asp-action="SalesRepMaster">
                    <i class="bi bi-person-badge"></i>
                    Sales Rep Master Upload
                </a>

                <!-- Daily Sales -->

                <a asp-controller="SalesAnalyticsMasterData"
                   asp-action="DailySalesReport">
                    <i class="bi bi-file-earmark-spreadsheet"></i>
                    Daily Sales Upload
                </a>

                <!-- MTD Sales -->

                <a asp-controller="SalesAnalyticsMasterData"
                   asp-action="MtdSalesReport">
                    <i class="bi bi-calendar-range"></i>
                    MTD Sales Upload
                </a>

                <!-- MTD Visits -->

                <a asp-controller="SalesAnalyticsMasterData"
                   asp-action="MtdVisitsReport">
                    <i class="bi bi-calendar-check"></i>
                    MTD Visits Upload
                </a>

                <!-- Daily Visits -->

                <a asp-controller="SalesAnalyticsMasterData"
                   asp-action="DailyVisitsReport">
                    <i class="bi bi-geo-alt"></i>
                    Daily Visits Upload
                </a>

            </div>
        }

        <!-- ================================================= -->
        <!-- Administration -->
        <!-- ================================================= -->
        @if (layoutIsAdmin)
        {
            <div class="sidebar-section">
                Administration
            </div>

            <button class="sidebar-menu-toggle"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#adminMenu"
                    aria-expanded="false"
                    aria-controls="adminMenu">

                <i class="bi bi-shield-lock"></i>

                Admin Tools

                <i class="bi bi-chevron-down chevron"></i>
            </button>

            <div class="collapse sidebar-submenu"
                 id="adminMenu">

                <a asp-controller="AdminUsers"
                   asp-action="Index">
                    <i class="bi bi-people"></i>
                    Users Management
                </a>

                <a asp-controller="CustomerImport"
                   asp-action="Upload">
                    <i class="bi bi-file-earmark-excel"></i>
                    Upload SAP Sheet
                </a>

                <a asp-controller="ActivityLogs"
                   asp-action="Index">
                    <i class="bi bi-activity"></i>
                    Activity Logs
                </a>

                <a asp-controller="SystemSettings"
                   asp-action="Index">
                    <i class="bi bi-gear"></i>
                    Settings
                </a>

            </div>
        }

        <!-- ================================================= -->
        <!-- Footer -->
        <!-- ================================================= -->

        <div class="sidebar-footer">

            <div class="text-secondary small">
                Developed by
            </div>

            <div class="text-white fw-semibold small">
                @AppBrand.DeveloperName
            </div>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- Main Content -->
    <!-- ===================================================== -->

    <div class="main-content">

        @{
            var fullName =
            User.FindFirst("FullName")?.Value;

            var userName =
            !string.IsNullOrWhiteSpace(fullName)
            ? fullName
            : User.Identity?.Name ?? "User";

            var userRole =
            User.FindFirst(
            System.Security.Claims.ClaimTypes.Role)
            ?.Value
            ?? "User";

            var hour =
            DateTime.Now.Hour;

            var greeting =
            hour < 12
            ? "Good morning"
            : hour < 18
            ? "Good afternoon"
            : "Good evening";
        }

        <!-- ================================================= -->
        <!-- Top Bar -->
        <!-- ================================================= -->

        <div class="app-topbar">

            <div>

                <div class="greeting-title">
                    @greeting, @userName
                </div>

                <div class="greeting-subtitle">
                    Welcome back to @AppBrand.AppName
                </div>

            </div>

            <div class="topbar-actions">

                <span class="user-chip">

                    <i class="bi bi-person-circle"></i>

                    @userName - @userRole

                </span>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="m-0">

                    <button type="submit"
                            class="logout-btn">

                        <i class="bi bi-box-arrow-right"></i>

                        Logout

                    </button>

                </form>

            </div>

        </div>

        @RenderBody()

    </div>

    <!-- ===================================================== -->
    <!-- Scripts -->
    <!-- ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const currentPath =
                window.location.pathname.toLowerCase();

            document
                .querySelectorAll(".sidebar a[href]")
                .forEach(link => {

                    const linkPath =
                        link.getAttribute("href")?.toLowerCase();

                    if (!linkPath || linkPath === "#") {
                        return;
                    }

                    if (
                        currentPath === linkPath ||
                        currentPath.startsWith(linkPath + "/")
                    ) {
                        link.classList.add("active");

                        const collapseParent =
                            link.closest(".collapse");

                        if (collapseParent) {

                            collapseParent.classList.add("show");

                            const toggleButton =
                                document.querySelector(
                                    `[data-bs-target="#${collapseParent.id}"]`
                                );

                            if (toggleButton) {
                                toggleButton.setAttribute(
                                    "aria-expanded",
                                    "true"
                                );
                            }
                        }
                    }
                });
        });
    </script>

    @await RenderSectionAsync(
    "Scripts",
        required: false
        )

</body>
</html>