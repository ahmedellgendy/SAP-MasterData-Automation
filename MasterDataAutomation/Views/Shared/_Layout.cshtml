<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - @AppBrand.AppName</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <style>
        body {
            background-color: #f4f6f9;
        }

        .sidebar {
            width: 260px;
            height: 100vh;
            min-height: 100vh;
            background: #1f2937;
            position: fixed;
            left: 0;
            top: 0;
            padding: 18px;
            overflow-y: auto;
            overflow-x: hidden;
            box-sizing: border-box;
            overscroll-behavior: contain;
        }

            .sidebar::-webkit-scrollbar {
                width: 6px;
            }

            .sidebar::-webkit-scrollbar-track {
                background: #1f2937;
            }

            .sidebar::-webkit-scrollbar-thumb {
                background: #4b5563;
                border-radius: 20px;
            }

                .sidebar::-webkit-scrollbar-thumb:hover {
                    background: #6b7280;
                }

        .sidebar-title {
            color: white;
            font-size: 20px;
            font-weight: 800;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sidebar-section {
            color: #9ca3af !important;
            font-size: 11px;
            letter-spacing: 1.2px;
            margin-top: 18px;
            margin-bottom: 8px;
            text-transform: uppercase;
            font-weight: 800;
        }

        .sidebar a,
        .sidebar-menu-toggle {
            display: flex;
            align-items: center;
            color: #d1d5db;
            text-decoration: none;
            padding: 10px 12px;
            border-radius: 10px;
            margin-bottom: 5px;
            font-size: 14px;
            transition: 0.15s ease;
            border: 0;
            background: transparent;
            width: 100%;
            text-align: left;
        }

            .sidebar a:hover,
            .sidebar-menu-toggle:hover {
                background: #374151;
                color: white;
            }

            .sidebar a i,
            .sidebar-menu-toggle i:first-child {
                margin-right: 10px;
                font-size: 16px;
                width: 20px;
                text-align: center;
            }

            .sidebar a.active {
                background: #2563eb;
                color: #fff;
            }

                .sidebar a.active i {
                    color: #fff;
                }

        .sidebar-submenu a {
            font-size: 13px;
            padding: 9px 12px 9px 42px;
            margin-bottom: 3px;
        }

        .sidebar-menu-toggle .chevron {
            margin-left: auto;
            font-size: 13px;
            transition: transform 0.2s ease;
        }

        .sidebar-menu-toggle[aria-expanded="true"] .chevron {
            transform: rotate(180deg);
        }

        .sidebar-footer {
            margin-top: 24px;
            padding-top: 14px;
            padding-bottom: 16px;
            border-top: 1px solid rgba(255,255,255,0.12);
        }

        .main-content {
            margin-left: 260px;
            padding: 25px;
        }

        .topbar {
            background: white;
            padding: 15px 25px;
            border-radius: 12px;
            margin-bottom: 25px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .content-card {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .action-card {
            transition: .25s;
            cursor: pointer;
        }

            .action-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 15px 30px rgba(0,0,0,.12) !important;
            }

            .action-card .card-body {
                min-height: 180px;
            }

            .action-card i {
                transition: .25s;
            }

            .action-card:hover i {
                transform: scale(1.2);
            }
    </style>
</head>

<body>

    <div class="sidebar">

        <div class="sidebar-title">
            <i class="bi bi-diagram-3"></i>
            @AppBrand.AppName
        </div>

        <div class="sidebar-section">
            Dashboard
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="ManagerDashboard" asp-action="Index">
                <i class="bi bi-speedometer2"></i>
                Admin Dashboard
            </a>
        }

        @if (User.IsInRole("Sales"))
        {
            <a asp-controller="SalesDashboard" asp-action="Index">
                <i class="bi bi-speedometer2"></i>
                Sales Dashboard
            </a>
        }

        @if (User.IsInRole("Manager"))
        {
            <a asp-controller="ManagerDashboard" asp-action="Index">
                <i class="bi bi-speedometer2"></i>
                Manager Dashboard
            </a>
        }

        @if (User.IsInRole("AccountsUser"))
        {
            <a asp-controller="ProductRequests" asp-action="Index">
                <i class="bi bi-file-earmark-plus"></i>
                Accounts Dashboard
            </a>
        }

        @if (User.IsInRole("AccountsManager"))
        {
            <a asp-controller="ProductAccountsManager" asp-action="Index">
                <i class="bi bi-clipboard-check"></i>
                Accounts Manager
            </a>
        }

        @if (User.IsInRole("ExecutiveManager"))
        {
            <a asp-controller="ProductExecutiveManager" asp-action="Index">
                <i class="bi bi-cash-coin"></i>
                Executive Dashboard
            </a>
        }

        @if (User.IsInRole("Sales")
                || User.IsInRole("Manager")
                || User.IsInRole("Admin")
                || User.IsInRole("AccountsUser")
                || User.IsInRole("AccountsManager")
                || User.IsInRole("ExecutiveManager"))
        {
            <div class="sidebar-section">
                Modules
            </div>
        }

        @if (User.IsInRole("Sales") || User.IsInRole("Manager") || User.IsInRole("Admin"))
        {
            <button class="sidebar-menu-toggle"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#customersMenu"
                    aria-expanded="false"
                    aria-controls="customersMenu">
                <i class="bi bi-people"></i>
                Customers
                <i class="bi bi-chevron-down chevron"></i>
            </button>

            <div class="collapse sidebar-submenu" id="customersMenu">

                @if (User.IsInRole("Sales") || User.IsInRole("Admin"))
                {
                    <a asp-controller="CustomerImport" asp-action="Create">
                        <i class="bi bi-person-plus"></i>
                        Create Customer
                    </a>

                    <a asp-controller="CustomerImport" asp-action="UploadToDraft">
                        <i class="bi bi-file-earmark-excel"></i>
                        Upload Excel
                    </a>

                    <a asp-controller="CustomerImport" asp-action="Draft">
                        <i class="bi bi-list-check"></i>
                        Draft Customers
                    </a>

                    <a asp-controller="CustomerImport" asp-action="RejectedForReview">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        Rejected Review
                    </a>
                }

                @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                {
                    <a asp-controller="ManagerDashboard" asp-action="SubmittedCustomers">
                        <i class="bi bi-send-check"></i>
                        Pending Customers
                    </a>

                    <a asp-controller="ManagerDashboard" asp-action="ApprovedCustomers">
                        <i class="bi bi-check-circle"></i>
                        Approved Customers
                    </a>

                    <a asp-controller="ManagerDashboard" asp-action="RejectedCustomers">
                        <i class="bi bi-x-circle"></i>
                        Rejected Customers
                    </a>

                    <a asp-controller="CustomerImport" asp-action="History">
                        <i class="bi bi-clock-history"></i>
                        SAP History
                    </a>
                }

            </div>
        }

        @if (User.Identity?.IsAuthenticated == true)
        {
            <button class="sidebar-menu-toggle"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#productsMenu"
                    aria-expanded="false"
                    aria-controls="productsMenu">
                <i class="bi bi-box-seam"></i>
                Products
                <i class="bi bi-chevron-down chevron"></i>
            </button>

            <div class="collapse sidebar-submenu" id="productsMenu">

                <a asp-controller="Products"
                   asp-action="Index"
                   class="sidebar-link">
                    <i class="bi bi-box-seam"></i>
                    Products Master
                </a>

                @if (User.IsInRole("Admin") || User.IsInRole("AccountsUser"))
                {
                    <a asp-controller="ProductRequests" asp-action="Index">
                        <i class="bi bi-file-earmark-plus"></i>
                        Product Requests
                    </a>
                }

                @if (User.IsInRole("Admin") || User.IsInRole("AccountsManager"))
                {
                    <a asp-controller="ProductAccountsManager" asp-action="Index">
                        <i class="bi bi-clipboard-check"></i>
                        Accounts Review
                    </a>
                }

                @if (User.IsInRole("Admin") || User.IsInRole("ExecutiveManager"))
                {
                    <a asp-controller="ProductExecutiveManager" asp-action="Index">
                        <i class="bi bi-cash-coin"></i>
                        Executive Pricing
                    </a>
                }

            </div>
        }

        @if (User.IsInRole("Admin"))
        {
            <div class="sidebar-section">
                Administration
            </div>

            <button class="sidebar-menu-toggle"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#adminMenu"
                    aria-expanded="false"
                    aria-controls="adminMenu">
                <i class="bi bi-shield-lock"></i>
                Admin Tools
                <i class="bi bi-chevron-down chevron"></i>
            </button>

            <div class="collapse sidebar-submenu" id="adminMenu">

                <a asp-controller="AdminUsers" asp-action="Index">
                    <i class="bi bi-people"></i>
                    Users Management
                </a>

                <a asp-controller="ActivityLogs" asp-action="Index">
                    <i class="bi bi-activity"></i>
                    Activity Logs
                </a>

                <a asp-controller="SystemSettings" asp-action="Index">
                    <i class="bi bi-gear"></i>
                    Settings
                </a>

            </div>
        }

        <div class="sidebar-footer">
            <div class="text-secondary small">
                Developed by
            </div>

            <div class="text-white fw-semibold small">
                @AppBrand.DeveloperName
            </div>
        </div>

    </div>

    <div class="main-content">

        <div class="topbar d-flex justify-content-between align-items-center">

            <div>
                <h5 class="mb-0">@ViewData["Title"]</h5>
                <small class="text-muted">@AppBrand.Description</small>
            </div>

            <div class="d-flex align-items-center gap-3">

                <span class="text-muted small">
                    <i class="bi bi-person-circle"></i>
                    @User.FindFirst("FullName")?.Value
                    -
                    @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                </span>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="m-0">
                    <button type="submit" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-box-arrow-right"></i>
                        Logout
                    </button>
                </form>

            </div>

        </div>

        @RenderBody()

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const currentPath = window.location.pathname.toLowerCase();

            document.querySelectorAll(".sidebar a[href]").forEach(link => {
                const linkPath = link.getAttribute("href")?.toLowerCase();

                if (!linkPath || linkPath === "#") {
                    return;
                }

                if (currentPath === linkPath || currentPath.startsWith(linkPath + "/")) {
                    link.classList.add("active");

                    const collapseParent = link.closest(".collapse");

                    if (collapseParent) {
                        collapseParent.classList.add("show");

                        const toggleButton = document.querySelector(`[data-bs-target="#${collapseParent.id}"]`);

                        if (toggleButton) {
                            toggleButton.setAttribute("aria-expanded", "true");
                        }
                    }
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>