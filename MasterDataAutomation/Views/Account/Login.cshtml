@* @model MasterDataAutomation.Web.ViewModels.LoginViewModel
@using MasterDataAutomation.Web.Common

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <title>
        Login - @AppBrand.AppName
    </title>

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <!-- ===================================================== -->
    <!-- Favicon -->
    <!-- ===================================================== -->

    <link rel="icon"
          type="image/png"
          href="~/images/fridayops-icon.png" />

    <!-- ===================================================== -->
    <!-- Bootstrap -->
    <!-- ===================================================== -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>

        body {
            min-height: 100vh;
            margin: 0;
            background: linear-gradient( 135deg, #0f172a 0%, #1e3c72 45%, #2a5298 100% );
            font-family: "Segoe UI", sans-serif;
        }

        /* =====================================================
                   Wrapper
                ===================================================== */

        .login-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 15px;
        }

        /* =====================================================
                   Card
                ===================================================== */

        .login-card {
            width: 100%;
            max-width: 980px;
            border-radius: 24px;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 25px 70px rgba(0, 0, 0, 0.28);
        }

        /* =====================================================
                   Brand Side
                ===================================================== */

        .brand-side {
            min-height: 560px;
            background: linear-gradient( 135deg, #1e3c72 0%, #2a5298 100% );
            color: #fff;
            padding: 50px 40px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        /* =====================================================
                   App Icon
                ===================================================== */

        .brand-icon {
            width: 78px;
            height: 78px;
            border-radius: 20px;
            margin-bottom: 24px;
            overflow: hidden;
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.18);
            box-shadow: 0 12px 28px rgba(15, 23, 42, 0.25);
        }

            .brand-icon img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        /* =====================================================
                   Brand Text
                ===================================================== */

        .brand-title {
            font-size: 44px;
            font-weight: 800;
            letter-spacing: -1px;
            margin-bottom: 10px;
        }

        .brand-subtitle {
            font-size: 18px;
            opacity: 0.9;
            line-height: 1.6;
            margin-bottom: 0;
        }

        /* =====================================================
                   Features
                ===================================================== */

        .feature-list {
            margin-top: 42px;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
            font-size: 15px;
            font-weight: 600;
            opacity: 0.95;
        }

            .feature-item i {
                width: 36px;
                height: 36px;
                border-radius: 10px;
                background: rgba(255, 255, 255, 0.14);
                border: 1px solid rgba(255, 255, 255, 0.12);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 16px;
            }

        /* =====================================================
                   Form Side
                ===================================================== */

        .form-side {
            min-height: 560px;
            padding: 50px 45px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        /* =====================================================
                   System Badge
                ===================================================== */

        .system-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: #eef4ff;
            color: #1e3c72;
            border-radius: 999px;
            padding: 7px 13px;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 18px;
        }

        /* =====================================================
                   Login Heading
                ===================================================== */

        .login-title {
            font-size: 30px;
            font-weight: 800;
            color: #1f2937;
        }

        .login-desc {
            color: #6b7280;
            font-size: 14px;
            line-height: 1.6;
        }

        /* =====================================================
                   Form
                ===================================================== */

        .form-label {
            font-weight: 700;
            color: #374151;
            font-size: 14px;
        }

        .input-icon {
            position: relative;
        }

            .input-icon i {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #9ca3af;
                z-index: 2;
            }

            .input-icon input {
                padding-left: 44px;
            }

        .form-control {
            padding-top: 13px;
            padding-bottom: 13px;
            border-radius: 12px;
            border: 1px solid #d1d5db;
        }

            .form-control:focus {
                border-color: #2a5298;
                box-shadow: 0 0 0 0.2rem rgba(42, 82, 152, 0.15);
            }

        /* =====================================================
                   Login Button
                ===================================================== */

        .btn-login {
            background: #1e3c72;
            border: none;
            padding: 13px;
            border-radius: 12px;
            font-weight: 800;
            transition: 0.2s;
        }

            .btn-login:hover {
                background: #2a5298;
                transform: translateY(-1px);
            }

        /* =====================================================
                   Footer
                ===================================================== */

        .footer-credit {
            margin-top: 25px;
            font-size: 13px;
            color: #9ca3af;
            text-align: center;
        }

        /* =====================================================
                   Responsive
                ===================================================== */

        @@media (max-width: 768px) {

            .login-wrapper {
                padding: 18px 12px;
            }

            .brand-side {
                min-height: auto;
                padding: 35px 28px;
            }

            .form-side {
                min-height: auto;
                padding: 35px 28px;
            }

            .brand-title {
                font-size: 34px;
            }

            .brand-subtitle {
                font-size: 16px;
            }

            .feature-list {
                margin-top: 30px;
            }

            .brand-icon {
                width: 68px;
                height: 68px;
            }
        }

    </style>

</head>

<body>

    <div class="login-wrapper">

        <div class="login-card">

            <div class="row g-0">

                <!-- ================================================= -->
                <!-- Brand Side -->
                <!-- ================================================= -->

                <div class="col-md-5">

                    <div class="brand-side">

                        <div>

                            <!-- App Icon -->

                            <div class="brand-icon">

                                <img src="~/images/fridayops-icon.png"
                                     alt="@AppBrand.AppName" />

                            </div>

                            <!-- App Name -->

                            <h1 class="brand-title">

                                @AppBrand.AppName

                            </h1>

                            <!-- App Description -->

                            <p class="brand-subtitle">

                                @AppBrand.Description

                            </p>

                            <!-- Features -->

                            <div class="feature-list">

                                <div class="feature-item">

                                    <i class="bi bi-diagram-3"></i>

                                    <span>
                                        Operations & Workflow
                                    </span>

                                </div>

                                <div class="feature-item">

                                    <i class="bi bi-database-check"></i>

                                    <span>
                                        CRM & Customer Care
                                    </span>

                                </div>

                                <div class="feature-item">

                                    <i class="bi bi-bar-chart-line"></i>

                                    <span>
                                        Sales Analytics
                                    </span>

                                </div>

                                <div class="feature-item">

                                    <i class="bi bi-database-check"></i>

                                    <span>
                                        Master Data Management
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- ================================================= -->
                <!-- Login Form Side -->
                <!-- ================================================= -->

                <div class="col-md-7">

                    <div class="form-side">

                        <!-- ================================================= -->
                        <!-- Header -->
                        <!-- ================================================= -->

                        <div class="mb-4">

                            <span class="system-badge">

                                <i class="bi bi-building"></i>

                                @AppBrand.CompanyName Operations System

                            </span>

                            <h2 class="login-title mb-2">

                                Welcome Back

                            </h2>

                            <p class="login-desc mb-0">

                                Sign in to access operations,
                                analytics and master data.

                            </p>

                        </div>

                        <!-- ================================================= -->
                        <!-- Error -->
                        <!-- ================================================= -->
                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger d-flex align-items-center gap-2">

                                <i class="bi bi-exclamation-triangle-fill"></i>

                                <span>
                                    @TempData["Error"]
                                </span>

                            </div>
                        }

                        <!-- ================================================= -->
                        <!-- Login Form -->
                        <!-- ================================================= -->

                        <form asp-controller="Account"
                              asp-action="Login"
                              method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3">
                            </div>

                            <!-- Username -->

                            <div class="mb-3">

                                <label asp-for="UserName"
                                       class="form-label">

                                    Username

                                </label>

                                <div class="input-icon">

                                    <i class="bi bi-person"></i>

                                    <input asp-for="UserName"
                                           class="form-control"
                                           placeholder="Enter username"
                                           autocomplete="username" />

                                </div>

                                <span asp-validation-for="UserName"
                                      class="text-danger small">
                                </span>

                            </div>

                            <!-- Password -->

                            <div class="mb-4">

                                <label asp-for="Password"
                                       class="form-label">

                                    Password

                                </label>

                                <div class="input-icon">

                                    <i class="bi bi-lock"></i>

                                    <input asp-for="Password"
                                           type="password"
                                           class="form-control"
                                           placeholder="Enter password"
                                           autocomplete="current-password" />

                                </div>

                                <span asp-validation-for="Password"
                                      class="text-danger small">
                                </span>

                            </div>

                            <!-- Login Button -->

                            <button type="submit"
                                    class="btn btn-primary btn-login w-100">

                                <i class="bi bi-box-arrow-in-right"></i>

                                Login

                            </button>

                        </form>

                        <!-- ================================================= -->
                        <!-- Footer -->
                        <!-- ================================================= -->

                        <div class="footer-credit">

                            @AppBrand.CompanyName
                            ©
                            @DateTime.Now.Year
                            —
                            Developed by
                            @AppBrand.DeveloperName

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- Scripts -->
    <!-- ===================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <partial name="_ValidationScriptsPartial" />

</body>

</html> *@


@model MasterDataAutomation.Web.ViewModels.LoginViewModel
@using MasterDataAutomation.Web.Common

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <title>
        Login - @AppBrand.AppName
    </title>

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <link rel="icon"
          type="image/png"
          href="~/images/fridayops-icon.png" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>

        :root {
            --friday-navy: #081c3a;
            --friday-navy-soft: #102b55;
            --friday-blue: #164fa3;
            --friday-blue-light: #2f6fc3;
            --friday-ice: #78cfee;
            --friday-ice-soft: #eaf7fc;
            --text-primary: #142033;
            --text-secondary: #667085;
            --border-color: #dce3ec;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            font-family: "Segoe UI", sans-serif;
            background: radial-gradient( circle at 85% 12%, rgba(120, 207, 238, 0.30), transparent 26% ), radial-gradient( circle at 8% 90%, rgba(47, 111, 195, 0.22), transparent 28% ), linear-gradient( 135deg, #06172f 0%, #0c2b57 48%, #164fa3 100% );
        }

        /* =====================================================
                   Wrapper
                ===================================================== */

        .login-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 34px 18px;
        }

        /* =====================================================
                   Main Card
                ===================================================== */

        .login-card {
            width: 100%;
            max-width: 1080px;
            overflow: hidden;
            background: #fff;
            border-radius: 26px;
            border: 1px solid rgba(255, 255, 255, 0.10);
            box-shadow: 0 35px 90px rgba(0, 0, 0, 0.32);
        }

        /* =====================================================
                   Brand Side
                ===================================================== */

        .brand-side {
            min-height: 610px;
            padding: 48px 44px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            color: #fff;
            background: radial-gradient( circle at 100% 0%, rgba(120, 207, 238, 0.24), transparent 32% ), radial-gradient( circle at 20% 90%, rgba(255,255,255,.07), transparent 27% ), linear-gradient( 145deg, #071a35 0%, #102f5f 56%, #1959a9 100% );
        }

        /* =====================================================
                   Product Header
                ===================================================== */

        .product-header {
            display: flex;
            align-items: center;
            gap: 18px;
            margin-bottom: 20px;
        }

        .product-logo-box {
            width: 78px;
            height: 78px;
            flex: 0 0 78px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 18px;
            background: rgba(255, 255, 255, 0.10);
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.20);
            overflow: hidden;
        }

        .product-logo {
            width: 64px;
            height: 64px;
            object-fit: contain;
            display: block;
        }

        .product-header-text {
            min-width: 0;
        }

        /* =====================================================
                   FridayOps Branding
                ===================================================== */

        .product-label {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 7px;
            color: var(--friday-ice);
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.4px;
        }

        .product-title {
            margin: 0 0 7px 0;
            font-size: 44px;
            font-weight: 850;
            line-height: 1;
            letter-spacing: -1.3px;
        }

        .product-subtitle {
            margin-bottom: 0;
            color: rgba(255, 255, 255, 0.95);
            font-size: 16px;
            font-weight: 700;
        }

        .product-description {
            max-width: 390px;
            margin: 0;
            color: rgba(255, 255, 255, 0.73);
            font-size: 14px;
            line-height: 1.75;
        }

        /* =====================================================
                   Features
                ===================================================== */

        .feature-list {
            margin-top: 36px;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 13px;
            color: rgba(255, 255, 255, 0.94);
            font-size: 14px;
            font-weight: 650;
        }

        .feature-icon {
            width: 38px;
            height: 38px;
            flex: 0 0 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
            background: rgba(255, 255, 255, 0.10);
            border: 1px solid rgba(255, 255, 255, 0.13);
            color: #b8e9fa;
            font-size: 16px;
        }

        /* =====================================================
                   Brand Footer
                ===================================================== */

        .brand-footer {
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.12);
            color: rgba(255, 255, 255, 0.57);
            font-size: 12px;
        }

        /* =====================================================
                   Form Side
                ===================================================== */

        .form-side {
            min-height: 610px;
            padding: 58px 54px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: radial-gradient( circle at 100% 0%, rgba(120,207,238,.09), transparent 30% ), #fff;
        }

        /* =====================================================
                   System Badge
                ===================================================== */

        .system-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            width: fit-content;
            margin-bottom: 20px;
            padding: 7px 13px;
            background: var(--friday-ice-soft);
            border: 1px solid #ccecf7;
            border-radius: 999px;
            color: var(--friday-blue);
            font-size: 12px;
            font-weight: 800;
        }

        /* =====================================================
                   Login Header
                ===================================================== */

        .login-title {
            margin-bottom: 8px;
            color: var(--text-primary);
            font-size: 33px;
            font-weight: 850;
            letter-spacing: -0.5px;
        }

        .login-description {
            max-width: 440px;
            margin-bottom: 0;
            color: var(--text-secondary);
            font-size: 14px;
            line-height: 1.7;
        }

        /* =====================================================
                   Form
                ===================================================== */

        .form-label {
            color: #344054;
            font-size: 13px;
            font-weight: 750;
        }

        .input-icon {
            position: relative;
        }

            .input-icon i {
                position: absolute;
                left: 16px;
                top: 50%;
                z-index: 2;
                transform: translateY(-50%);
                color: #98a2b3;
            }

            .input-icon input {
                padding-left: 46px;
            }

        .form-control {
            min-height: 52px;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            color: #1d2939;
            font-size: 14px;
        }

            .form-control::placeholder {
                color: #98a2b3;
            }

            .form-control:focus {
                border-color: var(--friday-blue-light);
                box-shadow: 0 0 0 .2rem rgba(47,111,195,.13);
            }

        /* =====================================================
                   Login Button
                ===================================================== */

        .btn-login {
            min-height: 52px;
            border: none;
            border-radius: 12px;
            background: linear-gradient( 135deg, #123f84 0%, #1d5db2 100% );
            font-weight: 800;
            transition: .2s ease;
            box-shadow: 0 10px 22px rgba(22,79,163,.20);
        }

            .btn-login:hover {
                background: linear-gradient( 135deg, #0d3470 0%, #164f9a 100% );
                transform: translateY(-1px);
            }

        /* =====================================================
                   Footer
                ===================================================== */

        .footer-credit {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #edf1f5;
            color: #98a2b3;
            text-align: center;
            font-size: 12px;
        }

        /* =====================================================
                   Responsive
                ===================================================== */

        @@media (max-width: 768px) {

            .login-wrapper {
                padding: 16px 10px;
            }

            .login-card {
                border-radius: 20px;
            }

            .brand-side {
                min-height: auto;
                padding: 34px 28px;
            }

            .form-side {
                min-height: auto;
                padding: 38px 28px;
            }

            .product-header {
                align-items: center;
                gap: 14px;
            }

            .product-logo-box {
                width: 66px;
                height: 66px;
                flex-basis: 66px;
            }

            .product-logo {
                width: 54px;
                height: 54px;
            }

            .product-title {
                font-size: 36px;
            }

            .product-subtitle {
                font-size: 14px;
            }

            .product-label {
                font-size: 10px;
            }

            .brand-footer {
                display: none;
            }

            .feature-list {
                margin-top: 28px;
            }
        }

    </style>

</head>

<body>

    <div class="login-wrapper">

        <div class="login-card">

            <div class="row g-0">

                <!-- ================================================= -->
                <!-- Brand Side -->
                <!-- ================================================= -->

                <div class="col-md-5">

                    <div class="brand-side">

                        <div>

                            <!-- ================================================= -->
                            <!-- FridayOps Header -->
                            <!-- ================================================= -->

                            <div class="product-header">

                                <div class="product-logo-box">

                                    <img src="~/images/fridayops-icon.png"
                                         class="product-logo"
                                         alt="FridayOps" />

                                </div>

                                <div class="product-header-text">

                                    <div class="product-label">

                                        <i class="bi bi-snow2"></i>

                                        Internal Business Platform

                                    </div>

                                    <h1 class="product-title">

                                        FridayOps

                                    </h1>

                                    <div class="product-subtitle">

                                        Business Operations Platform

                                    </div>

                                </div>

                            </div>

                            <!-- ================================================= -->
                            <!-- Description -->
                            <!-- ================================================= -->

                            <p class="product-description">

                                Connecting teams, workflows and business
                                data across @AppBrand.CompanyName.

                            </p>

                            <!-- ================================================= -->
                            <!-- Modules -->
                            <!-- ================================================= -->

                            <div class="feature-list">

                                <div class="feature-item">

                                    <div class="feature-icon">

                                        <i class="bi bi-diagram-3"></i>

                                    </div>

                                    <span>
                                        Operations & Workflow
                                    </span>

                                </div>

                                <div class="feature-item">

                                    <div class="feature-icon">

                                        <i class="bi bi-headset"></i>

                                    </div>

                                    <span>
                                        CRM & Customer Care
                                    </span>

                                </div>

                                <div class="feature-item">

                                    <div class="feature-icon">

                                        <i class="bi bi-bar-chart-line"></i>

                                    </div>

                                    <span>
                                        Sales Analytics
                                    </span>

                                </div>

                                <div class="feature-item">

                                    <div class="feature-icon">

                                        <i class="bi bi-database-check"></i>

                                    </div>

                                    <span>
                                        Master Data Management
                                    </span>

                                </div>

                            </div>

                        </div>

                        <!-- ================================================= -->
                        <!-- Brand Footer -->
                        <!-- ================================================= -->

                        <div class="brand-footer">

                            Built for the internal operations of
                            @AppBrand.CompanyName

                        </div>

                    </div>

                </div>

                <!-- ================================================= -->
                <!-- Login Side -->
                <!-- ================================================= -->

                <div class="col-md-7">

                    <div class="form-side">

                        <!-- ================================================= -->
                        <!-- Header -->
                        <!-- ================================================= -->

                        <div class="mb-4">

                            <div class="system-badge">

                                <i class="bi bi-shield-check"></i>

                                @AppBrand.CompanyName
                                ·
                                Secure Internal Access

                            </div>

                            <h2 class="login-title">

                                Welcome to FridayOps

                            </h2>

                            <p class="login-description">

                                Sign in to continue to your workspace
                                and access the tools available for your role.

                            </p>

                        </div>

                        <!-- ================================================= -->
                        <!-- Error -->
                        <!-- ================================================= -->
                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger d-flex align-items-center gap-2">

                                <i class="bi bi-exclamation-triangle-fill"></i>

                                <span>
                                    @TempData["Error"]
                                </span>

                            </div>
                        }

                        <!-- ================================================= -->
                        <!-- Login Form -->
                        <!-- ================================================= -->

                        <form asp-controller="Account"
                              asp-action="Login"
                              method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3">
                            </div>

                            <!-- Username -->

                            <div class="mb-3">

                                <label asp-for="UserName"
                                       class="form-label">

                                    Username

                                </label>

                                <div class="input-icon">

                                    <i class="bi bi-person"></i>

                                    <input asp-for="UserName"
                                           class="form-control"
                                           placeholder="Enter username"
                                           autocomplete="username" />

                                </div>

                                <span asp-validation-for="UserName"
                                      class="text-danger small">
                                </span>

                            </div>

                            <!-- Password -->

                            <div class="mb-4">

                                <label asp-for="Password"
                                       class="form-label">

                                    Password

                                </label>

                                <div class="input-icon">

                                    <i class="bi bi-lock"></i>

                                    <input asp-for="Password"
                                           type="password"
                                           class="form-control"
                                           placeholder="Enter password"
                                           autocomplete="current-password" />

                                </div>

                                <span asp-validation-for="Password"
                                      class="text-danger small">
                                </span>

                            </div>

                            <!-- Sign In -->

                            <button type="submit"
                                    class="btn btn-primary btn-login w-100">

                                <i class="bi bi-box-arrow-in-right me-1"></i>

                                Sign In

                            </button>

                        </form>

                        <!-- ================================================= -->
                        <!-- Footer -->
                        <!-- ================================================= -->

                        <div class="footer-credit">

                            @AppBrand.CompanyName
                            ©
                            @DateTime.Now.Year

                            ·

                            FridayOps Internal Business Platform

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <partial name="_ValidationScriptsPartial" />

</body>

</html>

