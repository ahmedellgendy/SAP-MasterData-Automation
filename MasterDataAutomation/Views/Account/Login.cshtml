@model MasterDataAutomation.Web.ViewModels.LoginViewModel
@using MasterDataAutomation.Web.Common

@{
    Layout = null;
    ViewData["Title"] = "Login";
} 

 <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Login - @AppBrand.AppName</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0f172a 0%, #1e3c72 45%, #2a5298 100%);
            font-family: "Segoe UI", sans-serif;
        }

        .login-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 15px;
        }

        .login-card {
            width: 100%;
            max-width: 980px;
            border-radius: 24px;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 25px 70px rgba(0,0,0,0.28);
        }

        .brand-side {
            min-height: 560px;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: #fff;
            padding: 50px 40px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .brand-icon {
            width: 76px;
            height: 76px;
            border-radius: 22px;
            background: rgba(255,255,255,0.15);
            border: 1px solid rgba(255,255,255,0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            margin-bottom: 24px;
        }

        .brand-title {
            font-size: 44px;
            font-weight: 800;
            letter-spacing: -1px;
            margin-bottom: 10px;
        }

        .brand-subtitle {
            font-size: 18px;
            opacity: 0.9;
            line-height: 1.6;
            margin-bottom: 0;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
            font-size: 15px;
            opacity: 0.95;
        }

            .feature-item i {
                width: 34px;
                height: 34px;
                border-radius: 10px;
                background: rgba(255,255,255,0.14);
                display: flex;
                align-items: center;
                justify-content: center;
            }

        .developer-credit {
            font-size: 13px;
            opacity: 0.82;
        }

        .form-side {
            min-height: 560px;
            padding: 50px 45px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .system-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: #eef4ff;
            color: #1e3c72;
            border-radius: 999px;
            padding: 7px 13px;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 18px;
        }

        .login-title {
            font-size: 30px;
            font-weight: 800;
            color: #1f2937;
        }

        .login-desc {
            color: #6b7280;
        }

        .form-label {
            font-weight: 700;
            color: #374151;
        }

        .input-icon {
            position: relative;
        }

            .input-icon i {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #9ca3af;
            }

            .input-icon input {
                padding-left: 44px;
            }

        .form-control {
            padding-top: 13px;
            padding-bottom: 13px;
            border-radius: 12px;
            border: 1px solid #d1d5db;
        }

            .form-control:focus {
                border-color: #2a5298;
                box-shadow: 0 0 0 0.2rem rgba(42, 82, 152, 0.15);
            }

        .btn-login {
            background: #1e3c72;
            border: none;
            padding: 13px;
            border-radius: 12px;
            font-weight: 800;
            transition: 0.2s;
        }

            .btn-login:hover {
                background: #2a5298;
                transform: translateY(-1px);
            }

        .footer-credit {
            margin-top: 25px;
            font-size: 13px;
            color: #9ca3af;
            text-align: center;
        }

        @@media (max-width: 768px) {
            .brand-side {
                min-height: auto;
                padding: 35px 28px;
            }

            .form-side {
                min-height: auto;
                padding: 35px 28px;
            }

            .brand-title {
                font-size: 34px;
            }
        }
    </style>
</head>

<body>

    <div class="login-wrapper">
        <div class="login-card">
            <div class="row g-0">

                <div class="col-md-5">
                    <div class="brand-side">

                        <div>
                            <div class="brand-icon">
                                <i class="bi bi-diagram-3"></i>
                            </div>

                            <h1 class="brand-title">
                                @AppBrand.AppName
                            </h1>

                            <p class="brand-subtitle">
                                @AppBrand.Description
                            </p>
                        </div>

                        

                    </div>
                </div>

                <div class="col-md-7">
                    <div class="form-side">

                        <div class="mb-4">
                            <span class="system-badge">
                                <i class="bi bi-building"></i>
                                @AppBrand.CompanyName Internal System
                            </span>

                            <h2 class="login-title mb-2">
                                Welcome Back
                            </h2>

                            <p class="login-desc mb-0">
                                Sign in to continue to @AppBrand.AppName.
                            </p>
                        </div>

                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger d-flex align-items-center gap-2">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                <span>@TempData["Error"]</span>
                            </div>
                        }

                        <form asp-controller="Account" asp-action="Login" method="post">

                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="mb-3">
                                <label asp-for="UserName" class="form-label">
                                    Username
                                </label>

                                <div class="input-icon">
                                    <i class="bi bi-person"></i>
                                    <input asp-for="UserName"
                                           class="form-control"
                                           placeholder="Enter username"
                                           autocomplete="username" />
                                </div>

                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Password" class="form-label">
                                    Password
                                </label>

                                <div class="input-icon">
                                    <i class="bi bi-lock"></i>
                                    <input asp-for="Password"
                                           type="password"
                                           class="form-control"
                                           placeholder="Enter password"
                                           autocomplete="current-password" />
                                </div>

                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-primary btn-login w-100">
                                <i class="bi bi-box-arrow-in-right"></i>
                                Login
                            </button>

                        </form>

                        <div class="footer-credit">
                            @AppBrand.CompanyName © @DateTime.Now.Year — Developed by @AppBrand.DeveloperName
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

</body>
</html>

@* @model MasterDataAutomation.Web.ViewModels.LoginViewModel
@using MasterDataAutomation.Web.Common

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Login - @AppBrand.AppName</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        :root {
            --navy: #06172e;
            --navy-2: #0b2447;
            --ice-blue: #00aaff;
            --ice-blue-2: #38d5ff;
            --surface: #ffffff;
            --muted: #667085;
            --text: #101828;
            --border: #d9e2ef;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            font-family: "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
            background:
                radial-gradient(circle at 15% 20%, rgba(0, 170, 255, 0.22), transparent 30%),
                radial-gradient(circle at 85% 75%, rgba(56, 213, 255, 0.18), transparent 32%),
                linear-gradient(135deg, #030b18 0%, #071d3a 45%, #0b2447 100%);
            overflow-x: hidden;
        }

        .page-shell {
            min-height: 100vh;
            padding: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .page-shell::before,
        .page-shell::after {
            content: "";
            position: absolute;
            border-radius: 999px;
            filter: blur(2px);
            opacity: 0.7;
            pointer-events: none;
        }

        .page-shell::before {
            width: 420px;
            height: 420px;
            left: -150px;
            top: -150px;
            background: radial-gradient(circle, rgba(0,170,255,0.35), transparent 65%);
        }

        .page-shell::after {
            width: 520px;
            height: 520px;
            right: -190px;
            bottom: -190px;
            background: radial-gradient(circle, rgba(56,213,255,0.22), transparent 65%);
        }

        .login-frame {
            width: 100%;
            max-width: 1180px;
            min-height: 650px;
            border-radius: 30px;
            overflow: hidden;
            background: rgba(255,255,255,0.96);
            box-shadow:
                0 35px 90px rgba(0, 0, 0, 0.35),
                inset 0 0 0 1px rgba(255,255,255,0.7);
            position: relative;
            z-index: 2;
        }

        .brand-panel {
            min-height: 650px;
            padding: 52px 48px;
            color: #fff;
            background:
                linear-gradient(150deg, rgba(3, 15, 34, 0.96) 0%, rgba(8, 37, 76, 0.94) 52%, rgba(0, 135, 214, 0.55) 100%),
                radial-gradient(circle at 20% 20%, rgba(56, 213, 255, 0.25), transparent 35%);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .brand-panel::before {
            content: "";
            position: absolute;
            width: 420px;
            height: 220px;
            right: -140px;
            bottom: 70px;
            background: linear-gradient(135deg, rgba(255,255,255,0.18), rgba(56,213,255,0.06));
            transform: rotate(-18deg);
            border-radius: 42px;
            border: 1px solid rgba(255,255,255,0.12);
        }

        .brand-panel::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 190px;
            background:
                linear-gradient(to top, rgba(0,0,0,0.35), transparent),
                radial-gradient(circle at 30% 95%, rgba(255,255,255,0.20), transparent 32%);
        }

        .brand-content {
            position: relative;
            z-index: 2;
        }

        .brand-mark {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 52px;
        }

        .brand-logo {
            width: 72px;
            height: 72px;
            border-radius: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            background:
                linear-gradient(135deg, rgba(255,255,255,0.22), rgba(0,170,255,0.18));
            border: 1px solid rgba(255,255,255,0.28);
            box-shadow: 0 18px 38px rgba(0, 170, 255, 0.22);
            backdrop-filter: blur(12px);
        }

        .brand-logo i {
            font-size: 38px;
            color: #eaf9ff;
        }

        .brand-name {
            font-size: 38px;
            font-weight: 900;
            letter-spacing: -1.2px;
            line-height: 1;
        }

        .brand-name .ops-word {
            color: var(--ice-blue-2);
        }

        .brand-company {
            color: rgba(255,255,255,0.72);
            font-size: 14px;
            margin-top: 7px;
        }

        .hero-title {
            font-size: 34px;
            font-weight: 850;
            line-height: 1.15;
            margin-bottom: 18px;
            max-width: 430px;
        }

        .hero-text {
            color: rgba(255,255,255,0.78);
            font-size: 15px;
            line-height: 1.8;
            max-width: 420px;
            margin-bottom: 34px;
        }

        .feature-list {
            display: grid;
            gap: 14px;
            max-width: 420px;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 13px 14px;
            border-radius: 16px;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            backdrop-filter: blur(10px);
        }

        .feature-item i {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            background: rgba(0,170,255,0.22);
            color: #dff8ff;
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
        }

        .feature-item span {
            font-size: 14px;
            color: rgba(255,255,255,0.9);
            font-weight: 600;
        }

        .brand-footer {
            position: relative;
            z-index: 2;
            color: rgba(255,255,255,0.72);
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .brand-footer strong {
            color: #fff;
        }

        .form-panel {
            min-height: 650px;
            padding: 58px 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            background:
                linear-gradient(135deg, rgba(255,255,255,0.98), rgba(244,249,255,0.96));
        }

        .form-box {
            width: 100%;
            max-width: 450px;
        }

        .system-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #eaf6ff;
            color: #075985;
            border: 1px solid #cdefff;
            border-radius: 999px;
            padding: 8px 14px;
            font-size: 13px;
            font-weight: 800;
            margin-bottom: 22px;
        }

        .login-title {
            font-size: 34px;
            font-weight: 900;
            color: var(--text);
            letter-spacing: -0.8px;
            margin-bottom: 8px;
        }

        .login-desc {
            color: var(--muted);
            margin-bottom: 32px;
            line-height: 1.7;
        }

        .form-label {
            color: #344054;
            font-weight: 800;
            font-size: 14px;
            margin-bottom: 8px;
        }

        .input-shell {
            position: relative;
        }

        .input-shell i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #8aa0b8;
            font-size: 17px;
        }

        .input-shell input {
            height: 52px;
            padding-left: 44px;
            border-radius: 14px;
            border: 1px solid var(--border);
            color: var(--text);
            font-weight: 600;
            background: #fff;
            box-shadow: 0 8px 18px rgba(15, 23, 42, 0.04);
        }

        .input-shell input::placeholder {
            color: #98a2b3;
            font-weight: 500;
        }

        .input-shell input:focus {
            border-color: var(--ice-blue);
            box-shadow: 0 0 0 0.22rem rgba(0, 170, 255, 0.16);
        }

        .btn-login {
            width: 100%;
            height: 54px;
            border: none;
            border-radius: 14px;
            font-weight: 900;
            color: #fff;
            background: linear-gradient(135deg, #0078ff 0%, #0051c8 100%);
            box-shadow: 0 16px 28px rgba(0, 91, 210, 0.25);
            transition: all 0.18s ease;
        }

        .btn-login:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 20px 34px rgba(0, 91, 210, 0.33);
        }

        .security-note {
            margin-top: 22px;
            padding: 14px 15px;
            border-radius: 16px;
            background: #f3f8ff;
            border: 1px solid #e0efff;
            color: #667085;
            font-size: 13px;
            display: flex;
            gap: 10px;
            align-items: flex-start;
        }

        .security-note i {
            color: #0078ff;
            font-size: 18px;
            margin-top: 1px;
        }

        .footer-credit {
            margin-top: 30px;
            color: #98a2b3;
            font-size: 13px;
            text-align: center;
        }

        .footer-credit strong {
            color: #667085;
        }

        @@media (max-width: 991px) {
            .page-shell {
                padding: 18px;
            }

            .brand-panel,
            .form-panel {
                min-height: auto;
            }

            .brand-panel {
                padding: 36px 28px;
            }

            .form-panel {
                padding: 38px 28px;
            }

            .brand-mark {
                margin-bottom: 34px;
            }

            .hero-title {
                font-size: 28px;
            }
        }

        @@media (max-width: 575px) {
            .login-frame {
                border-radius: 22px;
            }

            .brand-name {
                font-size: 30px;
            }

            .brand-logo {
                width: 58px;
                height: 58px;
                border-radius: 18px;
            }

            .login-title {
                font-size: 28px;
            }
        }
    </style>
</head>

<body>

    <main class="page-shell">
        <div class="login-frame">
            <div class="row g-0">

                <div class="col-lg-5">
                    <section class="brand-panel">

                        <div class="brand-content">

                            <div class="brand-mark">
                                <div class="brand-logo">
                                    <i class="bi bi-snow2"></i>
                                </div>

                                <div>
                                    <div class="brand-name">
                                        Friday<span class="ops-word">Ops</span>
                                    </div>

                                    <div class="brand-company">
                                        by @AppBrand.CompanyName
                                    </div>
                                </div>
                            </div>

                            <h1 class="hero-title">
                                Operations built for speed, control, and visibility.
                            </h1>

                            <p class="hero-text">
                                Manage master data, approvals, products, customers, and internal workflows through one secure enterprise platform.
                            </p>

                            <div class="feature-list">
                                <div class="feature-item">
                                    <i class="bi bi-diagram-3"></i>
                                    <span>Workflow automation across departments</span>
                                </div>

                                <div class="feature-item">
                                    <i class="bi bi-box-seam"></i>
                                    <span>Product and customer master data control</span>
                                </div>

                                <div class="feature-item">
                                    <i class="bi bi-shield-check"></i>
                                    <span>Role-based access for every team</span>
                                </div>
                            </div>

                        </div>

                        <div class="brand-footer">
                            <i class="bi bi-stars"></i>
                            <span>@AppBrand.Description</span>
                        </div>

                    </section>
                </div>

                <div class="col-lg-7">
                    <section class="form-panel">

                        <div class="form-box">

                            <span class="system-badge">
                                <i class="bi bi-building"></i>
                                @AppBrand.CompanyName Internal System
                            </span>

                            <h2 class="login-title">
                                Welcome back
                            </h2>

                            <p class="login-desc">
                                Sign in to continue to FridayOps and manage your operational workflow securely.
                            </p>

                            @if (TempData["Error"] != null)
                            {
                                <div class="alert alert-danger d-flex align-items-center gap-2">
                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                    <span>@TempData["Error"]</span>
                                </div>
                            }

                            <form asp-controller="Account" asp-action="Login" method="post">

                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                                <div class="mb-3">
                                    <label asp-for="UserName" class="form-label">
                                        Username
                                    </label>

                                    <div class="input-shell">
                                        <i class="bi bi-person"></i>
                                        <input asp-for="UserName"
                                               class="form-control"
                                               placeholder="Enter your username"
                                               autocomplete="username" />
                                    </div>

                                    <span asp-validation-for="UserName" class="text-danger small"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Password" class="form-label">
                                        Password
                                    </label>

                                    <div class="input-shell">
                                        <i class="bi bi-lock"></i>
                                        <input asp-for="Password"
                                               type="password"
                                               class="form-control"
                                               placeholder="Enter your password"
                                               autocomplete="current-password" />
                                    </div>

                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>

                                <button type="submit" class="btn btn-login">
                                    Sign In
                                    <i class="bi bi-arrow-right ms-2"></i>
                                </button>

                            </form>

                            <div class="security-note">
                                <i class="bi bi-shield-lock"></i>
                                <div>
                                    Secure access for authorized Friday Ice users only.
                                    All actions are controlled by user roles and permissions.
                                </div>
                            </div>

                            <div class="footer-credit">
                                @AppBrand.CompanyName © @DateTime.Now.Year —
                                Developed by <strong>@AppBrand.DeveloperName</strong>
                            </div>

                        </div>

