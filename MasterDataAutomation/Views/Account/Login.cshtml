@* 
@model MasterDataAutomation.Web.ViewModels.LoginViewModel
@using MasterDataAutomation.Web.Common

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Login - @AppBrand.AppName</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        :root {
            --navy: #0b2f4d;
            --navy-dark: #062033;
            --ice: #e8f8ff;
            --ice-2: #f6fcff;
            --blue: #16a7e8;
            --blue-dark: #087bb8;
            --text: #183247;
            --muted: #6b8193;
            --border: #cfe4f0;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            font-family: "Segoe UI", system-ui, sans-serif;
            background: var(--ice-2);
            color: var(--text);
            overflow-x: hidden;
        }

        .login-screen {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1.05fr 0.95fr;
        }

        .brand-zone {
            position: relative;
            overflow: hidden;
            padding: 56px;
            background: radial-gradient(circle at 20% 20%, rgba(255,255,255,0.35), transparent 28%), radial-gradient(circle at 82% 72%, rgba(22,167,232,0.35), transparent 34%), linear-gradient(135deg, #062033 0%, #0b2f4d 55%, #0f7fb6 100%);
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

            .brand-zone::before {
                content: "";
                position: absolute;
                width: 460px;
                height: 460px;
                right: -160px;
                top: -130px;
                border-radius: 90px;
                transform: rotate(28deg);
                background: linear-gradient(135deg, rgba(255,255,255,0.20), rgba(255,255,255,0.04));
                border: 1px solid rgba(255,255,255,0.16);
            }

            .brand-zone::after {
                content: "";
                position: absolute;
                width: 520px;
                height: 520px;
                left: -250px;
                bottom: -250px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(255,255,255,0.18), transparent 68%);
            }

        .ice-shape {
            position: absolute;
            border-radius: 24px;
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.18);
            backdrop-filter: blur(10px);
        }

            .ice-shape.shape-1 {
                width: 110px;
                height: 110px;
                right: 110px;
                top: 175px;
                transform: rotate(18deg);
            }

            .ice-shape.shape-2 {
                width: 78px;
                height: 78px;
                right: 250px;
                bottom: 150px;
                transform: rotate(-20deg);
            }

            .ice-shape.shape-3 {
                width: 145px;
                height: 70px;
                left: 70px;
                bottom: 90px;
                transform: rotate(10deg);
            }

        .brand-content,
        .brand-footer {
            position: relative;
            z-index: 2;
        }

        .brand-top {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .brand-logo {
            width: 68px;
            height: 68px;
            border-radius: 22px;
            background: rgba(255,255,255,0.14);
            border: 1px solid rgba(255,255,255,0.22);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 34px;
            box-shadow: 0 16px 35px rgba(0,0,0,0.18);
        }

        .brand-name {
            font-size: 38px;
            font-weight: 900;
            letter-spacing: -1px;
            line-height: 1;
        }

            .brand-name span {
                color: #7be4ff;
            }

        .brand-company {
            margin-top: 6px;
            font-size: 14px;
            color: rgba(255,255,255,0.72);
            font-weight: 600;
        }

        .brand-middle {
            margin-top: 85px;
            max-width: 520px;
        }

            .brand-middle h1 {
                font-size: 44px;
                line-height: 1.08;
                font-weight: 900;
                letter-spacing: -1.2px;
                margin-bottom: 18px;
            }

            .brand-middle p {
                color: rgba(255,255,255,0.78);
                font-size: 16px;
                line-height: 1.8;
                max-width: 470px;
                margin-bottom: 30px;
            }

        .module-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .module-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 13px;
            border-radius: 999px;
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.14);
            font-size: 13px;
            font-weight: 700;
            color: rgba(255,255,255,0.92);
        }

        .brand-footer {
            color: rgba(255,255,255,0.72);
            font-size: 13px;
        }

            .brand-footer strong {
                color: white;
            }

        .form-zone {
            min-height: 100vh;
            position: relative;
            padding: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle at 70% 12%, rgba(22,167,232,0.12), transparent 30%), linear-gradient(135deg, #ffffff 0%, #f4fbff 100%);
        }

            .form-zone::before {
                content: "";
                position: absolute;
                inset: 26px;
                border: 1px solid rgba(207, 228, 240, 0.8);
                border-radius: 30px;
                pointer-events: none;
            }

        .login-panel {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 430px;
        }

        .internal-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            border-radius: 999px;
            background: #e8f8ff;
            color: var(--blue-dark);
            border: 1px solid #bdeeff;
            font-size: 13px;
            font-weight: 800;
            margin-bottom: 24px;
        }

        .login-title {
            font-size: 38px;
            font-weight: 900;
            letter-spacing: -1px;
            color: var(--text);
            margin-bottom: 8px;
        }

        .login-subtitle {
            color: var(--muted);
            font-size: 15px;
            margin-bottom: 34px;
        }

        .form-label {
            font-size: 14px;
            font-weight: 800;
            color: #2b465c;
            margin-bottom: 8px;
        }

        .field-wrap {
            position: relative;
        }

            .field-wrap i.left-icon {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                color: #7d98aa;
                font-size: 17px;
            }

            .field-wrap .password-toggle {
                position: absolute;
                right: 14px;
                top: 50%;
                transform: translateY(-50%);
                border: 0;
                background: transparent;
                color: #7d98aa;
                padding: 4px;
            }

                .field-wrap .password-toggle:hover {
                    color: var(--blue-dark);
                }

        .form-control {
            height: 54px;
            border-radius: 16px;
            border: 1px solid var(--border);
            padding-left: 46px;
            padding-right: 46px;
            background: rgba(255,255,255,0.9);
            color: var(--text);
            font-weight: 650;
            box-shadow: 0 10px 24px rgba(11,47,77,0.05);
        }

            .form-control::placeholder {
                color: #9aabba;
                font-weight: 500;
            }

            .form-control:focus {
                border-color: var(--blue);
                box-shadow: 0 0 0 0.22rem rgba(22,167,232,0.16);
            }

        .btn-login {
            width: 100%;
            height: 54px;
            border: none;
            border-radius: 16px;
            font-weight: 900;
            color: white;
            background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
            box-shadow: 0 18px 32px rgba(8,123,184,0.25);
            transition: 0.17s ease;
        }

            .btn-login:hover {
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 22px 40px rgba(8,123,184,0.33);
            }

        .system-line {
            margin-top: 24px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--muted);
            font-size: 13px;
        }

            .system-line i {
                color: var(--blue-dark);
            }

        .footer-credit {
            margin-top: 36px;
            color: #91a5b4;
            font-size: 13px;
        }

            .footer-credit strong {
                color: #64748b;
            }

        .validation-summary-errors ul {
            margin-bottom: 0;
            padding-left: 18px;
        }

        @@media (max-width: 991px) {
            .login-screen {
                grid-template-columns: 1fr;
            }

            .brand-zone {
                min-height: auto;
                padding: 36px 28px;
            }

            .brand-middle {
                margin-top: 45px;
            }

                .brand-middle h1 {
                    font-size: 34px;
                }

            .form-zone {
                min-height: auto;
                padding: 42px 24px;
            }

                .form-zone::before {
                    display: none;
                }
        }

        @@media (max-width: 575px) {
            .brand-middle h1 {
                font-size: 30px;
            }

            .brand-name {
                font-size: 30px;
            }

            .brand-logo {
                width: 58px;
                height: 58px;
                border-radius: 18px;
            }

            .login-title {
                font-size: 32px;
            }
        }
    </style>
</head>

<body>

    <main class="login-screen">

        <section class="brand-zone">

            <div class="ice-shape shape-1"></div>
            <div class="ice-shape shape-2"></div>
            <div class="ice-shape shape-3"></div>

            <div class="brand-content">

                <div class="brand-top">
                    <div class="brand-logo">
                        <i class="bi bi-snow2"></i>
                    </div>

                    <div>
                        <div class="brand-name">
                            Friday<span>Ops</span>
                        </div>

                        <div class="brand-company">
                            @AppBrand.CompanyName Internal System
                        </div>
                    </div>
                </div>

                <div class="brand-middle">
                    <h1>
                        One workspace for internal operations.
                    </h1>

                    <p>
                        Manage customers, products, approvals, SAP preparation, and company workflows from one secure system.
                    </p>

                    <div class="module-pills">
                        <span class="module-pill">
                            <i class="bi bi-people"></i>
                            Customers
                        </span>

                        <span class="module-pill">
                            <i class="bi bi-box-seam"></i>
                            Products
                        </span>

                        <span class="module-pill">
                            <i class="bi bi-check2-circle"></i>
                            Approvals
                        </span>

                        <span class="module-pill">
                            <i class="bi bi-file-earmark-spreadsheet"></i>
                            SAP
                        </span>
                    </div>
                </div>

            </div>

            <div class="brand-footer">
                @AppBrand.Description — Developed by <strong>@AppBrand.DeveloperName</strong>
            </div>

        </section>

        <section class="form-zone">

            <div class="login-panel">

                <span class="internal-badge">
                    <i class="bi bi-shield-lock"></i>
                    Authorized access
                </span>

                <h1 class="login-title">
                    Sign in
                </h1>

                <p class="login-subtitle">
                    Use your Friday Ice account to continue.
                </p>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>@TempData["Error"]</span>
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label">
                            Username
                        </label>

                        <div class="field-wrap">
                            <i class="bi bi-person left-icon"></i>

                            <input asp-for="UserName"
                                   class="form-control"
                                   placeholder="Enter username"
                                   autocomplete="username" />
                        </div>

                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label">
                            Password
                        </label>

                        <div class="field-wrap">
                            <i class="bi bi-lock left-icon"></i>

                            <input asp-for="Password"
                                   id="passwordInput"
                                   type="password"
                                   class="form-control"
                                   placeholder="Enter password"
                                   autocomplete="current-password" />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword()"
                                    aria-label="Show or hide password">
                                <i class="bi bi-eye" id="passwordIcon"></i>
                            </button>
                        </div>

                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-login">
                        Login
                        <i class="bi bi-arrow-right ms-2"></i>
                    </button>

                </form>

                <div class="system-line">
                    <i class="bi bi-info-circle"></i>
                    <span>Internal system for Friday Ice team members only.</span>
                </div>

                <div class="footer-credit">
                    @AppBrand.CompanyName © @DateTime.Now.Year —
                    Developed by <strong>@AppBrand.DeveloperName</strong>
                </div>

            </div>

        </section>

    </main>

    <script>
        function togglePassword() {
            const input = document.getElementById("passwordInput");
            const icon = document.getElementById("passwordIcon");

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

</body>
</html> *@