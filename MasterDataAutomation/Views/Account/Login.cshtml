@model MasterDataAutomation.Web.ViewModels.LoginViewModel
@using MasterDataAutomation.Web.Common

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <title>
        Login - @AppBrand.AppName
    </title>

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <!-- ===================================================== -->
    <!-- Favicon -->
    <!-- ===================================================== -->

    <link rel="icon"
          type="image/png"
          href="~/images/fridayops-icon.png" />

    <!-- ===================================================== -->
    <!-- Bootstrap -->
    <!-- ===================================================== -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>

        body {
            min-height: 100vh;
            margin: 0;
            background: linear-gradient( 135deg, #0f172a 0%, #1e3c72 45%, #2a5298 100% );
            font-family: "Segoe UI", sans-serif;
        }

        /* =====================================================
                   Wrapper
                ===================================================== */

        .login-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 15px;
        }

        /* =====================================================
                   Card
                ===================================================== */

        .login-card {
            width: 100%;
            max-width: 980px;
            border-radius: 24px;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 25px 70px rgba(0, 0, 0, 0.28);
        }

        /* =====================================================
                   Brand Side
                ===================================================== */

        .brand-side {
            min-height: 560px;
            background: linear-gradient( 135deg, #1e3c72 0%, #2a5298 100% );
            color: #fff;
            padding: 50px 40px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        /* =====================================================
                   App Icon
                ===================================================== */

        .brand-icon {
            width: 78px;
            height: 78px;
            border-radius: 20px;
            margin-bottom: 24px;
            overflow: hidden;
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.18);
            box-shadow: 0 12px 28px rgba(15, 23, 42, 0.25);
        }

            .brand-icon img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        /* =====================================================
                   Brand Text
                ===================================================== */

        .brand-title {
            font-size: 44px;
            font-weight: 800;
            letter-spacing: -1px;
            margin-bottom: 10px;
        }

        .brand-subtitle {
            font-size: 18px;
            opacity: 0.9;
            line-height: 1.6;
            margin-bottom: 0;
        }

        /* =====================================================
                   Features
                ===================================================== */

        .feature-list {
            margin-top: 42px;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
            font-size: 15px;
            font-weight: 600;
            opacity: 0.95;
        }

            .feature-item i {
                width: 36px;
                height: 36px;
                border-radius: 10px;
                background: rgba(255, 255, 255, 0.14);
                border: 1px solid rgba(255, 255, 255, 0.12);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 16px;
            }

        /* =====================================================
                   Form Side
                ===================================================== */

        .form-side {
            min-height: 560px;
            padding: 50px 45px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        /* =====================================================
                   System Badge
                ===================================================== */

        .system-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: #eef4ff;
            color: #1e3c72;
            border-radius: 999px;
            padding: 7px 13px;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 18px;
        }

        /* =====================================================
                   Login Heading
                ===================================================== */

        .login-title {
            font-size: 30px;
            font-weight: 800;
            color: #1f2937;
        }

        .login-desc {
            color: #6b7280;
            font-size: 14px;
            line-height: 1.6;
        }

        /* =====================================================
                   Form
                ===================================================== */

        .form-label {
            font-weight: 700;
            color: #374151;
            font-size: 14px;
        }

        .input-icon {
            position: relative;
        }

            .input-icon i {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #9ca3af;
                z-index: 2;
            }

            .input-icon input {
                padding-left: 44px;
            }

        .form-control {
            padding-top: 13px;
            padding-bottom: 13px;
            border-radius: 12px;
            border: 1px solid #d1d5db;
        }

            .form-control:focus {
                border-color: #2a5298;
                box-shadow: 0 0 0 0.2rem rgba(42, 82, 152, 0.15);
            }

        /* =====================================================
                   Login Button
                ===================================================== */

        .btn-login {
            background: #1e3c72;
            border: none;
            padding: 13px;
            border-radius: 12px;
            font-weight: 800;
            transition: 0.2s;
        }

            .btn-login:hover {
                background: #2a5298;
                transform: translateY(-1px);
            }

        /* =====================================================
                   Footer
                ===================================================== */

        .footer-credit {
            margin-top: 25px;
            font-size: 13px;
            color: #9ca3af;
            text-align: center;
        }

        /* =====================================================
                   Responsive
                ===================================================== */

        @@media (max-width: 768px) {

            .login-wrapper {
                padding: 18px 12px;
            }

            .brand-side {
                min-height: auto;
                padding: 35px 28px;
            }

            .form-side {
                min-height: auto;
                padding: 35px 28px;
            }

            .brand-title {
                font-size: 34px;
            }

            .brand-subtitle {
                font-size: 16px;
            }

            .feature-list {
                margin-top: 30px;
            }

            .brand-icon {
                width: 68px;
                height: 68px;
            }
        }

    </style>

</head>

<body>

    <div class="login-wrapper">

        <div class="login-card">

            <div class="row g-0">

                <!-- ================================================= -->
                <!-- Brand Side -->
                <!-- ================================================= -->

                <div class="col-md-5">

                    <div class="brand-side">

                        <div>

                            <!-- App Icon -->

                            <div class="brand-icon">

                                <img src="~/images/fridayops-icon.png"
                                     alt="@AppBrand.AppName" />

                            </div>

                            <!-- App Name -->

                            <h1 class="brand-title">

                                @AppBrand.AppName

                            </h1>

                            <!-- App Description -->

                            <p class="brand-subtitle">

                                @AppBrand.Description

                            </p>

                            <!-- Features -->

                            <div class="feature-list">

                                <div class="feature-item">

                                    <i class="bi bi-diagram-3"></i>

                                    <span>
                                        Operations & Workflow
                                    </span>

                                </div>

                                <div class="feature-item">

                                    <i class="bi bi-bar-chart-line"></i>

                                    <span>
                                        Sales Analytics
                                    </span>

                                </div>

                                <div class="feature-item">

                                    <i class="bi bi-database-check"></i>

                                    <span>
                                        Master Data Management
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- ================================================= -->
                <!-- Login Form Side -->
                <!-- ================================================= -->

                <div class="col-md-7">

                    <div class="form-side">

                        <!-- ================================================= -->
                        <!-- Header -->
                        <!-- ================================================= -->

                        <div class="mb-4">

                            <span class="system-badge">

                                <i class="bi bi-building"></i>

                                @AppBrand.CompanyName Operations System

                            </span>

                            <h2 class="login-title mb-2">

                                Welcome Back

                            </h2>

                            <p class="login-desc mb-0">

                                Sign in to access operations,
                                analytics and master data.

                            </p>

                        </div>

                        <!-- ================================================= -->
                        <!-- Error -->
                        <!-- ================================================= -->
                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger d-flex align-items-center gap-2">

                                <i class="bi bi-exclamation-triangle-fill"></i>

                                <span>
                                    @TempData["Error"]
                                </span>

                            </div>
                        }

                        <!-- ================================================= -->
                        <!-- Login Form -->
                        <!-- ================================================= -->

                        <form asp-controller="Account"
                              asp-action="Login"
                              method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3">
                            </div>

                            <!-- Username -->

                            <div class="mb-3">

                                <label asp-for="UserName"
                                       class="form-label">

                                    Username

                                </label>

                                <div class="input-icon">

                                    <i class="bi bi-person"></i>

                                    <input asp-for="UserName"
                                           class="form-control"
                                           placeholder="Enter username"
                                           autocomplete="username" />

                                </div>

                                <span asp-validation-for="UserName"
                                      class="text-danger small">
                                </span>

                            </div>

                            <!-- Password -->

                            <div class="mb-4">

                                <label asp-for="Password"
                                       class="form-label">

                                    Password

                                </label>

                                <div class="input-icon">

                                    <i class="bi bi-lock"></i>

                                    <input asp-for="Password"
                                           type="password"
                                           class="form-control"
                                           placeholder="Enter password"
                                           autocomplete="current-password" />

                                </div>

                                <span asp-validation-for="Password"
                                      class="text-danger small">
                                </span>

                            </div>

                            <!-- Login Button -->

                            <button type="submit"
                                    class="btn btn-primary btn-login w-100">

                                <i class="bi bi-box-arrow-in-right"></i>

                                Login

                            </button>

                        </form>

                        <!-- ================================================= -->
                        <!-- Footer -->
                        <!-- ================================================= -->

                        <div class="footer-credit">

                            @AppBrand.CompanyName
                            ©
                            @DateTime.Now.Year
                            —
                            Developed by
                            @AppBrand.DeveloperName

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- Scripts -->
    <!-- ===================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <partial name="_ValidationScriptsPartial" />

</body>

</html>