@model MasterDataAutomation.Web.ViewModels.ProductMaster.AccountsManagerProductDashboardViewModel

@{
    ViewData["Title"] = "Accounts Review";
}

<div class="container-fluid mt-4 mb-4">

    <div class="mb-4">
        <h1 class="fw-bold mb-1" style="color:#2c3e50;">
            <i class="bi bi-clipboard-check"></i>
            Accounts Review
        </h1>

        <p class="text-muted mb-0">
            Review submitted product requests, edit data, approve or reject.
        </p>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <a asp-controller="ProductAccountsManager"
               asp-action="Submitted"
               class="card shadow-sm border-0 text-decoration-none h-100 action-card">
                <div class="card-body text-center">
                    <i class="bi bi-hourglass-split fs-1 text-warning d-block mb-3"></i>
                    <h5 class="text-dark">Pending Review</h5>
                    <h2 class="text-warning">@Model.PendingReviewCount</h2>
                    <small class="text-muted">Requests waiting for your decision</small>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="Products"
               asp-action="Index"
               class="card shadow-sm border-0 text-decoration-none h-100 action-card">
                <div class="card-body text-center">
                    <i class="bi bi-box-seam fs-1 text-primary d-block mb-3"></i>
                    <h5 class="text-dark">Products Master</h5>
                    <small class="text-muted">View existing products</small>
                </div>
            </a>
        </div>

    </div>

    <div class="card shadow-sm border-0" style="border-radius:0.75rem; overflow:hidden;">
        <div class="card-header bg-light fw-bold py-3 d-flex justify-content-between align-items-center">
            <span>
                <i class="bi bi-table"></i>
                Latest Requests Waiting Review
            </span>

            <a asp-controller="ProductAccountsManager"
               asp-action="Submitted"
               class="btn btn-outline-primary btn-sm">
                Review All
            </a>
        </div>

        @if (Model.RecentPendingRequests.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Item Code</th>
                            <th>Item Name</th>
                            <th class="text-end">Purchase Price</th>
                            <th class="text-center">Pieces</th>
                            <th class="text-end">Piece Price</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.RecentPendingRequests)
                        {
                            <tr>
                                <td><span class="badge bg-dark">@item.ItemCode</span></td>
                                <td class="fw-semibold">@item.ItemName</td>
                                <td class="text-end">@item.PurchasePrice.ToString("N2")</td>
                                <td class="text-center">@item.PiecesCount</td>
                                <td class="text-end">@item.PiecePrice.ToString("N2")</td>
                                <td class="text-end">
                                    <a asp-controller="ProductAccountsManager"
                                       asp-action="Submitted"
                                       class="btn btn-success btn-sm">
                                        Review
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-check2-circle fs-1 d-block mb-3 text-success"></i>
                <h5>No pending requests</h5>
                <p class="mb-0">All product requests have been reviewed.</p>
            </div>
        }
    </div>

</div>