@model MasterDataAutomation.Application.Modules.ProductMaster.Dtos.ProductRequestDto

@{
    ViewData["Title"] = "Edit Product Request";
}

<div class="container-fluid mt-4 mb-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1" style="color:#2c3e50;">
                <i class="bi bi-pencil-square"></i>
                Edit Product Request
            </h1>

            <p class="text-muted mb-0">
                Accounts manager can edit purchasing data before approval.
            </p>
        </div>

        <a asp-controller="ProductAccountsManager"
           asp-action="Submitted"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>

    <div class="card shadow-sm border-0" style="border-radius:0.75rem;">
        <div class="card-body">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ItemCode" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Item Code</label>
                        <input asp-for="ItemCode" class="form-control" readonly />
                        <small class="text-muted">Item code cannot be changed here.</small>
                    </div>

                    <div class="col-md-8">
                        <label class="form-label fw-semibold">Item Name</label>
                        <input asp-for="ItemName" class="form-control" />
                        <span asp-validation-for="ItemName" class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Purchase Price</label>
                        <input asp-for="PurchasePrice" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="PurchasePrice" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Pieces Count</label>
                        <input asp-for="PiecesCount" class="form-control" type="number" />
                        <span asp-validation-for="PiecesCount" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Current Piece Price</label>
                        <input value="@Model.PiecePrice.ToString("N2")"
                               class="form-control"
                               readonly />
                        <small class="text-muted">Will be recalculated after save.</small>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Currency</label>
                        <input asp-for="Currency" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Has Bonus?</label>

                        <div class="form-check form-switch mt-2">
                            <input asp-for="HasBonus" class="form-check-input" type="checkbox" />
                            <label class="form-check-label" asp-for="HasBonus">
                                Product has bonus
                            </label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Bonus Quantity</label>
                        <input asp-for="BonusQuantity" class="form-control" type="number" />
                    </div>

                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i>
                        Save Changes
                    </button>

                    <a asp-controller="ProductAccountsManager"
                       asp-action="Submitted"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>