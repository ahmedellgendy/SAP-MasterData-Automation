@model List<MasterDataAutomation.Application.Modules.ProductMaster.Dtos.ProductRequestDto>

@{
    ViewData["Title"] = "Submitted Product Requests";
    var totalRecords = Model?.Count ?? 0;
}

<div class="container-fluid mt-4 mb-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1" style="color:#2c3e50;">
                <i class="bi bi-clipboard-check"></i>
                Submitted Product Requests
            </h1>

            <p class="text-muted mb-0">
                Review product purchasing data before sending it to executive manager.
            </p>
        </div>

        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Back To Products
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success shadow-sm">
            <i class="bi bi-check-circle"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm">
            <i class="bi bi-exclamation-triangle"></i>
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm border-0" style="border-radius:0.75rem; overflow:hidden;">

        <div class="card-header bg-light py-3 fw-bold">
            <i class="bi bi-table"></i>
            Requests Waiting For Accounts Manager
            <span class="badge bg-primary ms-2">@totalRecords</span>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Item Code</th>
                            <th>Item Name</th>
                            <th class="text-end">Purchase Price</th>
                            <th class="text-center">Pieces</th>
                            <th class="text-end">Piece Price</th>
                            <th>Bonus</th>
                            <th>Currency</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <tr>
                                <td class="fw-bold">@(i + 1)</td>

                                <td>
                                    <span class="badge bg-dark">
                                        @Model[i].ItemCode
                                    </span>
                                </td>

                                <td class="fw-semibold">@Model[i].ItemName</td>

                                <td class="text-end">@Model[i].PurchasePrice.ToString("N2")</td>

                                <td class="text-center">@Model[i].PiecesCount</td>

                                <td class="text-end">@Model[i].PiecePrice.ToString("N2")</td>

                                <td>
                                    @if (Model[i].HasBonus)
                                    {
                                        <span class="badge bg-info text-dark">
                                            Yes (@Model[i].BonusQuantity)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>

                                <td>
                                    <span class="badge bg-secondary">@Model[i].Currency</span>
                                </td>

                                <td class="text-end">

                                    <a asp-controller="ProductAccountsManager"
                                       asp-action="Edit"
                                       asp-route-id="@Model[i].Id"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-pencil-square"></i>
                                        Edit
                                    </a>

                                    <form asp-controller="ProductAccountsManager"
                                          asp-action="Approve"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Approve this product request?');">
                                        <input type="hidden" name="id" value="@Model[i].Id" />

                                        <button type="submit" class="btn btn-success btn-sm">
                                            <i class="bi bi-check-circle"></i>
                                            Approve
                                        </button>
                                    </form>

                                    <form asp-controller="ProductAccountsManager"
                                          asp-action="Reject"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Reject this product request?');">
                                        <input type="hidden" name="id" value="@Model[i].Id" />

                                        <input type="text"
                                               name="rejectionReason"
                                               class="form-control form-control-sm d-inline-block"
                                               style="width:200px;"
                                               placeholder="Reason"
                                               required />

                                        <button type="submit" class="btn btn-danger btn-sm">
                                            <i class="bi bi-x-circle"></i>
                                            Reject
                                        </button>
                                    </form>

                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                <h5>No submitted product requests</h5>
                <p class="mb-0">Submitted requests will appear here after accounts user submits drafts.</p>
            </div>
        }

    </div>

</div>