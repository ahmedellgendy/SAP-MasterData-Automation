@model MasterDataAutomation.Application.Modules.SalesAnalytics.DashboardDtos.SalesAnalyticsDashboardDto
@using MasterDataAutomation.Application.Modules.SalesAnalytics.DashboardDtos
@using System.Text.Json

@{
    ViewData["Title"] = "CEO Sales Analytics";

    var targetSummary = Model.TargetSummary;

    DateTime selectedDate;
    if (!DateTime.TryParse(ViewBag.SelectedDate as string, out selectedDate))
    {
        selectedDate = Model.ReportDate.Date;
    }

    selectedDate = selectedDate.Date;

    var selectedMonthDays = DateTime.DaysInMonth(selectedDate.Year, selectedDate.Month);
    var elapsedDays = Math.Max(Math.Min(selectedDate.Day, selectedMonthDays), 1);

    var expectedPacePercentage = Math.Round(((decimal)elapsedDays / selectedMonthDays) * 100, 2);

    var expectedSalesToDate = targetSummary.TotalMonthlyTarget == 0
        ? 0
        : Math.Round((targetSummary.TotalMonthlyTarget * elapsedDays) / selectedMonthDays, 2);

    var salesPaceGap = targetSummary.ActualSalesToDate - expectedSalesToDate;
    var isAheadOfPace = salesPaceGap >= 0;

    var actualDailyRunRate = elapsedDays == 0
        ? 0
        : Math.Round(targetSummary.ActualSalesToDate / elapsedDays, 2);

    var visibleAlerts = Model.Alerts
        .Where(x => x.Title != "No Daily Data Uploaded")
        .ToList();

    var hasData =
        targetSummary.ActualSalesToDate > 0 ||
        targetSummary.ActualVisits > 0 ||
        targetSummary.TotalMonthlyTarget > 0 ||
        Model.TargetAchievements.Any() ||
        Model.LowestTargetAchievements.Any() ||
        Model.BestTargetAchievements.Any();

    var hasOperationalDetails =
        Model.Kpis.TotalSales > 0 ||
        Model.Kpis.TotalVisits > 0 ||
        Model.SalesByLines.Any() ||
        Model.VisitsBySalesReps.Any() ||
        Model.NegativeVisitReasons.Any() ||
        Model.BottomCustomersToday.Any() ||
        Model.TopProducts.Any();

    var branches = ViewBag.Branches as List<BranchOptionDto>
        ?? new List<BranchOptionDto>();

    var selectedBranchCode = ViewBag.SelectedBranchCode as string ?? string.Empty;

    var leadingBranch = Model.BranchPerformances
        .Where(x => x.ActualSales > 0 || x.AchievementPercentage > 0)
        .OrderByDescending(x => x.AchievementPercentage)
        .ThenByDescending(x => x.ActualSales)
        .FirstOrDefault();

    var weakestBranch = Model.BranchPerformances
        .Where(x => x.MonthlyTarget > 0)
        .OrderBy(x => x.AchievementPercentage)
        .ThenByDescending(x => x.MonthlyTarget)
        .FirstOrDefault();

    var topProduct = Model.TopProducts.FirstOrDefault();
    var topLine = Model.BestTargetAchievements.FirstOrDefault();
    var highestRiskLine = Model.LowestTargetAchievements.FirstOrDefault();
    var topNegativeReason = Model.NegativeVisitReasons.FirstOrDefault();

    var aiInsights = new List<string>();

    if (targetSummary.TotalMonthlyTarget > 0)
    {
        if (isAheadOfPace)
        {
            aiInsights.Add($"Sales performance is ahead of the expected monthly pace by {Money(Math.Abs(salesPaceGap))}.");
        }
        else
        {
            aiInsights.Add($"Sales performance is behind the expected monthly pace by {Money(Math.Abs(salesPaceGap))}. Immediate follow-up is recommended.");
        }
    }

    if (targetSummary.PlannedVisits > 0)
    {
        if (targetSummary.VisitAchievementPercentage < expectedPacePercentage)
        {
            aiInsights.Add($"Visit achievement is {Percent(targetSummary.VisitAchievementPercentage)} while the expected pace is {Percent(expectedPacePercentage)}. Field activity needs attention.");
        }
        else
        {
            aiInsights.Add($"Visit achievement is aligned with the expected monthly pace.");
        }
    }

    if (leadingBranch != null)
    {
        aiInsights.Add($"{leadingBranch.BranchName} is currently leading branch performance with {Percent(leadingBranch.AchievementPercentage)} achievement.");
    }

    if (weakestBranch != null && leadingBranch != null && weakestBranch.BranchCode != leadingBranch.BranchCode)
    {
        aiInsights.Add($"{weakestBranch.BranchName} requires follow-up; achievement is currently {Percent(weakestBranch.AchievementPercentage)}.");
    }

    if (targetSummary.CriticalLinesCount > 0)
    {
        aiInsights.Add($"{targetSummary.CriticalLinesCount} sales lines are below 50% achievement and should be reviewed by sales management.");
    }

    if (topProduct != null)
    {
        aiInsights.Add($"Top product to date is {topProduct.ProductName}, generating {Money(topProduct.TotalSales)}.");
    }

    if (topNegativeReason != null)
    {
        aiInsights.Add($"Most repeated negative visit reason is '{topNegativeReason.Reason}' with {topNegativeReason.Count} records.");
    }

    if (!aiInsights.Any())
    {
        aiInsights.Add("No critical insights detected for the selected date. Continue monitoring daily uploads and target progress.");
    }

    var executiveStatus = isAheadOfPace
        ? "Ahead of Pace"
        : "Behind Pace";

    var executiveStatusClass = isAheadOfPace
        ? "pace-good"
        : "pace-risk";

    string Money(decimal value) => $"{value:N0} EGP";
    string Number(decimal value) => $"{value:N0}";
    string Percent(decimal value) => $"{value:N2}%";
}

