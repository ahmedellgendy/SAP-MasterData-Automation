@model MasterDataAutomation.Application.Modules.SalesAnalytics.DashboardDtos.SalesAnalyticsDashboardDto
@using MasterDataAutomation.Application.Modules.SalesAnalytics.DashboardDtos

@{
    ViewData["Title"] = "CEO Sales Analytics";

    var hasData =
        Model.Kpis.TotalSales > 0 ||
        Model.Kpis.TotalVisits > 0 ||
        Model.SalesByLines.Any() ||
        Model.VisitsBySalesReps.Any() ||
        Model.TargetAchievements.Any();

    var branches = ViewBag.Branches as List<BranchOptionDto>
        ?? new List<BranchOptionDto>();

    var selectedBranchCode = ViewBag.SelectedBranchCode as string ?? string.Empty;

    string Money(decimal value) => $"{value:N0} EGP";
    string Number(decimal value) => $"{value:N0}";
    string Percent(decimal value) => $"{value:N2}%";
}

<style>
    .dashboard-page {
        max-width: 1500px;
        margin: 0 auto;
    }

    .dashboard-hero {
        background: linear-gradient(135deg, #0b2a5b, #123a78);
        color: #fff;
        border-radius: 20px;
        padding: 26px;
        margin-bottom: 22px;
        box-shadow: 0 14px 32px rgba(15, 23, 42, .16);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
    }

    .hero-title {
        font-size: 28px;
        font-weight: 900;
        margin-bottom: 6px;
    }

    .hero-subtitle {
        color: rgba(255,255,255,.78);
        font-size: 14px;
        font-weight: 600;
    }

    .date-filter {
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 14px;
        padding: 14px;
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }

        .date-filter input,
        .date-filter select {
            border: none;
            border-radius: 10px;
            padding: 10px 12px;
            font-weight: 800;
        }

    .btn-filter {
        background: #fff;
        color: #0b2a5b;
        border: none;
        border-radius: 10px;
        padding: 10px 14px;
        font-weight: 900;
    }

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .kpi-card {
        background: #fff;
        border-radius: 18px;
        padding: 20px;
        border: 1px solid #edf0f5;
        box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
    }

    .kpi-label {
        color: #64748b;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .kpi-value {
        color: #0f172a;
        font-size: 25px;
        font-weight: 950;
    }

    .kpi-hint {
        color: #94a3b8;
        font-size: 12px;
        font-weight: 700;
        margin-top: 6px;
    }

    .section-grid {
        display: grid;
        grid-template-columns: 1.2fr .8fr;
        gap: 18px;
        margin-bottom: 18px;
    }

    .panel {
        background: #fff;
        border-radius: 18px;
        padding: 20px;
        border: 1px solid #edf0f5;
        box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
    }

    .panel-title {
        font-size: 18px;
        font-weight: 950;
        color: #0f172a;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .table {
        margin-bottom: 0;
        vertical-align: middle;
    }

        .table thead th {
            color: #475569;
            font-size: 12px;
            font-weight: 900;
            background: #f8fafc;
            border-bottom: 1px solid #e5e7eb;
            white-space: nowrap;
        }

        .table tbody td {
            font-size: 13px;
            font-weight: 700;
            color: #334155;
        }

    .line-name,
    .customer-name,
    .product-name {
        font-weight: 900;
        color: #0f172a;
    }

    .muted-code {
        color: #94a3b8;
        font-size: 12px;
        font-weight: 800;
    }

    .badge-soft {
        display: inline-flex;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 900;
        background: #f1f5f9;
        color: #475569;
    }

    .badge-positive {
        background: #dcfce7;
        color: #166534;
    }

    .badge-negative {
        background: #fee2e2;
        color: #991b1b;
    }

    .progress-line {
        height: 8px;
        background: #e5e7eb;
        border-radius: 999px;
        overflow: hidden;
        min-width: 90px;
    }

    .progress-fill {
        height: 100%;
        background: #0b2a5b;
        border-radius: 999px;
    }

    .empty-state {
        background: #fff7ed;
        border: 1px solid #fed7aa;
        color: #9a3412;
        padding: 18px;
        border-radius: 16px;
        font-weight: 800;
        margin-bottom: 18px;
    }

    .target-note {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1e3a8a;
        border-radius: 14px;
        padding: 14px 16px;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 18px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        line-height: 1.7;
    }


        .target-note i {
            font-size: 18px;
            margin-top: 2px;
        }

    .alerts-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 22px;
    }

    .ceo-alert {
        background: #fff;
        border-radius: 16px;
        padding: 16px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .06);
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }

    .ceo-alert-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .ceo-alert-title {
        font-size: 14px;
        font-weight: 950;
        color: #0f172a;
        margin-bottom: 5px;
    }

    .ceo-alert-message {
        font-size: 12px;
        font-weight: 700;
        color: #64748b;
        line-height: 1.6;
    }

    .ceo-alert-critical {
        border-color: #fecaca;
        background: #fff5f5;
    }

        .ceo-alert-critical .ceo-alert-icon {
            background: #fee2e2;
            color: #991b1b;
        }

    .ceo-alert-warning {
        border-color: #fed7aa;
        background: #fff7ed;
    }

        .ceo-alert-warning .ceo-alert-icon {
            background: #ffedd5;
            color: #9a3412;
        }

    .ceo-alert-info {
        border-color: #bfdbfe;
        background: #eff6ff;
    }

        .ceo-alert-info .ceo-alert-icon {
            background: #dbeafe;
            color: #1e3a8a;
        }
    @@media (max-width: 1100px) {
        .kpi-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .section-grid {
            grid-template-columns: 1fr;
        }

        .alerts-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 650px) {
        .kpi-grid {
            grid-template-columns: 1fr;
        }

        .hero-title {
            font-size: 22px;
        }
    }
</style>

<div class="dashboard-page">

    <div class="dashboard-hero">
        <div>
            <div class="hero-title">
                CEO Sales Analytics Dashboard
            </div>
            <div class="hero-subtitle">
                Executive overview for sales, visits, customers, products, targets, and field activity.
            </div>
        </div>

        <form asp-controller="SalesAnalyticsDashboard"
              asp-action="Index"
              method="get"
              class="date-filter">

            <input type="date"
                   name="reportDate"
                   value="@ViewBag.SelectedDate" />

            <select name="branchCode">
                <option value="">All Branches</option>

                @foreach (var branch in branches)
                {
                    if (selectedBranchCode == branch.BranchCode)
                    {
                        <option value="@branch.BranchCode" selected>
                            @branch.BranchName
                        </option>
                    }
                    else
                    {
                        <option value="@branch.BranchCode">
                            @branch.BranchName
                        </option>
                    }
                }
            </select>

            <button type="submit" class="btn-filter">
                <i class="bi bi-funnel"></i>
                Apply
            </button>
        </form>
    </div>

    @if (Model.Alerts.Any())
    {
        <div class="alerts-grid">
            @foreach (var alert in Model.Alerts)
            {
                var alertClass = alert.Severity switch
                {
                    "Critical" => "ceo-alert-critical",
                    "Warning" => "ceo-alert-warning",
                    _ => "ceo-alert-info"
                };

                <div class="ceo-alert @alertClass">
                    <div class="ceo-alert-icon">
                        <i class="bi @alert.Icon"></i>
                    </div>

                    <div>
                        <div class="ceo-alert-title">
                            @alert.Title
                        </div>

                        <div class="ceo-alert-message">
                            @alert.Message
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (!hasData)
    {
        <div class="empty-state">
            No sales analytics data found for this date. اختار تاريخ التقرير اللي اترفع، مثلًا 2026-07-22.
        </div>
    }

    <div class="kpi-grid">

        <div class="kpi-card">
            <div class="kpi-label">Total Sales</div>
            <div class="kpi-value">@Money(Model.Kpis.TotalSales)</div>
            <div class="kpi-hint">From daily SalesBuzz sales report</div>
        </div>

        <div class="kpi-card">
            <div class="kpi-label">Total Quantity</div>
            <div class="kpi-value">@Number(Model.Kpis.TotalQuantity)</div>
            <div class="kpi-hint">Total sold quantity</div>
        </div>

        <div class="kpi-card">
            <div class="kpi-label">Total Visits</div>
            <div class="kpi-value">@Model.Kpis.TotalVisits</div>
            <div class="kpi-hint">All recorded visits</div>
        </div>

        <div class="kpi-card">
            <div class="kpi-label">Positive Visit %</div>
            <div class="kpi-value">@Percent(Model.Kpis.PositiveVisitPercentage)</div>
            <div class="kpi-hint">
                @Model.Kpis.PositiveVisits positive / @Model.Kpis.NegativeVisits negative
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-label">Positive Visits</div>
            <div class="kpi-value">@Model.Kpis.PositiveVisits</div>
            <div class="kpi-hint">Successful visits</div>
        </div>

        <div class="kpi-card">
            <div class="kpi-label">Negative Visits</div>
            <div class="kpi-value">@Model.Kpis.NegativeVisits</div>
            <div class="kpi-hint">Visits without sales</div>
        </div>

        <div class="kpi-card">
            <div class="kpi-label">Active Sales Reps</div>
            <div class="kpi-value">@Model.Kpis.ActiveSalesReps</div>
            <div class="kpi-hint">Reps appeared in visits report</div>
        </div>

        <div class="kpi-card">
            <div class="kpi-label">Average Visit Value</div>
            <div class="kpi-value">@Money(Model.Kpis.AverageVisitValue)</div>
            <div class="kpi-hint">Average successful visit value</div>
        </div>

    </div>

    @{
        var targetSummary = Model.TargetSummary;
    }

    <div class="kpi-grid">

        <div class="kpi-card">
            <div class="kpi-label">Monthly Target</div>
            <div class="kpi-value">@Money(targetSummary.TotalMonthlyTarget)</div>
            <div class="kpi-hint">Total target for selected month</div>
        </div>

        <div class="kpi-card">
            <div class="kpi-label">Actual Sales MTD</div>
            <div class="kpi-value">@Money(targetSummary.ActualSalesToDate)</div>
            <div class="kpi-hint">Uploaded sales from month start to selected date</div>
        </div>

        <div class="kpi-card">
            <div class="kpi-label">Target Achievement</div>
            <div class="kpi-value">@Percent(targetSummary.AchievementPercentage)</div>
            <div class="kpi-hint">
                Remaining: @Money(targetSummary.RemainingTarget)
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-label">Required Daily Sales</div>
            <div class="kpi-value">@Money(targetSummary.RequiredDailySales)</div>
            <div class="kpi-hint">Needed per day to reach monthly target</div>
        </div>

    </div>

    <div class="kpi-grid">

        <div class="kpi-card">
            <div class="kpi-label">Visit Achievement</div>
            <div class="kpi-value">@Percent(targetSummary.VisitAchievementPercentage)</div>
            <div class="kpi-hint">
                @targetSummary.ActualVisits actual / @targetSummary.PlannedVisits planned
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-label">Critical Lines</div>
            <div class="kpi-value">@targetSummary.CriticalLinesCount</div>
            <div class="kpi-hint">Lines below 50% achievement</div>
        </div>

        <div class="kpi-card">
            <div class="kpi-label">On Track Lines</div>
            <div class="kpi-value">@targetSummary.OnTrackLinesCount</div>
            <div class="kpi-hint">Lines from 75% to 99%</div>
        </div>

        <div class="kpi-card">
            <div class="kpi-label">Achieved Lines</div>
            <div class="kpi-value">@targetSummary.AchievedLinesCount</div>
            <div class="kpi-hint">Lines achieved 100% or more</div>
        </div>

    </div>

    <div class="target-note">
        <i class="bi bi-info-circle"></i>
        <div>
            Target achievement is calculated based only on uploaded sales and visits reports from the beginning of the selected month up to the selected date.
            لو الشهر كامل لسه متمش رفع كل أيامه، النسب هتظهر أقل من الحقيقة.
        </div>
    </div>

    <div class="section-grid">

        <div class="panel">
            <div class="panel-title">
                <i class="bi bi-exclamation-octagon"></i>
                Lowest 10 Target Achievement Lines
            </div>

            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Branch</th>
                            <th>Sales District</th>
                            <th>Target</th>
                            <th>Actual</th>
                            <th>Achievement</th>
                            <th>Remaining</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (!Model.LowestTargetAchievements.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-muted fw-bold">
                                    No targets saved for this month.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.LowestTargetAchievements)
                            {
                                <tr>
                                    <td>
                                        <div class="line-name">
                                            @(string.IsNullOrWhiteSpace(item.BranchName) ? "-" : item.BranchName)
                                        </div>
                                        <div class="muted-code">@item.BranchCode</div>
                                    </td>

                                    <td>
                                        <div class="line-name">@item.SalesDistrictName</div>
                                        <div class="muted-code">@item.SalesDistrictCode</div>
                                    </td>

                                    <td>@Money(item.MonthlyTarget)</td>
                                    <td>@Money(item.ActualSales)</td>

                                    <td>
                                        <span class="badge-soft @(item.AchievementPercentage >= 75 ? "badge-positive" : "badge-negative")">
                                            @Percent(item.AchievementPercentage)
                                        </span>
                                    </td>

                                    <td>@Money(item.RemainingTarget)</td>

                                    <td>
                                        <span class="badge-soft @(item.Status == "Achieved" || item.Status == "On Track" ? "badge-positive" : "badge-negative")">
                                            @item.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="panel">
            <div class="panel-title">
                <i class="bi bi-trophy"></i>
                Top 10 Active Target Lines
            </div>

            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Branch</th>
                            <th>Sales District</th>
                            <th>Actual</th>
                            <th>Achievement</th>
                            <th>Visits</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (!Model.BestTargetAchievements.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-muted fw-bold">
                                    No active target lines found based on uploaded data yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.BestTargetAchievements)
                            {
                                <tr>
                                    <td>
                                        <div class="line-name">
                                            @(string.IsNullOrWhiteSpace(item.BranchName) ? "-" : item.BranchName)
                                        </div>
                                        <div class="muted-code">@item.BranchCode</div>
                                    </td>

                                    <td>
                                        <div class="line-name">@item.SalesDistrictName</div>
                                        <div class="muted-code">@item.SalesDistrictCode</div>
                                    </td>

                                    <td>@Money(item.ActualSales)</td>

                                    <td>
                                        <span class="badge-soft @(item.AchievementPercentage >= 75 ? "badge-positive" : "badge-negative")">
                                            @Percent(item.AchievementPercentage)
                                        </span>
                                    </td>

                                    <td>
                                        @item.ActualVisits / @item.PlannedVisits
                                        <div class="muted-code">
                                            @Percent(item.VisitAchievementPercentage)
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge-soft @(item.Status == "Achieved" || item.Status == "On Track" ? "badge-positive" : "badge-negative")">
                                            @item.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
    <div class="section-grid">

        <div class="panel">
            <div class="panel-title">
                <i class="bi bi-graph-up-arrow"></i>
                Sales by Line
            </div>

            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Line</th>
                            <th>Sales</th>
                            <th>Quantity</th>
                            <th>Contribution</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SalesByLines)
                        {
                            <tr>
                                <td>
                                    <div class="line-name">@item.LineName</div>
                                    <div class="muted-code">@item.LineCode</div>
                                </td>
                                <td>@Money(item.TotalSales)</td>
                                <td>@Number(item.TotalQuantity)</td>
                                <td>@Percent(item.ContributionPercentage)</td>
                                <td>
                                    <div class="progress-line">
                                        <div class="progress-fill"
                                             style="width:@Math.Min(item.ContributionPercentage, 100)%">
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="panel">
            <div class="panel-title">
                <i class="bi bi-exclamation-triangle"></i>
                Negative Visit Reasons
            </div>

            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Reason</th>
                            <th>Count</th>
                            <th>%</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.NegativeVisitReasons)
                        {
                            <tr>
                                <td>@item.Reason</td>
                                <td>@item.Count</td>
                                <td>
                                    <span class="badge-soft badge-negative">
                                        @Percent(item.Percentage)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <div class="section-grid">

        <div class="panel">
            <div class="panel-title">
                <i class="bi bi-people"></i>
                Visits by Sales Rep
            </div>

            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Sales Rep</th>
                            <th>Total</th>
                            <th>Positive</th>
                            <th>Negative</th>
                            <th>Positive %</th>
                            <th>Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.VisitsBySalesReps)
                        {
                            <tr>
                                <td>
                                    <div class="line-name">@item.SalesRepName</div>
                                    <div class="muted-code">@item.SalesRepCode</div>
                                </td>
                                <td>@item.TotalVisits</td>
                                <td>
                                    <span class="badge-soft badge-positive">
                                        @item.PositiveVisits
                                    </span>
                                </td>
                                <td>
                                    <span class="badge-soft badge-negative">
                                        @item.NegativeVisits
                                    </span>
                                </td>
                                <td>@Percent(item.PositiveVisitPercentage)</td>
                                <td>@Money(item.TotalVisitValue)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="panel">
            <div class="panel-title">
                <i class="bi bi-arrow-down-circle"></i>
                Bottom 5 Customers Today
            </div>

            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Rep</th>
                            <th>Value</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.BottomCustomersToday)
                        {
                            <tr>
                                <td>
                                    <div class="customer-name">@item.CustomerName</div>
                                    <div class="muted-code">@item.CustomerCode</div>
                                    @if (!string.IsNullOrWhiteSpace(item.NegativeReason))
                                    {
                                        <div class="muted-code">@item.NegativeReason</div>
                                    }
                                </td>
                                <td>
                                    <div>@item.SalesRepName</div>
                                    <div class="muted-code">@item.SalesRepCode</div>
                                </td>
                                <td>@Money(item.SalesValue)</td>
                                <td>
                                    <span class="badge-soft @(item.SalesValue > 0 ? "badge-positive" : "badge-negative")">
                                        @(string.IsNullOrWhiteSpace(item.VisitStatus) ? "-" : item.VisitStatus)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <div class="panel">
        <div class="panel-title">
            <i class="bi bi-box-seam"></i>
            Top Products
        </div>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Total Sales</th>
                        <th>Total Quantity</th>
                        <th>Contribution</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.TopProducts)
                    {
                        <tr>
                            <td class="product-name">@item.ProductName</td>
                            <td>@Money(item.TotalSales)</td>
                            <td>@Number(item.TotalQuantity)</td>
                            <td>@Percent(item.ContributionPercentage)</td>
                            <td>
                                <div class="progress-line">
                                    <div class="progress-fill"
                                         style="width:@Math.Min(item.ContributionPercentage, 100)%">
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>