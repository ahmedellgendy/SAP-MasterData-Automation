@model MasterDataAutomation.Application.Modules.ProductMaster.Dtos.CreateProductRequestDto

@{
    ViewData["Title"] = "Create Product Request";
}

<style>
    .page-box {
        max-width: 900px;
        margin: 0 auto;
        background: #f4f7f8;
        border-radius: 14px;
        padding: 24px;
        color: #16232c;
        font-family: "Segoe UI", system-ui, sans-serif;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 15px;
        flex-wrap: wrap;
        border-bottom: 2px solid #16232c;
        padding-bottom: 16px;
        margin-bottom: 20px;
    }

    .page-title {
        margin: 0;
        font-size: 28px;
        font-weight: 800;
    }

    .page-sub {
        margin: 6px 0 0;
        color: #6b7a86;
        font-size: 14px;
    }

    .form-card {
        background: #fff;
        border: 1px solid #e1e7ea;
        border-radius: 14px;
        padding: 22px;
    }

    .section-title {
        font-size: 15px;
        font-weight: 800;
        margin-bottom: 14px;
        padding-bottom: 8px;
        border-bottom: 1px solid #e1e7ea;
    }

    .form-label {
        font-weight: 700;
        color: #16232c;
    }

    .form-control {
        border-radius: 10px;
        padding: 10px 12px;
    }

    .btn-save {
        background: #2f7d6b;
        border: 1px solid #2f7d6b;
        color: #fff;
        font-weight: 700;
        border-radius: 10px;
        padding: 10px 18px;
    }

        .btn-save:hover {
            background: #245f52;
            border-color: #245f52;
            color: #fff;
        }

    .btn-back {
        border: 1px solid #16232c;
        color: #16232c;
        background: transparent;
        font-weight: 700;
        border-radius: 10px;
        padding: 10px 18px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-back:hover {
            background: #16232c;
            color: #fff;
        }

    .info-box {
        background: #e7f3f0;
        border: 1px solid #cfe6de;
        color: #1d5347;
        border-radius: 12px;
        padding: 12px 14px;
        margin-bottom: 18px;
        font-weight: 600;
        font-size: 14px;
    }
</style>

<div class="page-box">

    <div class="page-header">
        <div>
            <h1 class="page-title">Create Product Request</h1>
            <p class="page-sub">
                Add product purchase data. Selling prices will be added later by Executive Manager.
            </p>
        </div>

        <a asp-controller="ProductRequests"
           asp-action="Index"
           class="btn-back">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>

    <div class="form-card">

        <div class="info-box">
            Piece Price will be calculated automatically in the system from Purchase Price / Pieces Count.
        </div>

        <form asp-controller="ProductRequests"
              asp-action="Create"
              method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="section-title">Product Information</div>

            <div class="row g-3 mb-4">

                <div class="col-md-6">
                    <label asp-for="ItemCode" class="form-label">Item Code</label>
                    <input asp-for="ItemCode" class="form-control" placeholder="Example: P001" />
                    <span asp-validation-for="ItemCode" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ItemName" class="form-label">Item Name</label>
                    <input asp-for="ItemName" class="form-control" placeholder="Example: Vanilla Cup 100ml" />
                    <span asp-validation-for="ItemName" class="text-danger small"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="Notes" class="form-label">Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>

            </div>

            <div class="section-title">Purchase Information</div>

            <div class="row g-3 mb-4">

                <div class="col-md-4">
                    <label asp-for="PurchasePrice" class="form-label">Purchase Price</label>
                    <input asp-for="PurchasePrice"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0.01"
                           required
                           placeholder="Enter purchase price" />
                    <span asp-validation-for="PurchasePrice" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="PiecesCount" class="form-label">Pieces Count</label>
                    <input asp-for="PiecesCount"
                           class="form-control"
                           type="number"
                           min="1"
                           required
                           placeholder="Enter pieces count" />
                    <span asp-validation-for="PiecesCount" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Currency" class="form-label">Currency</label>
                    <input asp-for="Currency" class="form-control" value="@(Model.Currency ?? "EGP")" />
                    <span asp-validation-for="Currency" class="text-danger small"></span>
                </div>

            </div>

            <div class="section-title">Bonus</div>

            <div class="row g-3 mb-4">

                <div class="col-md-4">
                    <div class="form-check mt-2">
                        <input asp-for="HasBonus" class="form-check-input" />
                        <label asp-for="HasBonus" class="form-check-label fw-bold">
                            Has Bonus
                        </label>
                    </div>
                </div>

                <div class="col-md-4">
                    <label asp-for="BonusQuantity" class="form-label">Bonus Quantity</label>
                    <input asp-for="BonusQuantity" class="form-control" type="number" min="0" />
                    <span asp-validation-for="BonusQuantity" class="text-danger small"></span>
                </div>

            </div>

            <div class="d-flex justify-content-end gap-2 flex-wrap">
                <a asp-controller="ProductRequests"
                   asp-action="Index"
                   class="btn-back">
                    Cancel
                </a>

                <button type="submit" class="btn btn-save">
                    <i class="bi bi-save"></i>
                    Save Request
                </button>
            </div>

        </form>

    </div>

</div>