@* @model MasterDataAutomation.Web.ViewModels.ProductMaster.AccountsUserProductDashboardViewModel

@{
    ViewData["Title"] = "Product Requests";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">

<style>
    :root {
        --ink: #16232c;
        --ink-soft: #5b6b78;
        --ink-faint: #93a0aa;
        --paper: #f3f6f6;
        --surface: #ffffff;
        --line: #e0e6e7;
        --accent: #2f7d6b;
        --accent-ink: #1d5347;
        --accent-soft: #e6f1ee;
        --amber: #b5822b;
        --amber-soft: #f6ecd9;
        --warn: #b6483f;
        --warn-soft: #f7e9e7;
    }

    .pm-wrap {
        font-family: 'Inter', sans-serif;
        color: var(--ink);
        background: var(--paper);
        border-radius: 0.4rem;
        padding: 1.75rem;
    }

    .pm-eyebrow {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent-ink);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.6rem;
    }

        .pm-eyebrow::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--accent);
            display: inline-block;
        }

    .pm-header {
        border-bottom: 2px solid var(--ink);
        padding-bottom: 1.25rem;
        margin-bottom: 1.5rem;
    }

    .pm-title {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 2rem;
        letter-spacing: -0.02em;
        margin: 0;
        color: var(--ink);
    }

    .pm-sub {
        color: var(--ink-soft);
        font-size: 0.92rem;
        margin: 0.3rem 0 0;
    }

    .btn-flat {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 0.85rem;
        border-radius: 0.3rem;
        padding: 0.5rem 0.95rem;
        border: 1.5px solid var(--ink);
        background: transparent;
        color: var(--ink);
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        transition: background 0.12s ease, color 0.12s ease;
        text-decoration: none;
    }

        .btn-flat:hover {
            background: var(--ink);
            color: #fff;
        }

    /* action cards */
    .pm-action-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .pm-action-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 0.4rem;
        padding: 1.5rem;
        text-decoration: none;
        color: var(--ink);
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        transition: border-color 0.12s ease, transform 0.12s ease;
        position: relative;
        overflow: hidden;
    }

    a.pm-action-card:hover {
        border-color: var(--accent);
        transform: translateY(-2px);
        color: var(--ink);
    }

    .pm-action-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 3px;
        height: 100%;
        background: var(--card-accent, var(--ink-faint));
    }

    .pm-action-icon {
        width: 42px;
        height: 42px;
        border-radius: 0.4rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        background: var(--card-accent-soft, var(--paper));
        color: var(--card-accent, var(--ink-soft));
    }

    .pm-action-card h5 {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 1.05rem;
        margin: 0;
        color: var(--ink);
    }

    .pm-action-card .pm-action-hint {
        font-size: 0.82rem;
        color: var(--ink-soft);
    }

    .pm-action-num {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 1.9rem;
        color: var(--ink);
        margin: 0;
    }

    .pm-card-accent {
        --card-accent: var(--accent);
        --card-accent-soft: var(--accent-soft);
    }

    .pm-card-blue {
        --card-accent: #2f5f9e;
        --card-accent-soft: #e8eef7;
    }

    .pm-card-amber {
        --card-accent: var(--amber);
        --card-accent-soft: var(--amber-soft);
    }

    /* panel */
    .pm-panel {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 0.4rem;
        overflow: hidden;
    }

    .pm-panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--line);
        background: var(--paper);
    }

    .pm-panel-title {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-soft);
        font-weight: 600;
    }

    table.pm-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
    }

        table.pm-table thead th {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.68rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--ink-faint);
            font-weight: 600;
            text-align: left;
            padding: 0.75rem 1.1rem;
            background: var(--paper);
            border-bottom: 1px solid var(--line);
            white-space: nowrap;
        }

        table.pm-table tbody td {
            padding: 0.85rem 1.1rem;
            border-bottom: 1px solid var(--line);
            vertical-align: middle;
            font-size: 0.9rem;
        }

        table.pm-table tbody tr:last-child td {
            border-bottom: none;
        }

        table.pm-table tbody tr:hover {
            background: var(--accent-soft);
        }

    .pm-code {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--ink);
        border-left: 3px solid var(--accent);
        padding-left: 0.55rem;
    }

    .pm-name {
        font-weight: 600;
        color: var(--ink);
    }

    .pm-price {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 600;
        color: var(--ink);
        text-align: right;
    }

    .pm-count {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 600;
        color: var(--ink);
        text-align: center;
    }

    .pm-status-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.76rem;
        font-weight: 600;
        color: var(--amber);
        background: var(--amber-soft);
        border-radius: 50px;
        padding: 0.25rem 0.65rem;
    }

        .pm-status-chip::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--amber);
        }

    /* empty state */
    .pm-empty {
        text-align: center;
        padding: 3.5rem 2rem;
    }

    .pm-empty-tag {
        width: 60px;
        height: 60px;
        border: 1.5px dashed var(--ink-faint);
        border-radius: 0.4rem;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.1rem;
        color: var(--ink-faint);
        font-size: 1.4rem;
    }

    .pm-empty h5 {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        color: var(--ink);
    }

    @@media (max-width: 900px) {
        .pm-action-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="pm-wrap">
