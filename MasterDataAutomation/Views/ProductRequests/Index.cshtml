@model MasterDataAutomation.Web.ViewModels.ProductMaster.AccountsUserProductDashboardViewModel

@{
    ViewData["Title"] = "Product Requests";
}

<h1>Product Requests Page Working</h1>

<p>Draft Count: @Model.DraftCount</p>
<p>Submitted Count: @Model.SubmittedCount</p>

<a asp-controller="ProductRequests" asp-action="Create">
    Create Product Request
</a>